@prefix ho:    <https://harness-ontology.dev/schema#> .
@prefix id:    <https://harness-ontology.dev/id/core/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .

# Core data unit -- Channel partition of the `core` domain. Imports the
# central TBox only; cross-unit references (the h-multiagent harness binding
# these channels via hasChannel, the role-* participants, the c-multiagent tag)
# resolve in the root union (docs/federation-design.md D1, ONTOLOGYSTYLE 4).
<https://harness-ontology.dev/data/core/channels> a owl:Ontology ;
    owl:imports <https://harness-ontology.dev/schema> .

########################################################################
# Coordination channels — how the multi-agent roles (and the user) exchange
# status, requests, judgments and results. Neutral, domain-independent: they
# capture the conduit + participants + hand-off protocol, distinct from the
# roles (ho:Role) and the policies on them (ho:Guardrail). Because sessions can
# be separate, channels are durable files with status markers, not chat. Each
# is wired into the neutral id:h-multiagent template via ho:hasChannel
# (subPropertyOf hasComponent) so it is a connected, orphan-free component.
########################################################################

#===================== CHANNELS ========================================

id:chan-agent-user a ho:Channel ;
    skos:prefLabel "Agent-user channel" ; skos:altLabel "feedback channel" ;
    skos:definition "The single agent<->user conduit (a durable feedback inbox with report-back files), used instead of volatile chat: the user files change/decision requests and agents leave reports and decision requests, keeping chat minimal (report-over-prompt). The user is the only endpoint who may flip an item's approval status (open->approved); that tagging is the sole authorization signal, so the channel enforces a human approval gate before any application." ;
    ho:channelParticipant id:role-orchestrator, id:role-inspection ;
    ho:tagged id:c-multiagent, id:c-communication ;
    ho:involvesUser true ;
    ho:channelMedium "durable file channel (inbox/report)" ;
    ho:maturity "reviewed" .

id:chan-orchestrator-inspection a ho:Channel ;
    skos:prefLabel "Orchestrator-inspection channel" ; skos:altLabel "coordination channel" ;
    skos:definition "Coordination between the orchestrator and inspection, which run in SEPARATE sessions and therefore cannot use chat or spawn return values. All hand-off is via durable files plus status markers (write as wip, rename on completion; a frontmatter status field). Two lanes ride it: a verify lane (feedback inbox -> verified reports) and an inquiry lane (open -> answered -> closed). Each side scans the channel on its own cycle and consumes only completed items -- verify-then-proceed, never assuming the other session finished by elapsed time." ;
    ho:channelParticipant id:role-orchestrator, id:role-inspection ;
    ho:tagged id:c-multiagent, id:c-communication ;
    ho:involvesUser false ;
    ho:channelMedium "persistent file channel + status markers (wip->rename, frontmatter status)" ;
    ho:maturity "reviewed" .

id:chan-dispatch a ho:Channel ;
    skos:prefLabel "Dispatch channel" ; skos:altLabel "orchestrator-worker dispatch" ;
    skos:definition "The orchestrator->worker conduit: the orchestrator plans a request into node-scoped briefs and dispatches each to a specialised worker agent (spawned as a subagent under least-privilege), then integrates the returned results. Workers act only when dispatched over this channel, not standalone. Distinct from the durable file channels because coordination here is the spawn/return of the subagent invocation itself." ;
    ho:channelParticipant id:role-orchestrator, id:role-implementer, id:role-research,
        id:role-vnv, id:role-design ;
    ho:tagged id:c-multiagent, id:c-communication ;
    ho:involvesUser false ;
    ho:channelMedium "dispatch (subagent spawn)" ;
    ho:maturity "reviewed" .

id:chan-workspace a ho:Channel ;
    skos:prefLabel "Workspace channel" ; skos:altLabel "shared workspace file hand-off" ;
    skos:definition "A shared file workspace over which worker roles hand off intermediate deliverables: each writes its output as a named artifact file in a common directory and downstream roles read it from there, so contributions accumulate as durable artifacts rather than transient messages. Distinct from central dispatch (id:chan-dispatch, coordination by spawn/return) and from a message mesh (id:chan-peer, coordination by direct messages): coordination here is by shared files, which lets a terminal convergence gate pick up every worker's deliverable from one place. The user is not an endpoint." ;
    ho:channelParticipant id:role-implementer, id:role-research,
        id:role-vnv, id:role-design, id:role-synthesizer ;
    ho:tagged id:c-multiagent, id:c-communication ;
    ho:involvesUser false ;
    ho:channelMedium "shared file workspace (named artifact files in a common directory)" ;
    ho:maturity "reviewed" .

id:chan-peer a ho:Channel ;
    skos:prefLabel "Peer channel" ; skos:altLabel "peer message mesh" ;
    skos:definition "The peer-to-peer coordination conduit of a peer-mesh harness: worker roles send work, requests, judgments and results DIRECTLY to one another over a message mesh, with no central-only orchestrator relaying every hand-off (contrast id:chan-dispatch, where the orchestrator spawns each worker and integrates every result). The channel that realises id:pat-peer-mesh. Coordination topology is a pluggable, extensible dimension: a harness selects peer-mesh by declaring ho:appliesPattern id:pat-peer-mesh together with this channel, exactly as an orchestrator-workers harness pairs id:pat-orchestrator-workers with id:chan-dispatch; a new topology is added as a new ho:DesignPattern + ho:Channel without disturbing either existing one. Peers here are worker roles only — no central dispatcher endpoint — and the user is not an endpoint." ;
    ho:channelParticipant id:role-implementer, id:role-vnv, id:role-research, id:role-design ;
    ho:hasLink id:link-chan-peer-overlap-pat-peer-mesh ;
    ho:tagged id:c-multiagent, id:c-communication ;
    ho:involvesUser false ;
    ho:channelMedium "peer message mesh" ;
    ho:maturity "reviewed" .

# Weighted overlap link — 구 crisp ho:overlapsWith 이전분(대칭 관계라 한 방향
# 한 건만 저작, kind 정의의 규약). 가중치는 구조 증거 측정(structural-overlap-v1,
# tools/measure_links.py)이 산출·갱신한다: 상호 definition IRI 교차참조
# (chan-peer↔pat-peer-mesh 양방향) + 공유 태그(c-multiagent, scope facet).
id:link-chan-peer-overlap-pat-peer-mesh a ho:Link ;
    skos:prefLabel "Peer channel / Peer-mesh overlap link" ;
    ho:linkTarget id:pat-peer-mesh ; ho:linkKind id:kind-overlap ;
    ho:linkWeight 0.76 ; ho:weightOrigin "measured" ;
    ho:weightMethod "structural-overlap-v1" .

id:chan-task-board a ho:Channel ;
    skos:prefLabel "Task-board channel" ; skos:altLabel "shared task list" ;
    skos:definition "A shared task list over which workers claim tasks and report progress with task-update entries, and off which the leader is automatically notified when a worker goes idle. The fourth hand-off medium after files (id:chan-workspace), direct messages (id:chan-peer) and spawn/return (id:chan-dispatch): coordination here is by a durable board of claimable task items with progress updates, distinct from those three. The default endpoints are the worker roles; the notified leader is a harness-dependent endpoint that each binding harness fills with its own lead/coordinating role, so no single leader role is fixed here. The user is not an endpoint." ;
    ho:channelParticipant id:role-implementer, id:role-research,
        id:role-vnv, id:role-design ;
    ho:tagged id:c-multiagent, id:c-communication ;
    ho:involvesUser false ;
    ho:channelMedium "shared task board (claimable task items with task-update entries)" ;
    ho:maturity "draft" .

#===================== Human-gate conduits (wave-H) ====================
# The two conduit CONTRACTS of the human-in-the-loop axis: how an approval
# request travels (durable, addressed, correlated, authorized responders,
# structured refusal) and how a mid-run question travels (flat-schema query
# answered accept/decline/cancel). Bound to id:h-multiagent, the harness that
# factually puts approval requests and targeted questions to its user over
# durable conduits (its inbox approval lane and elicitation practice); each
# definition carries the lane distinction from id:chan-agent-user, the general
# feedback conduit those lanes may physically ride.
id:chan-approval a ho:Channel ;
    skos:prefLabel "Approval channel" ; skos:altLabel "approval-request lane" ;
    skos:definition "The dedicated conduit for approval requests: durable and addressed, each request carrying a correlation identifier that ties the eventual answer back to the interrupted work, a declared authorized-responder set whose members alone may decide, and structured response options so approval, rejection and the rejection's reason arrive machine-readable. Distinguished from id:chan-agent-user, the general agent-user feedback conduit: this is the approval lane specifically -- it may ride the same physical medium, but its items are decision requests with correlation and authorization semantics, not free-form reports." ;
    ho:channelParticipant id:role-orchestrator ;
    ho:tagged id:c-human-in-loop, id:c-communication ;
    ho:involvesUser true ;
    ho:channelMedium "durable addressed approval requests (correlation id + authorized responders + structured response options)" ;
    ho:maturity "draft" .

id:chan-elicitation a ho:Channel ;
    skos:prefLabel "Elicitation channel" ; skos:altLabel "structured question lane" ;
    skos:definition "The conduit for structured mid-run questions to the human: each query is a message plus a flat schema of primitive-typed fields, so the answer comes back machine-readable, and every query terminates in exactly one of accept (with the filled content), decline or cancel. Distinguished from id:gr-user-elicitation, the policy that gaps must be asked rather than assumed -- this is the conduit contract such asking travels over; and from id:chan-approval, which carries authorization decisions on work the agent proposes: an elicitation asks for missing information, not for permission." ;
    ho:channelParticipant id:role-orchestrator ;
    ho:tagged id:c-human-in-loop, id:c-communication ;
    ho:involvesUser true ;
    ho:channelMedium "structured query (message + flat primitive-typed schema) answered accept/decline/cancel" ;
    ho:maturity "draft" .
