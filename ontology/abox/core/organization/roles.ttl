@prefix ho:    <https://harness-ontology.dev/schema#> .
@prefix id:    <https://harness-ontology.dev/id/core/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .

# Core data unit -- Role partition of the `core` domain. Imports the
# central TBox only; cross-unit references (the h-multiagent harness binding
# these roles via hasRole, the tools/guardrails each role scopes via
# roleTool/roleGuardrail, the c-multiagent/c-design tags) resolve in the
# root union (docs/federation-design.md D1, ONTOLOGYSTYLE 4).
<https://harness-ontology.dev/data/core/roles> a owl:Ontology ;
    owl:imports <https://harness-ontology.dev/schema> .

########################################################################
# Sub-agent roles — the neutral multi-agent role taxonomy.
#
# Each role is characterised, not just classified: its defining traits are
# modelled explicitly so a harness can make its agent perform the role
# clearly — the governance it operates under (ho:roleGuardrail), the
# least-privilege tools in its scope (ho:roleTool), and its memory
# discipline (ho:roleMemoryPolicy). ho:userFacing is OPTIONAL: it is present
# (true) only on roles that communicate with the user; its ABSENCE means the
# role is dispatch-invoked and does not talk to the user (it is not a
# defining/required property). All roles are bound to the neutral
# id:h-multiagent template via ho:hasRole (subPropertyOf hasComponent) and
# scope only parts that harness already binds (usesTool / hasGuardrail), so
# each stays a connected, orphan-free HarnessComponent.
#
# TAXONOMY -- the roles below fall into 4 groups, read on four axes:
#   ORIGIN     A/B/C/D (see per-group headers),
#   INTERACTION user-facing vs not user-facing (per ho:userFacing above),
#   ACTIVATION how the role is put to work -- a dispatch-invoked INSTANT WORKER
#              (spawned per brief, reclaimed on return: id:gr-dispatch-execution,
#              id:mode-sub-agents) or an ONLINE STANDING session (session-resident,
#              addressed over durable channels and serving requests as they arrive:
#              id:gr-online-execution, id:mode-standing-service). Only
#              id:role-orchestrator and id:role-inspection are standing; groups B
#              and C are dispatch-invoked, and id:role-coordinator (group D) is
#              neither -- it lives for the span of ONE run with its peer team
#              (id:mode-agent-teams),
#   CARRIER    which template binds the role via ho:hasRole.
#   A. Roles of THIS repo's own harness (carrier id:h-multiagent, reviewed):
#      orchestrator (user-facing), inspection (user-facing), research, vnv,
#      design. These are neutral role NODES; this repo's operating agents (the
#      ho:Agent nodes) INSTANTIATE them rather than existing as separate concrete
#      twins -- e.g. this repo's node-authoring agent (id:agent-developer) now
#      instantiates the group C id:role-implementer archetype (its former
#      concrete authoring twin was merged into that archetype as a duplicate). Only
#      orchestrator and inspection are operation-only to this repo; research /
#      vnv / design are domain-neutral and are reused across carriers too.
#   B. Terminal convergence gate     (carriers id:h-multiagent +
#      id:h-workspace-synthesis, reviewed): synthesizer -- also PRODUCES the
#      integrated result (provides id:cap-synthesis), broader than the judge-only
#      vnv. Neutral archetype an operating harness reuses, dual-bound to BOTH
#      carriers via ho:hasRole (like research / design / vnv, which likewise sit
#      in a home group yet are also bound to id:h-workspace-synthesis), not a
#      this-repo-only role.
#   C. Neutral worker archetypes     (carrier id:h-workspace-synthesis, draft):
#      analyst / author / implementer / planner / strategist / tester / curator,
#      the reusable roster a team is staffed from and specialised per domain.
#      id:role-implementer is the construction archetype instantiated by this
#      repo's own node-authoring agent (id:agent-developer).
#   D. Coordination-only peer        (carrier id:h-peer-mesh, draft):
#      coordinator -- plans/sequences/tracks, performs none of the execution.
#   DUAL ROLE: id:role-research and id:role-design sit in group A (this repo's
#   own harness runs them) yet their definitions are domain-neutral, so they
#   ALSO serve as the gather / design archetypes of group C and are already
#   bound to id:h-workspace-synthesis via ho:hasRole (B24 anti-drift re-
#   adjudication: reuse these two, do NOT mint role-gatherer or a separate
#   design archetype). They stay physically in group A -- no separate node.
########################################################################

#===================== A. Roles of THIS repository's own harness =======
# The five roles this repo's own multi-agent harness runs, bound to
# id:h-multiagent via ho:hasRole. role-orchestrator and role-inspection are
# user-facing (ho:userFacing true); the other three are dispatch-invoked.
# role-inspection also directly performs investigation in its own session
# (there is no separate dispatch-invoked inspection worker).
# The construction (author/build) work of this harness is done by an operating
# agent that instantiates the neutral id:role-implementer archetype of group C
# (id:agent-developer -> id:role-implementer): there is no separate concrete
# authoring role node -- the former concrete authoring role was merged into that
# archetype to remove the concrete<->neutral duplicate.
# NOTE: role-research and role-design are ALSO the neutral gather/design
# archetypes of group C and are additionally bound to id:h-workspace-synthesis
# (B24) -- kept here as group A, not duplicated as separate archetype nodes.

id:role-orchestrator a ho:Role ;
    skos:prefLabel "Orchestrator agent" ;
    skos:definition "The user-facing planner that decomposes a request into node-scoped briefs and dispatches them to workers, then integrates and gate-checks their results. Performs no substantive work itself. An ONLINE STANDING role: its session stays open across requests, so it receives work from the user and from its coordination channels as it arrives rather than being spawned for one brief and reclaimed." ;
    ho:roleGuardrail id:gr-delegated-orchestration, id:gr-report-over-prompt,
        id:gr-bounded-context, id:gr-reuse-first, id:gr-online-execution,
        id:gr-user-elicitation ;
    ho:tagged id:c-multiagent, id:c-delegation ;
    ho:roleMemoryPolicy "Reads and writes only its own role-scoped memory at session start/end; plans from a bounded retrieval pack, never the whole store." ;
    ho:userFacing true ; ho:maturity "reviewed" .

id:role-inspection a ho:Role ;
    skos:prefLabel "Inspection agent" ;
    skos:definition "The user-facing role that, in its own standing session, directly investigates the design graph and its changes, handles user feedback and its ripple effects, and owns the git lifecycle. An ONLINE STANDING role: it is never dispatched -- its session stays open independently of any run and it consumes work from its durable channels by completed status marker, on its own cycle." ;
    ho:roleTool id:tool-shell, id:tool-editor, id:tool-retriever ;
    ho:roleGuardrail id:gr-traceability, id:gr-report-over-prompt,
        id:gr-least-privilege, id:gr-verify-proceed, id:gr-online-execution ;
    ho:tagged id:c-multiagent, id:c-online-agent ;
    ho:roleMemoryPolicy "Runs in its own session; reads and writes only its own role-scoped memory at session start/end and consumes the feedback channel by verified status, never by elapsed time." ;
    ho:userFacing true ; ho:maturity "reviewed" .

id:role-research a ho:Role ;
    skos:prefLabel "Research agent" ;
    skos:definition "A work-performing role, dispatch-invoked only, that gathers and synthesises information needed by a brief, grounding each finding in its source." ;
    ho:roleTool id:tool-websearch, id:tool-retriever ;
    ho:roleGuardrail id:gr-dispatch-execution, id:gr-least-privilege,
        id:gr-grounding, id:gr-bounded-context ;
    ho:tagged id:c-multiagent, id:c-dispatch ;
    ho:roleMemoryPolicy "Reads its own role-scoped memory at session start and writes back reusable findings at session end; touches no other role's memory." ;
    ho:maturity "reviewed" .

id:role-vnv a ho:Role ;
    skos:prefLabel "Verification and validation agent" ; skos:altLabel "quality reviewer" ;
    skos:definition "A work-performing role, dispatch-invoked only, that verifies and evaluates composition results and returns a verdict on confirmed state, escalating rather than deciding open questions." ;
    ho:roleTool id:tool-shell, id:tool-retriever ;
    ho:roleGuardrail id:gr-dispatch-execution, id:gr-least-privilege,
        id:gr-verify-proceed, id:gr-no-arbitrary-decision ;
    ho:tagged id:c-multiagent, id:c-verify-proceed ;
    ho:roleMemoryPolicy "Reads its own role-scoped memory at session start and writes back reusable verification heuristics at session end; touches no other role's memory." ;
    ho:maturity "reviewed" .

id:role-design a ho:Role ;
    skos:prefLabel "Design agent" ; skos:altLabel "visual designer" , "instructional designer" ;
    skos:definition "A work-performing role, dispatch-invoked only, dedicated to design work (system/architecture design tasks): choosing the simplest working form, fixing root causes, and grounding each decision." ;
    ho:roleGuardrail id:gr-dispatch-execution, id:gr-least-privilege,
        id:gr-simplicity, id:gr-root-cause, id:gr-grounding ;
    ho:tagged id:c-multiagent, id:c-design ;
    ho:roleMemoryPolicy "Reads its own role-scoped memory at session start and writes back reusable design rationale at session end; touches no other role's memory." ;
    ho:maturity "reviewed" .

#===================== B. Terminal convergence gate ====================
# The final convergence gate of a multi-agent harness: a work-performing role
# that both cross-checks every worker's deliverable AND compiles the reviewed
# contributions into one coherent final result. Broader than id:role-vnv (which
# only judges and returns a verdict) -- a neutral sibling that also PRODUCES the
# integrated output, so it provides id:cap-synthesis. Recurs across the corpus of
# multi-agent harnesses as the reviewer/writer/synthesizer terminal step.
id:role-synthesizer a ho:Role ;
    skos:prefLabel "Synthesizer agent" ; skos:altLabel "convergence/reviewer gate" , "cross-validator" ;
    skos:definition "A work-performing role, dispatch-invoked only, that serves as the terminal convergence gate of a multi-agent harness: it cross-checks every worker's deliverable, requests bounded rework on the issues it finds, and compiles the reviewed contributions into one coherent final result. Broader than the verification role, which only judges and returns a verdict -- the synthesizer also produces the integrated deliverable, so it provides the synthesis capability." ;
    ho:roleTool id:tool-editor ;
    ho:roleGuardrail id:gr-dispatch-execution, id:gr-least-privilege,
        id:gr-structured-output, id:gr-grounding ;
    ho:providesCapability id:cap-synthesis ;
    ho:tagged id:c-multiagent, id:c-synthesis ;
    ho:roleMemoryPolicy "Reads its own role-scoped memory at session start and writes back reusable synthesis/review heuristics at session end; touches no other role's memory." ;
    ho:maturity "reviewed" .

#===================== C. Neutral worker archetypes ====================
# The recurring worker roles of a multi-agent team, generalised away from any
# problem domain: a team is normally staffed by picking the archetypes its work
# needs (analyse / write / build / plan / advise / test / curate) and specialising
# each one locally. They are deliberately siblings of -- not edits to -- the concrete
# roles above, which are this repository's own agents; each definition says how
# it differs from the nearest existing role so the two never collapse into
# near-synonyms. Hosted by id:h-workspace-synthesis, the central-library carrier.
# The GATHER and DESIGN archetypes of this roster are NOT re-declared here: they
# are covered by group A's id:role-research and id:role-design, whose domain-
# neutral definitions double as those archetypes and which are already bound to
# id:h-workspace-synthesis (see the DUAL ROLE note in the top header, B24).

id:role-analyst a ho:Role ;
    skos:prefLabel "Analyst agent" ; skos:altLabel "evaluator" , "modeler-calculator" ;
    skos:definition "A work-performing role, dispatch-invoked only, that examines material it is given against stated criteria and reports what it found ranked by severity or impact, so the next role can spend its effort on the costliest issues first. Choose it when the deliverable is a diagnosis of material that already exists. Distinguished from id:role-research, which GATHERS material rather than judging it, and from id:role-vnv, whose subject is the harness's own composition output and whose return is a pass/fail verdict rather than a graded finding list." ;
    ho:roleTool id:tool-editor ;
    ho:roleGuardrail id:gr-dispatch-execution, id:gr-least-privilege,
        id:gr-grounding, id:gr-structured-output ;
    ho:tagged id:c-multiagent, id:c-dispatch ;
    ho:roleMemoryPolicy "Reads its own role-scoped memory at session start and writes back reusable diagnostic heuristics at session end; touches no other role's memory." ;
    ho:maturity "reviewed" .

id:role-author a ho:Role ;
    skos:prefLabel "Author agent" ; skos:altLabel "writer" , "document producer" ;
    skos:definition "A work-performing role, dispatch-invoked only, that turns findings or a specification into a finished, structured document written for a named reader. Choose it when the prose artifact IS the deliverable rather than a by-product of other work. Distinguished from id:role-synthesizer, which is the terminal convergence gate that judges and merges what everyone else produced: the author is a producer that writes one deliverable of its own and hands it to that gate." ;
    ho:roleTool id:tool-editor ;
    ho:roleGuardrail id:gr-dispatch-execution, id:gr-least-privilege,
        id:gr-structured-output, id:gr-cite ;
    ho:tagged id:c-multiagent, id:c-structured-output ;
    ho:roleMemoryPolicy "Reads its own role-scoped memory at session start and writes back reusable drafting conventions at session end; touches no other role's memory." ;
    ho:maturity "reviewed" .

id:role-implementer a ho:Role ;
    skos:prefLabel "Implementer agent" ; skos:altLabel "builder" , "data preparer" , "optimizer-tuner" ;
    skos:definition "A work-performing role, dispatch-invoked only, that turns an agreed specification into the working artifact it describes -- code, a configuration, a prepared dataset, a tuned setup, an authored knowledge-graph individual the ontology types -- and reports what it actually produced against what was specified. Choose it for the construction step of any domain: it is the domain-independent archetype a harness binds for construction work of any kind, and a concrete authoring agent (such as this repository's own node-authoring agent) is an instance of it." ;
    ho:roleTool id:tool-editor, id:tool-shell ;
    ho:roleGuardrail id:gr-dispatch-execution, id:gr-least-privilege,
        id:gr-simplicity, id:gr-root-cause ;
    ho:tagged id:c-multiagent, id:c-dispatch ;
    ho:roleMemoryPolicy "Reads its own role-scoped memory at session start and writes back reusable construction knowledge at session end; touches no other role's memory." ;
    ho:maturity "reviewed" .

id:role-planner a ho:Role ;
    skos:prefLabel "Planner agent" ; skos:altLabel "scheduler" , "roadmap owner" ;
    skos:definition "A work-performing role, dispatch-invoked only, whose deliverable is the plan itself: the ordered task breakdown, the dependencies between the tasks and the schedule or roadmap that follows from them. Choose it when the request needs a plan document that other roles will then execute. Distinguished from id:role-orchestrator, which performs no substantive work itself and only decomposes and dispatches -- this role is an ordinary worker that happens to produce a plan, and is dispatched like any other." ;
    ho:roleTool id:tool-editor ;
    ho:roleGuardrail id:gr-dispatch-execution, id:gr-least-privilege,
        id:gr-bottleneck-avoidance, id:gr-structured-output ;
    ho:tagged id:c-multiagent, id:c-dispatch ;
    ho:roleMemoryPolicy "Reads its own role-scoped memory at session start and writes back reusable planning heuristics at session end; touches no other role's memory." ;
    ho:maturity "draft" .

id:role-strategist a ho:Role ;
    skos:prefLabel "Strategist agent" ; skos:altLabel "advisor" ;
    skos:definition "A work-performing role, dispatch-invoked only, that frames a decision: it lays out the viable options with their trade-offs and recommends one, leaving the choice with the decision authority. Choose it when the request is what should be done rather than to do it. Distinguished from id:role-planner, which sequences work that has ALREADY been decided, and from id:role-analyst, which reports what is wrong rather than which way to go next." ;
    ho:roleTool id:tool-editor ;
    ho:roleGuardrail id:gr-dispatch-execution, id:gr-least-privilege,
        id:gr-grounding, id:gr-no-arbitrary-decision ;
    ho:tagged id:c-multiagent, id:c-dispatch ;
    ho:roleMemoryPolicy "Reads its own role-scoped memory at session start and writes back reusable option-framing heuristics at session end; touches no other role's memory." ;
    ho:maturity "reviewed" .

id:role-tester a ho:Role ;
    skos:prefLabel "Tester agent" ; skos:altLabel "simulator" ;
    skos:definition "A work-performing role, dispatch-invoked only, that produces the checks themselves -- test cases, fixtures and simulated runs with the outcome each expects -- instead of passing judgment. Choose it when the deliverable is the acceptance material some later gate will run. Distinguished from id:role-vnv, which CONSUMES such material and returns a verdict on it. It recurs in only a small share of observed teams, so bind it only when the acceptance material is genuinely a deliverable of its own rather than a by-product of the verification step." ;
    ho:roleTool id:tool-editor ;
    ho:roleGuardrail id:gr-dispatch-execution, id:gr-least-privilege,
        id:gr-three-flow-acceptance, id:gr-discriminating-eval ;
    ho:tagged id:c-multiagent, id:c-acceptance-coverage ;
    ho:roleMemoryPolicy "Reads its own role-scoped memory at session start and writes back reusable fixture-design knowledge at session end; touches no other role's memory." ;
    ho:salience 0.25 ; ho:maturity "draft" .

# Curation is a deliverable-type of its own, distinct from the six archetypes
# above and from the concrete gather/write/diagnose roles: the worker whose
# output is a curated SELECTION and arrangement of material that already exists,
# not new content. It recurs across the corpus (newsletter source curation,
# terminology/glossary management, organised catalogues) with no archetype to
# specialise, so it is added here as the neutral "curator" sibling. Its
# definition says how it differs from research (gather), author (write prose) and
# analyst (diagnose) so the four never collapse into near-synonyms.
id:role-curator a ho:Role ;
    skos:prefLabel "Curator agent" ; skos:altLabel "organizer" , "librarian" ;
    skos:definition "A work-performing role, dispatch-invoked only, that selects, prioritises and organises material that already exists into a curated, ordered collection -- deciding what is worth keeping, arranging it and framing its value for a reader -- rather than producing new content of its own. Choose it when the deliverable is a curated selection or an organised catalogue drawn from existing items. Distinguished from id:role-research, which GATHERS new material and grounds each finding in its source (the curator instead judges what to keep and how to arrange material already in hand); from id:role-author, which composes a finished prose document (the curator organises and frames rather than writing prose); and from id:role-analyst, which reports what is wrong with material against criteria (the curator orders by value rather than issuing a graded diagnosis)." ;
    ho:roleTool id:tool-editor ;
    ho:roleGuardrail id:gr-dispatch-execution, id:gr-least-privilege,
        id:gr-grounding, id:gr-structured-output ;
    ho:tagged id:c-multiagent, id:c-dispatch ;
    ho:roleMemoryPolicy "Reads its own role-scoped memory at session start and writes back reusable selection and organisation heuristics at session end; touches no other role's memory." ;
    ho:maturity "draft" .

# Oversight is a standing activity of its own, distinct from the worker
# archetypes above: continually holding a subject against an external reference
# or a declared standard and raising graded, evidence-backed claims or findings
# WITHOUT itself deciding on or applying the fix. Two archetypes recur across the
# corpus as an oversight pair -- one benchmarks the harness's own project against
# outside best practice, the other audits agents' charter-conformant operation
# against declared standards -- so they are added here as neutral siblings. Each
# definition says how it differs from the nearest existing role (research, analyst,
# synthesizer, vnv, inspection) so none collapse into near-synonyms.
id:role-benchmarker a ho:Role ;
    skos:prefLabel "Benchmarker agent" ; skos:altLabel "comparative critic" ;
    skos:definition "A work-performing role, dispatch-invoked only, that continually surveys external reference cases, compares the harness's own project against them and raises graded improvement claims about the gaps it finds, so the team can spend its effort on the shortfalls that matter most against outside best practice. Choose it when the deliverable is an evidence-backed, ranked set of improvement claims grounded in external comparators the role procured itself. Distinguished from id:role-research, which GATHERS external material but does not compare it against the harness's own project or raise claims; from id:role-analyst, whose subject is material it is GIVEN judged against stated criteria (the benchmarker instead sources its own external comparators and judges against external best practice); and from id:role-synthesizer, the terminal convergence gate that merges everyone's deliverables rather than critiquing the project against outside references." ;
    ho:roleTool id:tool-websearch, id:tool-retriever ;
    ho:roleGuardrail id:gr-dispatch-execution, id:gr-least-privilege,
        id:gr-grounding, id:gr-cite ;
    ho:providesCapability id:cap-benchmarking ;
    ho:tagged id:c-multiagent, id:c-oversight ;
    ho:roleMemoryPolicy "Reads its own role-scoped memory at session start and writes back reusable benchmarking comparators and heuristics at session end; touches no other role's memory." ;
    ho:maturity "draft" .

id:role-auditor a ho:Role ;
    skos:prefLabel "Auditor agent" ; skos:altLabel "compliance watchdog" ;
    skos:definition "A work-performing role, dispatch-invoked only, that continually audits the harness's own output and other agents' charter-conformant operation, raising an enforcement finding whenever behaviour or output drifts from the declared standards it is bound by. Choose it when the deliverable is an ongoing stream of compliance findings against a charter or standard rather than a one-off assessment. Distinguished from id:role-vnv, which returns a pass/fail verdict on the harness's own composition OUTPUT (the auditor instead audits, over time, whether agents operate WITHIN their charter); from id:role-inspection, this repository's own user-facing feedback-and-git lane; and from id:role-analyst, which diagnoses material it is given against stated criteria (the auditor instead polices operation and output against governance standards continuously)." ;
    ho:roleTool id:tool-retriever, id:tool-shell ;
    ho:roleGuardrail id:gr-dispatch-execution, id:gr-least-privilege,
        id:gr-traceability, id:gr-no-arbitrary-decision ;
    ho:providesCapability id:cap-audit ;
    ho:tagged id:c-multiagent, id:c-oversight, id:c-traceability ;
    ho:roleMemoryPolicy "Reads its own role-scoped memory at session start and writes back reusable audit checks and standard-conformance heuristics at session end; touches no other role's memory." ;
    ho:maturity "draft" .

# Simulation stand-in role (wave-S): the role that PLAYS the human side of a
# run under evaluation, from a hidden scenario, interacting only through the
# mediated environment surface (id:tool-env-interface) -- prompt omniscience
# removed by construction, which is the reliability mechanism. Hosted by
# id:h-workspace-synthesis like the oversight pair (library placement: no
# current harness runs an evaluation simulation; a concrete evaluation recipe
# binds it as its counterpart lane). Its confidentiality rule is
# id:gr-oracle-leak (also carried by that harness), scoped here via
# ho:roleGuardrail.
id:role-user-simulator a ho:Role ;
    skos:prefLabel "User simulator agent" ; skos:altLabel "simulated user" , "human-side stand-in" ;
    skos:definition "A work-performing role, dispatch-invoked only, that plays the HUMAN side of a run under evaluation from a hidden scenario -- an identity, an intent and preferences it discloses only as the subject agent asks -- and interacts with that agent solely through the tools and observation surface a real user would have, never through knowledge of the agent's internals or of the expected outcome. Choose it to exercise a conversational or task harness end to end without a live human. Distinguished from id:role-tester, which AUTHORS the checks and fixtures a later gate runs -- the simulator instead performs the counterpart side during the run itself -- and from id:role-analyst, which diagnoses material it is given: the simulator issues no findings; its deliverable is the conducted counterpart behaviour and its transcript." ;
    ho:roleTool id:tool-env-interface ;
    ho:roleGuardrail id:gr-dispatch-execution, id:gr-least-privilege, id:gr-oracle-leak ;
    ho:tagged id:c-simulation-standin, id:c-multiagent ;
    ho:roleMemoryPolicy "Reads its own role-scoped memory at session start and writes back reusable persona-play and disclosure heuristics at session end; touches no other role's memory." ;
    ho:maturity "draft" .

#===================== D. Coordination-only peer role ==================
# The dedicated coordinating peer of an agent team: it plans, sequences and
# tracks the status of the team's work but performs NONE of the execution
# itself, so a peer team keeps planning/status and doing in separate hands
# (id:gr-execution-separation) instead of collapsing them into one agent.
# Bound to id:h-peer-mesh via ho:hasRole -- that is where a peer team gains an
# explicit coordinating peer while the actual work is carried out by separately
# spawned execution agents. Its definition disambiguates it from the two
# nearest planning roles so the three never collapse into near-synonyms.
id:role-coordinator a ho:Role ;
    skos:prefLabel "Coordinator agent" ; skos:altLabel "coordinating peer" , "team coordinator" ;
    skos:definition "A coordination-only peer role in an agent team that plans, sequences and checks the status of the team's work but performs none of the execution itself -- the execution is carried out by execution agents spawned separately for it, so coordinating a peer team never collapses planning and doing into one agent. Choose it to give a peer team an explicit coordinating peer without letting that peer also do the work. Distinguished from id:role-orchestrator, which is the user-facing lead that decomposes a request and dispatches node-scoped briefs to workers (a central-dispatch lead, not a peer that runs alongside the team), and from id:role-planner, an ordinary dispatched worker whose deliverable is a plan document others then execute -- this role instead runs with the team throughout, coordinating and tracking status rather than producing a plan artifact." ;
    ho:roleGuardrail id:gr-execution-separation, id:gr-least-privilege, id:gr-verify-proceed ;
    ho:tagged id:c-multiagent, id:c-delegation ;
    ho:roleMemoryPolicy "Reads its own role-scoped memory at session start and writes back reusable coordination and status-tracking heuristics at session end; touches no other role's memory." ;
    ho:maturity "draft" .

########################################################################
# Operating agents — this repo's own five agents modelled as MAS nodes.
#
# Each ho:Agent is the partially-observed distributed node the harness
# compiles from a Role: it bundles ho:agentRole (its mandate/policy, an
# existing role above), ho:agentObservation (exactly one ObservationSpace =
# its observable envelope Omega_i, declared in the next section), and
# ho:agentFunction (its action space A_i, EXISTING capabilities the harness
# already provides/requires). All five share one modelled ho:cognitiveCapacity
# (150000) — the loss-free context each can use in one inference, derived
# from and kept consistent with id:mc-opus; the summed ho:tokenEstimate of
# an agent's AreasOfObservation stays well within it (capacity fit, checked by
# review since SHACL cannot sum). Bound to id:h-multiagent via ho:hasAgent
# (a sub-property of hasComponent, so each agent is a connected, orphan-free
# component and its ObservationSpace + areas roll up by the hasComponent chain).
########################################################################

#===================== AGENTS ==========================================

id:agent-orchestrator a ho:Agent ;
    skos:prefLabel "Orchestrator agent (node)" ;
    skos:definition "The planning/dispatch node the harness compiles from the orchestrator role: it perceives the dispatch, agent-user and orchestrator-inspection channels and the plan/brief documents (external area) plus its own role and cache (internal area), and its function is multi-agent orchestration. It does NOT observe any worker's execution internals." ;
    ho:agentRole id:role-orchestrator ;
    ho:agentObservation id:os-orchestrator ;
    ho:agentFunction id:cap-orchestration ;
    ho:cognitiveCapacity 150000 ;
    ho:tagged id:c-multiagent, id:c-delegation ;
    ho:maturity "draft" .

id:agent-developer a ho:Agent ;
    skos:prefLabel "Developer agent (node)" ;
    skos:definition "The authoring node the harness compiles by instantiating the neutral implementer role archetype: it perceives its own dispatch brief and the assigned knowledge-graph nodes as a budget-capped retrieval pack (external area) plus its own role and cache (internal area), and its functions are file editing and code execution. It does NOT observe other nodes of the graph or other workers' internals." ;
    ho:agentRole id:role-implementer ;
    ho:agentObservation id:os-developer ;
    ho:agentFunction id:cap-fileedit, id:cap-codeexec ;
    ho:cognitiveCapacity 150000 ;
    ho:tagged id:c-multiagent, id:c-bounded-context ;
    ho:maturity "draft" .

id:agent-vnv a ho:Agent ;
    skos:prefLabel "Verification agent (node)" ;
    skos:definition "The verification node the harness compiles from the vnv role: it perceives the verification-target artifacts and the validator/tool output over the dispatch channel (external area) plus its own role and cache (internal area), and its function is code execution (running the validators). It does NOT observe the authoring internals of the components it judges." ;
    ho:agentRole id:role-vnv ;
    ho:agentObservation id:os-vnv ;
    ho:agentFunction id:cap-codeexec ;
    ho:cognitiveCapacity 150000 ;
    ho:tagged id:c-multiagent, id:c-verify-proceed ;
    ho:maturity "draft" .

id:agent-inspection a ho:Agent ;
    skos:prefLabel "Inspection agent (node)" ;
    skos:definition "The inspection node the harness compiles from the inspection role, running in its own session: it perceives the WHOLE design graph and the feedback documents over the agent-user and orchestrator-inspection channels (a WIDE external area) plus its own role and cache (internal area), yet acts narrowly (feedback + git lifecycle) — its function is traceability, keeping a single source of truth. It does NOT observe the internal sessions of the dispatched workers." ;
    ho:agentRole id:role-inspection ;
    ho:agentObservation id:os-inspection ;
    ho:agentFunction id:cap-traceability ;
    ho:cognitiveCapacity 150000 ;
    ho:tagged id:c-multiagent, id:c-online-agent ;
    ho:maturity "draft" .

id:agent-synthesizer a ho:Agent ;
    skos:prefLabel "Synthesizer agent (node)" ;
    skos:definition "The convergence node the harness compiles from the synthesizer role: it perceives every worker's deliverable in the shared file workspace (external area) plus its own role and cache (internal area), and its function is synthesis (cross-checking and compiling the integrated result). It does NOT observe each worker's internal reasoning behind the deliverables it converges." ;
    ho:agentRole id:role-synthesizer ;
    ho:agentObservation id:os-synthesizer ;
    ho:agentFunction id:cap-synthesis ;
    ho:cognitiveCapacity 150000 ;
    ho:tagged id:c-multiagent, id:c-synthesis ;
    ho:maturity "draft" .
