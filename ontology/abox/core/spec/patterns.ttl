@prefix ho:    <https://harness-ontology.dev/schema#> .
@prefix id:    <https://harness-ontology.dev/id/core/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:   <http://purl.org/dc/terms/> .

# Core data unit -- DesignPattern partition of the `core` domain. It also hosts
# the ho:ExecutionMode individuals (the orthogonal runtime-topology axis), which
# are co-located here because runtime topology is a first-class Harness property
# (ho:hasExecutionMode) read side by side with the architectural patterns.
# Imports the central TBox only; cross-unit references resolve in the root union
# (docs/federation-design.md D1, ONTOLOGYSTYLE 4).
<https://harness-ontology.dev/data/core/patterns> a owl:Ontology ;
    owl:imports <https://harness-ontology.dev/schema> .

#===================== Design patterns =================================
id:pat-react a ho:DesignPattern ; skos:prefLabel "ReAct" ;
    skos:definition "Interleave reasoning and tool actions in a loop." .
id:pat-planexec a ho:DesignPattern ; skos:prefLabel "Plan-then-execute" ;
    skos:definition "Draft a full plan, then execute steps." .
id:pat-reflection a ho:DesignPattern ; skos:prefLabel "Reflection" ;
    skos:definition "Critique and revise an initial answer before returning it." .
id:pat-orchestrator-workers a ho:DesignPattern ; skos:prefLabel "Orchestrator-workers" ;
    skos:definition "A central orchestrator decomposes work into node-scoped tasks, dispatches them to specialised worker agents, and integrates the results; roles carry least-privilege file boundaries." ;
    ho:tagged id:c-pattern-taxonomy .
id:pat-peer-mesh a ho:DesignPattern ; skos:prefLabel "Peer-mesh" ; skos:altLabel "peer message mesh" ;
    skos:definition "Peer agents coordinate DIRECTLY with one another over a message mesh — each sends work, requests, judgments and results to any peer — rather than routing every hand-off through a single central orchestrator; there is no central-only dispatch bottleneck. The alternative coordination topology to orchestrator-workers. Coordination topology is a PLUGGABLE, EXTENSIBLE dimension: a harness declares its methodology explicitly via ho:appliesPattern plus the matching ho:Channel(s) — orchestrator-workers (central dispatch, id:chan-dispatch) or peer-mesh (direct peer coordination, id:chan-peer) — and a NEW topology is added as a new ho:DesignPattern + ho:Channel without disturbing the existing ones, so different methodologies coexist and recipes select the one they need." ;
    ho:tagged id:c-multiagent, id:c-pattern-taxonomy ; ho:maturity "reviewed" .
id:pat-ontology-composition a ho:DesignPattern ; skos:prefLabel "Ontology-driven composition" ;
    skos:definition "Assemble a harness as a connected region of the knowledge graph, built from parts the ontology types -- a bill of materials -- rather than authoring from scratch: reuse existing individuals, bind every required capability to a provider that supplies it, satisfy the harness shape's minimums, and keep every node connected and discoverable so nothing is orphaned. Choose when a validated library of neutral parts exists and a new harness should be built by selection and wiring." ;
    ho:maturity "reviewed" .
id:pat-knowledge-plane-separation a ho:DesignPattern ; skos:prefLabel "Knowledge-plane separation" ; skos:altLabel "separation of concerns by knowledge kind" , "knowledge-plane context isolation" ;
    skos:definition "Partition an agent's working context by KIND of knowledge -- comments, design rationale, schemas, interfaces, a typed knowledge graph -- because each is adjudicated differently (social resolution, argument, schema or type check, shape validation) and carries its own native stable identifier. Planes couple ONLY through a link plane of typed edges, never by quoting one inside another; views are assembled per request by query, never stored; and tools are scoped to the plane in hand -- layering the store achieves nothing if a read still returns every plane at once. Choose when one agent works across knowledge settled in incompatible ways -- otherwise checked fact and open claim carry one confidence; the link plane is the standing cost, so keep plane count and link types few. Complements id:c-bounded-context, which bounds HOW MUCH of a store enters a context: this fixes WHICH KIND enters, and its planes are knowledge kinds, not id:c-execution-mode's runtime lanes." ;
    ho:tagged id:c-bounded-context ; ho:tokenEstimate 243 ; ho:maturity "draft" .

# CONNECTIVITY of the pattern below is by concept tag, not ho:appliesPattern
# (the pat-pipeline / pat-supervisor precedent): no current harness IS the
# control arm -- asserting appliesPattern on one would fabricate the fact --
# and the coding recipe binds it as its comparison arm on the recipe side.
# NOT a duplicate of the existing catalogue: id:gr-simplicity prefers the
# simplest form INSIDE whatever is being built, and id:gr-discriminating-eval /
# id:wfs-baseline-compare state the with-and-without comparison DISCIPLINE --
# this is the archetype of the comparison arm itself, a whole harness kept
# deliberately minimal so that discipline has a standing subject.
id:pat-minimal-baseline a ho:DesignPattern ; skos:prefLabel "Minimal baseline" ; skos:altLabel "control-arm harness" ;
    skos:definition "Keep one deliberately minimal harness configuration -- a single general-purpose tool, a linear history, no added scaffolding -- as the standing control arm every richer composition is compared against: an added part earns its place only by beating this baseline on the same requests. Minimal agents score competitively on hard coding work, so the baseline is a genuine rival, not a straw man. Choose it when composing or enriching a harness and the value of each added part must be demonstrated rather than assumed. Distinguished from id:gr-simplicity, which prefers the simplest form inside whatever is being built, and from id:gr-discriminating-eval, which states the with-and-without comparison rule: this is the archetype of the comparison arm itself." ;
    ho:tagged id:c-agent-methodology ; ho:tokenEstimate 188 ; ho:maturity "draft" .

#===================== Execution modes (runtime topology) ==============
# The runtime coordination topology a harness runs its agents in, declared by
# ho:hasExecutionMode -- a first-class Harness property, ORTHOGONAL to the
# architectural patterns below (which stay on ho:appliesPattern). The axis is
# extensible by INDIVIDUAL: a new mode is one more ho:ExecutionMode node here,
# with no schema or shape change.
id:mode-agent-teams a ho:ExecutionMode ; skos:prefLabel "Peer agent-team mode" ; skos:altLabel "peer team topology" ;
    skos:definition "A persistent team of peer agents runs together for the span of the run and coordinates as a group -- the team is stood up front, peers address one another by name and share a task list -- rather than each agent being spawned and reclaimed individually by a lead. Choose when the agents must negotiate with one another WHILE working (exploration, mutual review, shared state); it costs a live team for the whole run, so choose id:mode-sub-agents instead when every subtask can be briefed completely up front. Coordinating as a group does NOT merge planning and doing: even here the plan/status roles and the execution stay separated -- a peer that plans the work or tracks its status does not itself execute, and the execution is carried out by execution agents spawned separately for it (id:gr-execution-separation), so an agent team still keeps planning/status and execution in distinct, separately-spawned hands." ;
    ho:tagged id:c-execution-mode ; ho:tokenEstimate 190 ; ho:maturity "draft" .
id:mode-sub-agents a ho:ExecutionMode ; skos:prefLabel "Sub-agent spawn mode" ; skos:altLabel "spawn-and-reclaim topology" ;
    skos:definition "A lead agent spawns lightweight, short-lived sub-agents for scoped subtasks and reclaims their results: an agent exists only for the span of its delegated task and reports back through the lead, which is the single integration point. Choose when subtasks are independently scoped and each dispatch can be briefed completely up front (cold-start workers, least privilege per task); choose id:mode-agent-teams instead when the agents must coordinate directly with each other while working." ;
    ho:tagged id:c-execution-mode ; ho:tokenEstimate 105 ; ho:maturity "draft" .
id:mode-standing-service a ho:ExecutionMode ; skos:prefLabel "Standing service mode" ; skos:altLabel "persistent-session topology" , "online agent lane" ;
    skos:definition "One or more agents each hold an assigned role in a session that stays OPEN BEYOND any single task or run, serving requests as they arrive: work reaches a standing agent over durable channels (files with status markers, a task board, direct user chat), and it scans its channels on its own cycle, consuming an item only once it is marked complete. Choose when the harness needs a lane that outlives the run -- an intake, maintainer or review agent that must be addressable at any moment and carry context across requests. Choose id:mode-sub-agents instead when every unit of work can be briefed completely up front and its worker reclaimed at the end, and id:mode-agent-teams when the coordinating agents live for the span of ONE run and are torn down with it, whereas a standing agent persists past the run. Distinct from id:mode-hybrid, which is ONE topology varying by PHASE of a run: a standing lane alongside dispatched workers is two planes running at once, which a harness declares by carrying both modes." ;
    ho:tagged id:c-execution-mode ; ho:tokenEstimate 252 ; ho:maturity "draft" .
id:mode-hybrid a ho:ExecutionMode ; skos:prefLabel "Hybrid phase-varying mode" ; skos:altLabel "phase-switching topology" ;
    skos:definition "The runtime coordination topology VARIES BY PHASE of the run -- for example a persistent peer team while exploring and lightweight sub-agents while executing -- so one harness switches execution mode as it moves between phases instead of fixing one topology for the whole run. Choose when the phases genuinely have different coordination needs; it costs the complexity of running two topologies, so choose a single mode whenever one fits the whole run." ;
    ho:tagged id:c-execution-mode ; ho:tokenEstimate 105 ; ho:maturity "draft" .

#===================== Architectural coordination patterns =============
# How work flows and is structured across agents (the data-flow architecture),
# orthogonal to the runtime execution mode above. Tagged c-pattern-taxonomy.
id:pat-pipeline a ho:DesignPattern ; skos:prefLabel "Pipeline" ; skos:altLabel "sequential stages" ;
    skos:definition "Work moves through a fixed sequence of stages where each stage consumes the previous stage's output and produces input for the next, like an assembly line. Choose when the task decomposes into ordered, dependent steps with a single forward flow." ;
    ho:tagged id:c-pattern-taxonomy ; ho:maturity "draft" .
id:pat-fanout-fanin a ho:DesignPattern ; skos:prefLabel "Fan-out/fan-in" ; skos:altLabel "parallel then integrate" ;
    skos:definition "One coordinator fans work out to several agents that run in parallel on independent sub-parts, then fans their results back in to a single integration step. Choose when sub-parts are independent and parallelisable and the results must be merged. Contrast id:pat-orchestrator-workers, which dispatches HETEROGENEOUS specialised sub-tasks to different worker roles: fan-out/fan-in splits one HOMOGENEOUS workload into parallel identical shares and merges them, rather than assigning distinct specialisations." ;
    ho:tagged id:c-pattern-taxonomy ; ho:maturity "draft" .
id:pat-expert-pool a ho:DesignPattern ; skos:prefLabel "Expert pool" ; skos:altLabel "router to specialist" ;
    skos:definition "A router inspects each incoming request and dispatches it to the best-matching specialist drawn from a pool of experts, rather than sending every request through the same generalist. Choose when requests are heterogeneous and different specialists handle them better than one generalist. Contrast id:pat-supervisor, which re-allocates work DYNAMICALLY as run-time state evolves: the expert pool routes each request by its CONTENT to a fixed specialist -- a stateless per-request match -- rather than adapting assignments to changing state." ;
    ho:tagged id:c-pattern-taxonomy ; ho:maturity "draft" .
id:pat-producer-reviewer a ho:DesignPattern ; skos:prefLabel "Producer-reviewer" ; skos:altLabel "generate-and-check loop" ;
    skos:definition "A producer agent generates a candidate and a reviewer agent checks it, iterating in a BOUNDED loop until the reviewer accepts or a retry cap is reached (see id:gr-bounded-iteration). Choose when output quality benefits from an explicit separate critique step rather than self-review. Contrast id:pat-reflection, where a SINGLE agent critiques and revises its OWN output: producer-reviewer separates producing and reviewing into two distinct agents, giving an independent critic rather than self-review." ;
    ho:tagged id:c-pattern-taxonomy ; ho:maturity "draft" .
id:pat-supervisor a ho:DesignPattern ; skos:prefLabel "Supervisor" ; skos:altLabel "dynamic runtime allocation" ;
    skos:definition "A supervisor allocates work to worker agents DYNAMICALLY at run time -- deciding what to assign to whom as tasks are claimed and as state evolves -- rather than deciding the whole assignment up front. Contrast id:pat-orchestrator-workers, where the orchestrator STATICALLY pre-allocates node-scoped briefs before dispatch; the supervisor's assignment is reactive and adaptive." ;
    ho:tagged id:c-pattern-taxonomy ; ho:maturity "draft" .
id:pat-hierarchical-delegation a ho:DesignPattern ; skos:prefLabel "Hierarchical delegation" ; skos:altLabel "two-level recursive delegation" ;
    skos:definition "A top coordinator delegates to sub-coordinators, each of which further delegates to its own workers -- delegation recurses one extra level rather than staying flat. Kept shallow by id:gr-depth-limit (at most two levels). Choose only when the task genuinely needs a layer of sub-coordination." ;
    ho:tagged id:c-pattern-taxonomy ; ho:maturity "draft" .
id:pat-blackboard a ho:DesignPattern ; skos:prefLabel "Blackboard coordination" ; skos:altLabel "shared-artifact state handoff" ;
    skos:definition "Agents coordinate INDIRECTLY through a shared, durable external artifact store -- files, a state record, a plan document -- that is the single source of truth, rather than through a central orchestrator's in-context dispatch (id:pat-orchestrator-workers) or direct peer messages (id:pat-peer-mesh): each step reads the prior steps' outputs from the store and writes its own back, so no step depends on conversation or context-window memory. Choose when the run must be stateless, resumable and checkpointable across steps or sessions -- work can halt and restart from the store -- or when several contributors must converge on one evolving artifact. Distinct from id:pat-pipeline, which fixes an ordered forward flow: blackboard constrains the coordination MEDIUM (a shared store held as source of truth), not the ordering, and steps may read and write the store outside a strict sequence." ;
    ho:tagged id:c-pattern-taxonomy ; ho:tokenEstimate 200 ; ho:maturity "draft" ;
    dct:source "https://github.com/wshobson/agents" ; dct:license "MIT" .

#===================== Autonomy tiers (responsibility allocation) ======
# The named allocations of responsibility between user and harness, declared
# by ho:autonomyTier -- a first-class Harness property co-located here for the
# same reason as the execution modes above (a spec axis read side by side with
# the patterns; a new federation unit would cost root + catalog entries for six
# leaf individuals). The set is a ladder only in the informal sense: the
# DISCRIMINATOR is the approval unit (how coarse a grain of work one human
# approval covers), and the slots are data so ho:HarnessAutonomyShape can check
# the usage implications. What each tier fixes is who DECIDES and who ACTS at
# that grain (ho:executionOwner / ho:oversightOwner, with ho:fallbackOwner for
# the exit), so every label names an allocation of responsibility -- never an
# ordinal rank, which would impose a false total order on what is a choice of
# approval grain. Two neighbouring vocabularies are DELIBERATELY LEFT OUT of
# these labels and slots (explicit out-of-model exclusion, per the
# coverage-audit convention): where a human sits relative to the run loop, and
# WHY a human is in it at all (correcting, legitimating, being accountable).
# Both are orthogonal -- one loop position spans several tiers and one tier
# admits several reasons -- so folding either into a tier label would lose
# information; each enters, if ever, as its own axis. Extensible by INDIVIDUAL,
# like the modes.
id:tier-advisory a ho:AutonomyTier ; skos:prefLabel "Advisory tier" ; skos:altLabel "recommend-only allocation" ;
    skos:definition "The harness only recommends and the user does everything: analysis and proposals flow out, but no action is executed by the harness at all, so no range needs declaring and no approvals are exchanged. A REAL allocation, not a degenerate one -- starting the tier set at the first executing tier would lose the configuration many review- and advice-harnesses actually run in." ;
    ho:executionOwner "user" ; ho:oversightOwner "user" ; ho:fallbackOwner "user" ;
    ho:envelopeBinding "none" ; ho:approvalUnit "none" ;
    ho:tagged id:c-autonomy, id:c-operating-envelope ; ho:tokenEstimate 108 ; ho:maturity "draft" .
id:tier-per-action-approval a ho:AutonomyTier ; skos:prefLabel "Per-action approval tier" ; skos:altLabel "every action confirmed" ;
    skos:definition "The harness acts, but every action passes through the user before it runs: the finest approval unit, with the user inline for each step. Choose when actions are individually consequential and the user is present throughout; the cost is that the user's attention is the throughput bound. Distinguished from id:tier-per-plan-approval, where one approval covers a whole plan." ;
    ho:executionOwner "user-and-harness" ; ho:oversightOwner "user" ; ho:fallbackOwner "user" ;
    ho:envelopeBinding "bounded" ; ho:approvalUnit "per-action" ;
    ho:tagged id:c-autonomy, id:c-operating-envelope ; ho:tokenEstimate 116 ; ho:maturity "draft" .
id:tier-per-plan-approval a ho:AutonomyTier ; skos:prefLabel "Per-plan approval tier" ; skos:altLabel "plan approved, execution autonomous" ;
    skos:definition "The user approves a plan up front and the harness executes it autonomously within the declared envelope; mid-run the user is reached over a declared user channel when the range is exited, so the fallback owner is a RECEPTIVE user who must respond within a window. Choose for milestone-gated work (present the plan, get sign-off, run). Distinguished from id:tier-per-action-approval by the coarser approval unit, and from id:tier-bounded-autonomy, where no plan is pre-approved and only exceptions escalate." ;
    ho:executionOwner "harness" ; ho:oversightOwner "user" ; ho:fallbackOwner "receptive-user" ;
    ho:envelopeBinding "bounded" ; ho:approvalUnit "per-plan" ;
    ho:tagged id:c-autonomy, id:c-operating-envelope ; ho:tokenEstimate 152 ; ho:maturity "draft" .
id:tier-bounded-autonomy a ho:AutonomyTier ; skos:prefLabel "Bounded autonomy tier" ; skos:altLabel "exception-escalation allocation" ;
    skos:definition "The harness works autonomously inside its declared envelope and brings the user in only for exceptions -- range exits, irreversible steps, open decisions -- while the user, present in the interactive loop, owns the fallback directly. The default allocation for an interactive working agent. Distinguished from id:tier-per-plan-approval by having no up-front plan gate, and from id:tier-monitored-autonomy by the user being in the loop rather than reading reports after the fact." ;
    ho:executionOwner "harness" ; ho:oversightOwner "user" ; ho:fallbackOwner "user" ;
    ho:envelopeBinding "bounded" ; ho:approvalUnit "per-exception" ;
    ho:tagged id:c-autonomy, id:c-operating-envelope ; ho:tokenEstimate 142 ; ho:maturity "draft" .
id:tier-monitored-autonomy a ho:AutonomyTier ; skos:prefLabel "Monitored autonomy tier" ; skos:altLabel "post-hoc reporting allocation" ;
    skos:definition "The harness runs unattended inside its declared envelope and reports after the fact; no human is assumed reachable during the run, so on a range exit the harness itself must reach the safe-halt state (ho:HarnessAutonomyShape requires it to provide the safe-halt capability). Choose for standing or scheduled lanes where requests arrive while no one watches. Distinguished from id:tier-bounded-autonomy by the fallback owner: there the user is in the loop, here the harness halts itself and the user learns from the report." ;
    ho:executionOwner "harness" ; ho:oversightOwner "harness" ; ho:fallbackOwner "harness" ;
    ho:envelopeBinding "bounded" ; ho:approvalUnit "post-hoc" ;
    ho:tagged id:c-autonomy, id:c-operating-envelope ; ho:tokenEstimate 153 ; ho:maturity "draft" .
id:tier-unbounded a ho:AutonomyTier ; skos:prefLabel "Unbounded tier" ; skos:altLabel "declared rangeless allocation" ;
    skos:definition "The boundary tier: the harness executes, oversees and owns its own fallback with NO declared envelope -- explicitly rangeless, which is a state to flag in review, never a default to drift into. It exists so that the absence of a range is a deliberate, visible declaration rather than an omission; a harness that means to run unattended within a range wants id:tier-monitored-autonomy instead." ;
    ho:executionOwner "harness" ; ho:oversightOwner "harness" ; ho:fallbackOwner "harness" ;
    ho:envelopeBinding "unbounded" ; ho:approvalUnit "none" ;
    ho:tagged id:c-autonomy, id:c-operating-envelope ; ho:tokenEstimate 118 ; ho:maturity "draft" .
