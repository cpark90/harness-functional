@prefix ho:    <https://harness-ontology.dev/schema#> .
@prefix id:    <https://harness-ontology.dev/id/core/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .

# Core data unit -- Capability partition of the `core` domain. Imports the
# central TBox only; cross-unit references resolve in the root union
# (docs/federation-design.md D1, ONTOLOGYSTYLE 4).
<https://harness-ontology.dev/data/core/capabilities> a owl:Ontology ;
    owl:imports <https://harness-ontology.dev/schema> .

#===================== Capabilities ====================================
id:cap-codeexec a ho:Capability ; skos:prefLabel "Code execution" ;
    skos:definition "Run code and shell commands in a controlled environment and return their output, so a component can compute, test and execute programs rather than only reason about them." .
id:cap-fileedit a ho:Capability ; skos:prefLabel "File editing" ;
    skos:definition "Create and modify files in the workspace -- reading, writing and applying precise edits -- so a component can author and change artifacts directly rather than only describe them." .
id:cap-websearch a ho:Capability ; skos:prefLabel "Web search" ;
    skos:definition "Query the public web for current information and return ranked results, so a component can retrieve facts that lie beyond the model's training data." .
id:cap-retrieval a ho:Capability ; skos:prefLabel "Document retrieval" ; skos:altLabel "RAG" ;
    skos:definition "Search a document corpus or knowledge store and return the passages most relevant to a query, so a component can ground its answers in retrieved source material." .
id:cap-citation a ho:Capability ; skos:prefLabel "Source citation" ;
    skos:definition "Attach a verifiable reference to the originating source for each factual claim, so downstream consumers can trace every assertion back to where it came from." .
id:cap-orchestration a ho:Capability ; skos:prefLabel "Multi-agent orchestration" ;
    skos:definition "Decompose work into node-scoped briefs, dispatch them to specialised worker agents under least-privilege, and integrate the results." .
id:cap-traceability a ho:Capability ; skos:prefLabel "Traceability" ;
    skos:definition "Preserve a single source of truth: never delete a decision, only deprecate it with a reason and replacement, and increment identifiers without reuse." .
id:cap-synthesis a ho:Capability ; skos:prefLabel "Synthesis" ;
    skos:definition "Converge the separate deliverables produced by multiple worker roles into one coherent, cross-checked final result -- the terminal convergence step of a multi-agent workflow, provided by a component that both reviews every contribution and compiles the integrated output." .
id:cap-benchmarking a ho:Capability ; skos:prefLabel "Comparative benchmarking" ;
    skos:definition "Compare a subject against external reference cases to quantify the gap between them and produce evidence-backed improvement claims, so a component can rank where the subject falls short of outside best practice rather than only describe its own state." .
id:cap-audit a ho:Capability ; skos:prefLabel "Compliance audit" ;
    skos:definition "Audit an artifact and an agent's operation against a declared standard or charter and produce compliance findings, so a component can surface where behaviour or output has drifted from the rules it is bound by rather than only assess quality in the abstract." .

# The skill-authoring/packaging capability: a component that PROVIDES it knows how
# to author a well-formed Claude skill (an on-demand ho:Instruction emitted as a
# named SKILL.md). Its verification contracts (below) judge the emitted skill tree.
id:cap-skill a ho:Capability ; skos:prefLabel "Skill authoring and packaging" ; skos:altLabel "skill packaging" ;
    skos:definition "Author and package a Claude skill -- an on-demand ho:Instruction procedure that tools/materialize.py emits as a named .claude/skills/<name>/SKILL.md -- in well-formed shape: a present frontmatter description and the required title heading, so the skill is discoverable, invocable and passes its structural contract." ;
    ho:capabilityContract id:ct-well-formed-skill-description, id:ct-well-formed-skill-heading .

#===================== Verification contracts =========================
# ho:Contract instances (VerificationComponent) attached to the capabilities
# above via ho:capabilityContract. These are the FIRST central ho:Contract
# individuals (they close B22: the class + verify_contract.py mechanism existed
# with zero ABox instances). Co-located with cap-skill because no dedicated
# core/verification data unit exists yet; contract IRIs are location-independent,
# so relocating them into one later is a pure move. Each carries EXACTLY ONE
# ho:contractCheck (verify_contract.py reads it with g.value -- a single value)
# and no ho:tokenEstimate (bind/verify metadata, no promptText -- the ho:Candidate
# precedent). They judge the MATERIALIZED skill tree of any harness that binds a
# cap-skill provider: the .claude/skills/well-formed-skill/SKILL.md that
# materialize.py emits for id:ins-well-formed-skill (its provider). Because that
# path is what materialize ACTUALLY emits, running verify_contract.py against the
# binding harness (id:h-harness-factory) PASSES rather than false-failing -- the
# contract is TRUE, not a target-mismatched assertion against a root-level
# SKILL.md the harness never emits.
id:ct-well-formed-skill-description a ho:Contract ;
    skos:prefLabel "Well-formed skill: description present" ;
    skos:definition "Structural contract on cap-skill: the emitted skill file carries a frontmatter description field, so the skill is discoverable and invocable. Judged against the .claude/skills/well-formed-skill/SKILL.md that materialize.py emits for id:ins-well-formed-skill." ;
    ho:contractKind "structural" ;
    ho:contractCheck "file-contains:.claude/skills/well-formed-skill/SKILL.md::description" ;
    ho:maturity "draft" .

id:ct-well-formed-skill-heading a ho:Contract ;
    skos:prefLabel "Well-formed skill: title heading present" ;
    skos:definition "Structural contract on cap-skill: the emitted skill file has its required Markdown title heading. Judged against the .claude/skills/well-formed-skill/SKILL.md that materialize.py emits for id:ins-well-formed-skill (the heading equals the instruction's prefLabel)." ;
    ho:contractKind "structural" ;
    ho:contractCheck "section:.claude/skills/well-formed-skill/SKILL.md::Well-formed skill authoring" ;
    ho:maturity "draft" .
