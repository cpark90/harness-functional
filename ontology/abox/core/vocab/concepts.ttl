@prefix ho:    <https://harness-ontology.dev/schema#> .
@prefix id:    <https://harness-ontology.dev/id/core/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .

# Core data unit -- Concept + ConceptScheme partition of the `core` domain. This is the
# terminology (glossary) layer: every Concept is a defined term (prefLabel + definition),
# not a bare tag. Imports the central TBox only; cross-unit references resolve in the root
# union (docs/federation-design.md D1, ONTOLOGYSTYLE 4).
#
# Every term here declares WHICH CONTENT AXIS it sits on via ho:conceptFacet
# (anatomy | quality | method | domain | scope), decided by the ONTOLOGYSTYLE 3 tests, not
# by resemblance to a neighbour. The axis is an attribute, never a layer of parent nodes:
# the tree's DEPTH is unchanged by it, which is why the facet costs nothing in retrieval.
# A term whose facet differs from its skos:broader parent's is misplaced, not annotated —
# it is re-parented under a top of its own facet (its old association survives as
# skos:related), and a `scope` parent constrains nothing because it says nothing about
# content.
<https://harness-ontology.dev/data/core/concepts> a owl:Ontology ;
    owl:imports <https://harness-ontology.dev/schema> .

#===================== Subject-matter concepts (what a harness is about) ====
# Three boundary calls in this block, each settled by the ONTOLOGYSTYLE 3 tests rather
# than by resemblance, so they are not re-litigated term by term:
#   c-communication = anatomy — it names the harness's message/channel SURFACE (test 1: a
#     part), which is exactly why its three message-DISCIPLINE children are method and sit
#     under the methodology top instead.
#   c-inforetrieval = domain — search is the SUBJECT AREA of the work (test 2); the part
#     that performs it is a Tool, so test 1 never fires.
#   c-oversight = quality — "how well is this harness overseen" is answerable of the
#     harness (test 4), and its children name STATES of oversight (automation bias,
#     rubber-stamping), not imperatives, so test 5 is never reached.
id:c-softeng a ho:Concept ;
    skos:prefLabel "Software engineering" ;
    skos:definition "The practice of building, modifying and maintaining software systems; tag harnesses and components whose subject matter is code authorship and engineering work." ;
    skos:topConceptOf id:scheme ; ho:conceptFacet "domain" .
id:c-debugging a ho:Concept ;
    skos:prefLabel "Debugging" ;
    skos:definition "The activity of locating and fixing defects in existing software; tag harnesses focused on diagnosis and repair rather than greenfield authorship." ;
    skos:broader id:c-softeng ; ho:conceptFacet "domain" .
id:c-inforetrieval a ho:Concept ;
    skos:prefLabel "Information retrieval" ;
    skos:definition "Finding and surfacing relevant information from a corpus or knowledge store; tag harnesses and tools whose core job is search and retrieval." ;
    skos:topConceptOf id:scheme ; ho:conceptFacet "domain" .
id:c-summarization a ho:Concept ;
    skos:prefLabel "Summarization" ;
    skos:definition "Condensing source material into a shorter faithful rendering; tag components that compress or abstract retrieved content." ;
    skos:broader id:c-inforetrieval ; ho:conceptFacet "domain" .
id:c-safety a ho:Concept ;
    skos:prefLabel "Safety" ;
    skos:definition "Avoidance of harmful, irreversible or unsafe actions; tag guardrails and components whose purpose is to keep agent behaviour within safe bounds." ;
    skos:topConceptOf id:scheme ; ho:conceptFacet "quality" .
id:c-autonomy a ho:Concept ;
    skos:prefLabel "Autonomy" ;
    skos:definition "The degree to which an agent acts without human intervention; tag harnesses whose design turns on how much independent initiative the agent is granted." ;
    skos:topConceptOf id:scheme ; skos:related id:c-safety ; ho:conceptFacet "quality" .
id:c-communication a ho:Concept ;
    skos:prefLabel "Communication" ;
    skos:definition "How agents and users exchange information and status; tag components governing message form, channels and reporting discipline." ;
    skos:topConceptOf id:scheme ; ho:conceptFacet "anatomy" .
id:c-design a ho:Concept ;
    skos:prefLabel "Design methodology" ;
    skos:definition "Principles for structuring a system or solution well; tag components that encode engineering-design discipline such as simplicity and root-cause reasoning." ;
    skos:topConceptOf id:scheme ; ho:conceptFacet "method" .
id:c-multiagent a ho:Concept ;
    skos:prefLabel "Multi-agent orchestration" ;
    skos:definition "Coordinating multiple specialised agents toward one goal; tag harnesses and principles about role division, dispatch and delegation." ;
    skos:topConceptOf id:scheme ; skos:related id:c-autonomy ; ho:conceptFacet "scope" .
id:c-memory a ho:Concept ;
    skos:prefLabel "Agent memory" ;
    skos:definition "The memory architecture an agent maintains -- the firmware/cache/long-term tiers distinguished by read-timing and persistence." ;
    skos:topConceptOf id:scheme ; skos:related id:c-autonomy ; ho:conceptFacet "anatomy" .
id:c-traceability a ho:Concept ;
    skos:prefLabel "Traceability" ;
    skos:definition "Keeping every decision and artifact linked to its source and history; tag components that enforce provenance, non-deletion and grounded records." ;
    skos:topConceptOf id:scheme ; ho:conceptFacet "quality" .
id:c-oversight a ho:Concept ;
    skos:prefLabel "Oversight" ;
    skos:definition "Continually holding a subject against an external reference or a declared standard and raising evidence-backed claims and findings about where it falls short, without itself deciding on or applying the fix; tag the benchmarking and audit roles and capabilities that watch a harness's work rather than perform or decide it." ;
    skos:topConceptOf id:scheme ; skos:related id:c-traceability ; ho:conceptFacet "quality" .

#===================== Governance methodology (cross-cutting principles) =====
# Each term below is the *principle* a governance guardrail enforces, kept distinct from
# the enforceable Guardrail rule itself (concept = the defined idea, guardrail = the policy
# that applies it). Domain-specific principles hang under an existing top (safety/design/
# traceability/multi-agent); the remaining operational disciplines hang under the
# methodology top concept. Every term is connected via skos:broader + guardrail tags.
# The three message-discipline principles (report-over-prompt, controlled-vocabulary,
# structured-output) sit HERE rather than under id:c-communication: a practice cannot be a
# part, so their `method` facet could never satisfy that anatomy parent's test. Their
# association with the communication surface survives as skos:related, which keeps them
# discoverable from it without putting a rule inside a component branch.
id:c-agent-methodology a ho:Concept ;
    skos:prefLabel "Agent governance methodology" ;
    skos:altLabel "operational discipline" ;
    skos:definition "Cross-cutting operational disciplines that govern how an agent or multi-agent harness conducts its work, independent of the task domain; the parent term for principles like least privilege, verify-then-proceed and design-for-loss." ;
    skos:topConceptOf id:scheme ; ho:conceptFacet "method" .

id:c-least-privilege a ho:Concept ;
    skos:prefLabel "Least privilege" ;
    skos:altLabel "separation of duties" ;
    skos:definition "The principle that each role edits only its own responsibility boundary and holds the minimum permissions needed, keeping authoring, judgment, application and version control in separate hands." ;
    skos:broader id:c-agent-methodology ; ho:conceptFacet "method" .
id:c-verify-proceed a ho:Concept ;
    skos:prefLabel "Verify then proceed" ;
    skos:altLabel "no time assumptions" ;
    skos:definition "The principle of advancing only on confirmed state rather than assuming readiness from elapsed time, treating timeouts as give-up bounds and not as correctness premises." ;
    skos:broader id:c-agent-methodology ; ho:conceptFacet "method" .
id:c-design-for-loss a ho:Concept ;
    skos:prefLabel "Design for loss" ;
    skos:definition "The principle of treating message and data loss as a normal event -- judging completion by the receiver's confirmation, holding custody until the next stage confirms receipt, and making every loss observable." ;
    skos:broader id:c-agent-methodology ; ho:conceptFacet "method" .
id:c-escalation a ho:Concept ;
    skos:prefLabel "Escalate open decisions" ;
    skos:altLabel "no arbitrary decisions" ;
    skos:definition "The principle of never resolving an undecided question alone but registering each open judgment as an issue and escalating it to the decision authority." ;
    skos:broader id:c-agent-methodology ; ho:conceptFacet "method" .
id:c-bounded-context a ho:Concept ;
    skos:prefLabel "Bounded context projection" ;
    skos:altLabel "anti-context-rot" ;
    skos:definition "The principle of never ingesting the whole knowledge store but retrieving only a request-scoped, budget-capped projection, keeping the working context bounded to defend against context rot." ;
    skos:broader id:c-agent-methodology ; ho:conceptFacet "method" .
id:c-graceful-fallback a ho:Concept ;
    skos:prefLabel "Graceful fallback" ;
    skos:altLabel "error fallback" ;
    skos:definition "The principle of anticipating failure per operation and degrading gracefully -- defining a fallback (retry, reduced-scope result or a flagged partial) for each foreseeable failure mode instead of aborting the whole run, and making any degradation explicit." ;
    skos:broader id:c-agent-methodology ; ho:conceptFacet "method" .
id:c-composition a ho:Concept ;
    skos:prefLabel "Harness composition" ;
    skos:altLabel "assembly from parts" ;
    skos:definition "The practice of assembling a harness from the knowledge graph's reusable typed parts (individuals described by the ontology) -- selecting a base template or pattern, binding required capabilities to providers and satisfying the harness shape -- rather than authoring one from scratch; tag components that encode the composition process." ;
    skos:broader id:c-agent-methodology ; ho:conceptFacet "method" .
id:c-reuse-first a ho:Concept ;
    skos:prefLabel "Reuse-first authoring" ;
    skos:altLabel "anti-orphan authoring discipline" ;
    skos:definition "The discipline of reusing an existing typed part before authoring a new one, and connecting any new part in the same change (a broader parent, a tag or a provider) so the graph never gains an orphan; tag components that enforce reuse-first, anti-drift, anti-orphan authoring." ;
    skos:broader id:c-agent-methodology ; ho:conceptFacet "method" .
id:c-skill-authoring a ho:Concept ;
    skos:prefLabel "Skill authoring" ;
    skos:altLabel "well-formed skill packaging" ;
    skos:definition "The principle of authoring and packaging an agent skill in well-formed shape -- a present description, the required section headings and no forbidden files -- so it is discoverable, invocable and contract-checkable; tag the capability and guardrail that govern how a skill is written." ;
    skos:broader id:c-agent-methodology ; ho:conceptFacet "method" .
id:c-acceptance-coverage a ho:Concept ;
    skos:prefLabel "Acceptance coverage" ;
    skos:altLabel "three-flow fixtures" ;
    skos:definition "The principle that behaviour fixtures must cover the normal flow, the flow resumed over existing input and the error flow rather than the happy path alone, so a run that merely completed is never mistaken for one that was accepted; tag the components that fix how much behaviour a harness must demonstrate before it counts as done." ;
    skos:broader id:c-agent-methodology ; ho:conceptFacet "method" .
id:c-lesson a ho:Concept ;
    skos:prefLabel "Lesson learning" ;
    skos:altLabel "trial-and-error learning" , "learning from mistakes" ;
    skos:definition "The principle of turning trial-and-error experience into retained, reusable knowledge: an attempt that failed or had to be corrected yields a lesson -- what was tried, why it failed, what to do instead -- which is stored durably, consulted before comparable work is attempted again, and promoted into a standing rule once it recurs, so a harness improves across runs instead of repeating its mistakes. Tag the components that govern how such experience is captured, reused and promoted, and the store it is retained in. Distinct from id:c-memory, which fixes the tier architecture knowledge is held in: this fixes WHICH experience is worth retaining and what is then done with it." ;
    skos:broader id:c-agent-methodology ; skos:related id:c-memory ; ho:conceptFacet "method" .

id:c-root-cause a ho:Concept ;
    skos:prefLabel "Root-cause resolution" ;
    skos:definition "The principle of resolving problems at their underlying cause rather than masking a symptom with a guard that leaves the fault in place." ;
    skos:broader id:c-design ; ho:conceptFacet "method" .
id:c-simplicity a ho:Concept ;
    skos:prefLabel "Simplicity" ;
    skos:altLabel "YAGNI" ;
    skos:definition "The principle of preferring the simplest form that works, removing branches rather than adding them and avoiding speculative generalization that nothing uses yet." ;
    skos:broader id:c-design ; ho:conceptFacet "method" .

id:c-report-over-prompt a ho:Concept ;
    skos:prefLabel "Report over prompt" ;
    skos:definition "The principle of writing status, decisions, questions and reports to durable channels rather than volatile chat, leaving only a one-line pointer to where each was written." ;
    skos:broader id:c-agent-methodology ; skos:related id:c-communication ;
    ho:conceptFacet "method" .
id:c-controlled-vocabulary a ho:Concept ;
    skos:prefLabel "Controlled vocabulary" ;
    skos:altLabel "anti-drift" ;
    skos:definition "The principle of reusing registered terms and established domain vocabulary rather than coining near-synonyms or private abbreviations, adding new terms to a single terminology source." ;
    skos:broader id:c-agent-methodology ; skos:related id:c-communication ;
    ho:conceptFacet "method" .
id:c-structured-output a ho:Concept ;
    skos:prefLabel "Structured output" ;
    skos:altLabel "deliverable template" ;
    skos:definition "The principle of emitting each deliverable in a consistent, agreed structured template so downstream roles and convergence gates can consume it mechanically rather than re-parsing free-form prose." ;
    skos:broader id:c-agent-methodology ; skos:related id:c-communication ;
    ho:conceptFacet "method" .

id:c-grounding a ho:Concept ;
    skos:prefLabel "Grounding" ;
    skos:definition "The principle of linking every derived artifact or claim to its originating decision, rationale or source rather than restating another document." ;
    skos:broader id:c-traceability ; ho:conceptFacet "quality" .
id:c-structural-coverage a ho:Concept ;
    skos:prefLabel "Structural coverage" ;
    skos:altLabel "source-fidelity reflection" ;
    skos:definition "The principle of exhaustively mapping every structural element of a source into the model, extending the schema for anything unrepresented rather than silently skipping it." ;
    skos:broader id:c-traceability ; ho:conceptFacet "quality" .

id:c-dispatch a ho:Concept ;
    skos:prefLabel "Dispatch-based execution" ;
    skos:altLabel "no standalone workers" ;
    skos:definition "The principle that worker agents act only when dispatched by the orchestrator and are never run standalone or invoked directly outside a dispatch." ;
    skos:broader id:c-multiagent ; ho:conceptFacet "method" .
id:c-online-agent a ho:Concept ;
    skos:prefLabel "Online standing agent" ;
    skos:altLabel "persistent-session role" , "addressed, not spawned" ;
    skos:definition "The principle that an agent holds an assigned role in a session that stays open across tasks and serves requests AS THEY ARRIVE over durable channels, instead of being spawned for one brief and reclaimed when it returns. The counterpart of id:c-dispatch, which governs the instant workers a dispatch summons: a standing agent is addressed over its channels rather than spawned per task, so it keeps session-spanning context and consumes work on its own cycle." ;
    skos:broader id:c-multiagent ; ho:conceptFacet "method" .
id:c-delegation a ho:Concept ;
    skos:prefLabel "Delegated orchestration" ;
    skos:altLabel "orchestrator does not work directly" ;
    skos:definition "The principle that the user-facing orchestrator does no substantive work directly but only plans and dispatches, with all execution flowing through the worker agents." ;
    skos:broader id:c-multiagent ; ho:conceptFacet "method" .
id:c-synthesis a ho:Concept ;
    skos:prefLabel "Synthesis" ;
    skos:altLabel "convergence gate" ;
    skos:definition "The principle of converging the separate deliverables of multiple worker roles into one coherent, cross-checked final result -- the terminal convergence step of a multi-agent workflow, distinct from mere verification in that it also compiles the integrated output." ;
    skos:broader id:c-multiagent ; ho:conceptFacet "method" .
id:c-scale-modes a ho:Concept ;
    skos:prefLabel "Scale execution modes" ;
    skos:altLabel "full/reduced/single modes" ;
    skos:definition "The principle of matching effort to request scope by scaling the active agent roles and workflow -- a full team for a broad request, a reduced subset for a narrow one, a single pass for a trivial one -- rather than always running the whole team." ;
    skos:broader id:c-multiagent ; ho:conceptFacet "method" .
id:c-execution-mode a ho:Concept ;
    skos:prefLabel "Execution mode" ;
    skos:altLabel "runtime coordination topology" ;
    skos:definition "The runtime topology a multi-agent harness coordinates in -- peer agent-teams, lightweight sub-agents, agents standing by in persistently open sessions, or a phase-varying hybrid -- an axis orthogonal to the architectural data-flow pattern; tags the ho:ExecutionMode individuals a harness selects from via ho:hasExecutionMode (and the DesignPatterns they superseded)." ;
    skos:broader id:c-multiagent ; ho:conceptFacet "anatomy" .
id:c-pattern-taxonomy a ho:Concept ;
    skos:prefLabel "Coordination pattern taxonomy" ;
    skos:altLabel "architectural multi-agent patterns" ;
    skos:definition "The catalogue of architectural multi-agent coordination patterns -- how work flows and is structured across agents (pipeline, fan-out/fan-in, expert pool, producer-reviewer, supervisor, hierarchical delegation) -- independent of the runtime execution mode; tag the DesignPatterns describing agent work-flow architecture." ;
    skos:broader id:c-multiagent ; ho:conceptFacet "anatomy" .
id:c-complexity-governance a ho:Concept ;
    skos:prefLabel "Complexity governance" ;
    skos:altLabel "orchestration complexity limits" ;
    skos:definition "The principle of bounding multi-agent orchestration complexity -- limiting delegation depth, forbidding nested teams, keeping a single active team, avoiding coordination bottlenecks and flattening hierarchy -- so a harness stays tractable and debuggable rather than sprawling; tag guardrails that cap structural complexity." ;
    skos:broader id:c-multiagent ; ho:conceptFacet "method" .
id:c-cross-validation a ho:Concept ;
    skos:prefLabel "Cross-validation" ;
    skos:altLabel "severity-triaged peer review" ;
    skos:definition "The principle that a deliverable is checked by a role other than the one that produced it and that each finding is graded by severity, only the top band forcing rework -- the review discipline that keeps a producer-reviewer loop convergent instead of letting every remark reopen the work. Distinct from synthesis, which merges the reviewed contributions into the final result." ;
    skos:broader id:c-multiagent ; ho:conceptFacet "method" .
id:c-deliverable-artifact a ho:Concept ;
    skos:prefLabel "Deliverable artifact" ;
    skos:altLabel "workspace artifact naming" ;
    skos:definition "The named file a role writes into the shared workspace as its unit of hand-off, together with the naming discipline (ordinal prefix, document type, extension) that makes production order readable and lets a consumer resolve exactly which artifact a producer wrote; tag the components that govern how hand-off artifacts are named and ordered." ;
    skos:broader id:c-multiagent ; ho:conceptFacet "anatomy" .
id:c-role-multiplicity a ho:Concept ;
    skos:prefLabel "Same-role concurrency" ;
    skos:altLabel "multiply-staffed role" , "several instances of one role" ;
    skos:definition "The situation of staffing SEVERAL concurrent agent instances of ONE role on a project, together with the discipline that keeps them from colliding: each instance claims its work item before starting and writes only inside its own disjoint scope, with the merge left to the ordinary fan-in and contradiction machinery (id:pat-fanout-fanin, id:fp-conflict-contradiction). Distinct from id:c-execution-mode, which fixes the runtime topology agents coordinate in: this is about how MANY instances of the same role run at once and how they stay out of each other's way; tag the guardrails and error rows that govern concurrent instances of one role." ;
    skos:broader id:c-multiagent ; ho:conceptFacet "anatomy" .

#===================== Human-oversight vocabulary (wave-H) =============
# The involvement positions of a human relative to an agent's action path
# (three narrower terms under id:c-autonomy -- FLAT, no intermediate parent:
# the backbone's layering decision landed as the ho:conceptFacet ATTRIBUTE, so
# a middle node would add depth and buy nothing), plus the three oversight-
# quality terms that say when a gate stops working (automation bias, rubber-
# stamping) and what working control requires (meaningful control). Each term
# has a tagging consumer in the same wave: the gates, budgets, probes and
# conduits of the HIL part family.
id:c-human-in-loop a ho:Concept ;
    skos:prefLabel "Human-in-the-loop" ;
    skos:altLabel "HITL" , "approval before action" ;
    skos:definition "The involvement position in which a human decision is on the action path: consequential actions wait for approval before they run, so the human is a gate the work must pass, not an observer. One of the three involvement positions under autonomy, alongside id:c-human-on-loop (supervising with override) and id:c-human-out-loop (unattended); tag the gates, channels and steps that put a human decision on the path." ;
    skos:broader id:c-autonomy ; ho:conceptFacet "quality" .
id:c-human-on-loop a ho:Concept ;
    skos:prefLabel "Human-on-the-loop" ;
    skos:altLabel "HOTL" , "supervisory override" ;
    skos:definition "The involvement position in which the agent acts without waiting while a human supervises and may override: actions proceed by default and the human's power is interruption, not admission. Sits between id:c-human-in-loop (approval before action) and id:c-human-out-loop (no human present); tag the budgets, monitors and override mechanisms that keep such supervision effective." ;
    skos:broader id:c-autonomy ; ho:conceptFacet "quality" .
id:c-human-out-loop a ho:Concept ;
    skos:prefLabel "Human-out-of-the-loop" ;
    skos:altLabel "HOOTL" , "unattended operation" ;
    skos:definition "The involvement position with no human on the action path or watching it: the run is unattended, so every bound -- stopping conditions, budgets, safe defaults -- must be carried by the harness itself. The third involvement position, after id:c-human-in-loop and id:c-human-on-loop; tag the self-termination and self-bounding components an unattended run depends on." ;
    skos:broader id:c-autonomy ; ho:conceptFacet "quality" .
id:c-automation-bias a ho:Concept ;
    skos:prefLabel "Automation bias" ;
    skos:definition "The tendency of a human reviewer to accept an automated system's output because it came from the system: confidence and fluency substitute for evidence, and the oversight a gate was meant to provide quietly erodes. Names the failure the evidence-backed-plan discipline defends against; tag components that counter misplaced trust in agent output." ;
    skos:broader id:c-oversight ; ho:conceptFacet "quality" .
id:c-rubber-stamping a ho:Concept ;
    skos:prefLabel "Rubber-stamping" ;
    skos:altLabel "approval-gate decay" ;
    skos:definition "The degraded state of an approval gate whose approvals no longer discriminate: the reviewer approves by habit, so the gate's pass says nothing about the work. The condition oversight-efficacy testing exists to detect -- a gate is only evidence while a bad input can still fail it; tag the probes and fixtures that measure whether a gate still discriminates. Commonly caused by id:c-automation-bias." ;
    skos:broader id:c-oversight ; skos:related id:c-automation-bias ; ho:conceptFacet "quality" .
id:c-meaningful-control a ho:Concept ;
    skos:prefLabel "Meaningful human control" ;
    skos:definition "The condition that human involvement actually controls the system rather than decorating it, resting on two requirements: the system tracks human reasons -- decisions respond to the considerations the human states, not merely to the click -- and every outcome traces to a human who can answer for it. Tag the components that make an oversight mechanism effective rather than nominal." ;
    skos:broader id:c-autonomy ; skos:related id:c-oversight , id:c-traceability ;
    ho:conceptFacet "quality" .

#===================== Operating-envelope attribute scheme =============
# The controlled vocabulary an ho:EnvelopeStatement declares over
# (ho:envelopeAttribute): five axes under one parent term, each axis holding
# the request-time judgable attributes of that facet. The five-axis split
# (domain / task / stakeholder / surface / asset) exists because a range
# narrowed to the subject area alone misses where envelope exits actually
# happen — in WHO asks, over WHICH surface, and WHAT is at stake. A
# protected-characteristics axis is DELIBERATELY EXCLUDED this wave: this
# store's harnesses operate on artifacts, not on decisions about persons, so
# the axis enters only with a source harness that judges persons (explicit
# out-of-model exclusion, per the coverage-audit convention).
id:c-operating-envelope a ho:Concept ;
    skos:prefLabel "Operating envelope" ;
    skos:altLabel "declared operating range" ;
    skos:definition "The declared, machine-readable range of requests and run states a harness undertakes to handle, judged attribute by attribute at request time; tag the envelope components, guardrails and error rows that declare, check or recover that range. Parent of the five envelope attribute axes (domain, task, stakeholder, surface, asset)." ;
    skos:topConceptOf id:scheme ; skos:related id:c-autonomy , id:c-safety ;
    ho:conceptFacet "anatomy" .

id:c-envelope-domain a ho:Concept ;
    skos:prefLabel "Envelope domain axis" ;
    skos:definition "The subject-area facet of an operating envelope: attributes about WHAT AREA a request falls in, judgable at request time. Refines — never duplicates — the coarse targeting the ho:Domain individuals (dom-*) give a harness via ho:targetsDomain: the Domain names what the harness is for, these attributes decide whether one concrete request is in that area." ;
    skos:broader id:c-operating-envelope ; ho:conceptFacet "anatomy" .
id:c-envelope-subject-matter a ho:Concept ;
    skos:prefLabel "Subject-matter fit" ;
    skos:definition "Whether the request's subject matter lies inside the harness's declared area of work, as opposed to a neighbouring area it superficially resembles." ;
    skos:broader id:c-envelope-domain ; ho:conceptFacet "anatomy" .
id:c-envelope-language-scope a ho:Concept ;
    skos:prefLabel "Language scope" ;
    skos:definition "The natural (and where relevant programming) languages a harness undertakes to work in — the languages of requests, prose and deliverables it declares itself for." ;
    skos:broader id:c-envelope-domain ; ho:conceptFacet "anatomy" .
id:c-envelope-environment-assumption a ho:Concept ;
    skos:prefLabel "Environment assumption" ;
    skos:definition "What the harness assumes about the environment it runs in — the workspace, toolchain or session shape that must be present for its declared range to hold." ;
    skos:broader id:c-envelope-domain ; ho:conceptFacet "anatomy" .
id:c-envelope-knowledge-recency a ho:Concept ;
    skos:prefLabel "Knowledge recency" ;
    skos:definition "Whether answering the request needs information newer than what the harness can know or retrieve — the freshness boundary of its declared range." ;
    skos:broader id:c-envelope-domain ; ho:conceptFacet "anatomy" .

id:c-envelope-task a ho:Concept ;
    skos:prefLabel "Envelope task axis" ;
    skos:definition "The work facet of an operating envelope: attributes about the REQUESTED WORK itself — its kind, size, reversibility and decidability. The centre axis of an agent harness's range (a taxonomy carried over from a domain-only tradition misses exactly this facet), refining the coarse ho:addressesTask targeting." ;
    skos:broader id:c-operating-envelope ; ho:conceptFacet "anatomy" .
id:c-envelope-task-kind a ho:Concept ;
    skos:prefLabel "Task kind" ;
    skos:definition "Whether the requested work maps to one of the kinds of task the harness declares itself for, rather than a neighbouring kind it was never composed to perform." ;
    skos:broader id:c-envelope-task ; ho:conceptFacet "anatomy" .
id:c-envelope-task-scale a ho:Concept ;
    skos:prefLabel "Task scale" ;
    skos:definition "The size and scope of the requested work relative to what the harness's process can carry — e.g. whether a request decomposes into units its workflow can actually dispatch and integrate." ;
    skos:broader id:c-envelope-task ; ho:conceptFacet "anatomy" .
id:c-envelope-reversibility a ho:Concept ;
    skos:prefLabel "Action reversibility" ;
    skos:definition "Whether the actions the request calls for can be undone, or are guarded by an explicit confirmation step where they cannot — the irreversibility boundary of the declared range." ;
    skos:broader id:c-envelope-task ; ho:conceptFacet "anatomy" .
id:c-envelope-completion-criterion a ho:Concept ;
    skos:prefLabel "Completion criterion" ;
    skos:definition "Whether 'done' is decidable for the request within the harness's own gates — a request whose success cannot be judged by any bound check lies outside a well-declared range." ;
    skos:broader id:c-envelope-task ; ho:conceptFacet "anatomy" .

id:c-envelope-stakeholder a ho:Concept ;
    skos:prefLabel "Envelope stakeholder axis" ;
    skos:definition "The people facet of an operating envelope: attributes about WHO requests the work, who holds approval authority over it, whom it affects, and whether a responsive human is reachable while it runs." ;
    skos:broader id:c-operating-envelope ; ho:conceptFacet "anatomy" .
id:c-envelope-requester a ho:Concept ;
    skos:prefLabel "Requester identity" ;
    skos:definition "Who may submit requests to the harness and over which declared entry point — the boundary that keeps a harness from serving arrivals it never declared itself open to." ;
    skos:broader id:c-envelope-stakeholder ; ho:conceptFacet "anatomy" .
id:c-envelope-approval-authority a ho:Concept ;
    skos:prefLabel "Approval authority" ;
    skos:definition "Who holds sign-off for the consequential actions a request entails — the authority the harness must be able to reach when its tier's approval unit demands one." ;
    skos:broader id:c-envelope-stakeholder ; ho:conceptFacet "anatomy" .
id:c-envelope-affected-party a ho:Concept ;
    skos:prefLabel "Affected party" ;
    skos:definition "Whose artifacts or interests the requested work touches — a request whose effects land on parties outside the declared set is out of range even when the work itself is familiar." ;
    skos:broader id:c-envelope-stakeholder ; ho:conceptFacet "anatomy" .
id:c-envelope-user-availability a ho:Concept ;
    skos:prefLabel "User availability" ;
    skos:definition "Whether a responsive human is reachable within the run — the standing precondition of any tier whose fallback owner is a receptive user, and an attribute that can silently lapse mid-run." ;
    skos:broader id:c-envelope-stakeholder ; ho:conceptFacet "anatomy" .

id:c-envelope-surface a ho:Concept ;
    skos:prefLabel "Envelope surface axis" ;
    skos:definition "The interface facet of an operating envelope: attributes about WHICH exposed surfaces the work moves over — the tools that may be driven, the paths that may be written, the channels requests arrive on and the reach beyond the workspace." ;
    skos:broader id:c-operating-envelope ; ho:conceptFacet "anatomy" .
id:c-envelope-tool-surface a ho:Concept ;
    skos:prefLabel "Tool surface" ;
    skos:definition "Which of the harness's bound tools the requested work may drive — a request that needs an operation no bound tool exposes lies outside the declared surface." ;
    skos:broader id:c-envelope-surface ; ho:conceptFacet "anatomy" .
id:c-envelope-write-scope a ho:Concept ;
    skos:prefLabel "Write scope" ;
    skos:definition "The paths and artifacts the harness undertakes to modify — the write boundary of its declared range, judged against the paths a request actually names." ;
    skos:broader id:c-envelope-surface ; ho:conceptFacet "anatomy" .
id:c-envelope-input-channel a ho:Concept ;
    skos:prefLabel "Input channel" ;
    skos:definition "Over which declared conduits work may arrive — requests reaching the harness outside its declared channels are out of range regardless of their content." ;
    skos:broader id:c-envelope-surface ; ho:conceptFacet "anatomy" .
id:c-envelope-external-access a ho:Concept ;
    skos:prefLabel "External access" ;
    skos:definition "Whether the requested work needs reach beyond the workspace — network, external services or systems — and whether that reach is part of the declared surface." ;
    skos:broader id:c-envelope-surface ; ho:conceptFacet "anatomy" .

id:c-envelope-asset a ho:Concept ;
    skos:prefLabel "Envelope asset axis" ;
    skos:definition "The stakes facet of an operating envelope: attributes about WHAT IS AT STAKE in the requested work — sensitive data, credentials, spend and standing — independent of whether the work itself is familiar." ;
    skos:broader id:c-operating-envelope ; ho:conceptFacet "anatomy" .
id:c-envelope-data-sensitivity a ho:Concept ;
    skos:prefLabel "Data sensitivity" ;
    skos:definition "Whether the request handles data whose exposure would be a harm in itself — secrets, personal or confidential material — and whether such handling is inside the declared range." ;
    skos:broader id:c-envelope-asset ; ho:conceptFacet "anatomy" .
id:c-envelope-credential-exposure a ho:Concept ;
    skos:prefLabel "Credential exposure" ;
    skos:definition "Whether the work can touch or reveal credentials and access tokens — an asset boundary that turns an ordinary edit into an out-of-range action." ;
    skos:broader id:c-envelope-asset ; ho:conceptFacet "anatomy" .
id:c-envelope-budget-exposure a ho:Concept ;
    skos:prefLabel "Budget exposure" ;
    skos:definition "How much compute, spend or quota the requested work can commit — the resource stake a declared range caps." ;
    skos:broader id:c-envelope-asset ; ho:conceptFacet "anatomy" .
id:c-envelope-reputation-exposure a ho:Concept ;
    skos:prefLabel "Reputation exposure" ;
    skos:definition "Whether outputs leave the workspace under the operator's name — published, sent or committed externally — putting standing at stake beyond the artifact itself." ;
    skos:broader id:c-envelope-asset ; ho:conceptFacet "anatomy" .

#===================== Guardrail attachment-point scheme ===============
# The controlled vocabulary ho:attachesAt points at: WHERE a guardrail is
# enforced. Deliberately FLAT (one parent, eight leaves, no intermediate
# grouping nodes — the layering decision landed as the ho:conceptFacet
# attribute, which adds no depth, so grouping nodes stay unnecessary): the
# pipeline-stage leaves (input/dialog/retrieval/
# pre-execution/post-execution/output) and the lifecycle-boundary leaves
# (session/turn) sit as siblings, cross-validated from two independent
# framework axes that meet at the tool-call boundary — its blocking/reacting
# sides ARE the pre-/post-execution leaves, so no tool-call leaf exists.
# The session and turn leaves gained their first occupants with wave-H
# (id:gr-safe-halt; id:gr-stopping-condition / id:gr-auto-reply-budget), and
# the post-execution leaf gained its first with wave-C
# (id:gr-aci-observation) -- every leaf now has at least one occupant.
id:c-guardrail-attachment a ho:Concept ;
    skos:prefLabel "Guardrail attachment point" ;
    skos:definition "The point at which a guardrail is enforced in an agent's processing pipeline or run lifecycle — the value vocabulary of ho:attachesAt. A flat set of sibling points: six pipeline stages (what arrives, the conversation, what is retrieved, just before and just after an external action, what is emitted) plus the session and turn boundaries. Locates WHERE a rule bites, never what it demands or who approves." ;
    skos:topConceptOf id:scheme ; ho:conceptFacet "anatomy" .
id:c-attach-input a ho:Concept ;
    skos:prefLabel "Input attachment point" ;
    skos:definition "Enforcement at request intake: the rule is applied to what arrives before the agent reasons over it — screening, refusing or reshaping the incoming request." ;
    skos:broader id:c-guardrail-attachment ; ho:conceptFacet "anatomy" .
id:c-attach-dialog a ho:Concept ;
    skos:prefLabel "Dialog attachment point" ;
    skos:definition "Enforcement inside the conversation: the rule governs how the agent converses, asks and decides between intake and action — before any external action runs or a final output is emitted." ;
    skos:broader id:c-guardrail-attachment ; ho:conceptFacet "anatomy" .
id:c-attach-retrieval a ho:Concept ;
    skos:prefLabel "Retrieval attachment point" ;
    skos:definition "Enforcement on retrieved material: the rule bounds what fetched content may enter the agent's working context, and how much of it." ;
    skos:broader id:c-guardrail-attachment ; ho:conceptFacet "anatomy" .
id:c-attach-execution-pre a ho:Concept ;
    skos:prefLabel "Pre-execution attachment point" ;
    skos:definition "Enforcement immediately before an external action runs: the rule inspects a pending tool call or side-effecting operation and may block or condition it — the blocking side of the tool-call boundary (its event-driven runtime counterpart is a pre-tool-use hook)." ;
    skos:broader id:c-guardrail-attachment ; ho:conceptFacet "anatomy" .
id:c-attach-execution-post a ho:Concept ;
    skos:prefLabel "Post-execution attachment point" ;
    skos:definition "Enforcement immediately after an external action completes: the rule is applied to the action's result before the agent builds on it — the reacting side of the tool-call boundary (runtime counterpart: a post-tool-use hook)." ;
    skos:broader id:c-guardrail-attachment ; ho:conceptFacet "anatomy" .
id:c-attach-output a ho:Concept ;
    skos:prefLabel "Output attachment point" ;
    skos:definition "Enforcement on what the agent is about to emit to the user or an external destination — the last point at which a rule can stop or reshape a result." ;
    skos:broader id:c-guardrail-attachment ; ho:conceptFacet "anatomy" .
id:c-attach-session a ho:Concept ;
    skos:prefLabel "Session-boundary attachment point" ;
    skos:definition "Enforcement at the opening or closing of a session — obligations that hold when a session starts (e.g. load standing context) or ends (e.g. persist or verify state), rather than at any mid-pipeline stage." ;
    skos:broader id:c-guardrail-attachment ; ho:conceptFacet "anatomy" .
id:c-attach-turn a ho:Concept ;
    skos:prefLabel "Turn-boundary attachment point" ;
    skos:definition "Enforcement at the boundary of an agent turn — when a submitted prompt starts a turn or when the turn finishes before yielding — between turns rather than inside the processing of one." ;
    skos:broader id:c-guardrail-attachment ; ho:conceptFacet "anatomy" .

#===================== Simulation stand-in (wave-S) ====================
# The common parent term of the simulation part family. DELIBERATELY a single
# top concept with NO intermediate layering (the facet decision landed as an
# attribute, so depth stays at zero): wave-A's further stand-in roles
# (adjudicator, wizard, task-specifier, npc) join as tagging consumers or flat
# narrower terms, never as a new middle layer. Tagging consumers in this wave:
# id:role-user-simulator, id:gr-oracle-leak, id:tool-env-interface.
id:c-simulation-standin a ho:Concept ;
    skos:prefLabel "Simulation stand-in" ;
    skos:altLabel "human or environment proxy" ;
    skos:definition "The family of components that stand in for a live counterpart during a simulated or evaluative run -- a role playing the human side from a hidden scenario, a mediated environment surface replacing the real world -- so a harness can be exercised, measured or rehearsed without the real human or environment being present. A stand-in PERFORMS the counterpart during the run; tag the roles, guardrails and tools that do so. Distinct from the fixture authoring of id:role-tester, which PRODUCES the acceptance material a run consumes rather than playing a side of it, and from id:c-acceptance-coverage, which fixes how much behaviour those fixtures must cover." ;
    skos:topConceptOf id:scheme ; ho:conceptFacet "anatomy" .

#===================== Concept scheme ==================================
id:scheme a skos:ConceptScheme ; skos:prefLabel "Harness ontology vocabulary" .
