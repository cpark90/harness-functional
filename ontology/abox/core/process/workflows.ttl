@prefix ho:    <https://harness-ontology.dev/schema#> .
@prefix id:    <https://harness-ontology.dev/id/core/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .

# Core data unit -- Workflow partition of the `core` domain. Imports the
# central TBox only; cross-unit references resolve in the root union
# (docs/federation-design.md D1, ONTOLOGYSTYLE 4).
<https://harness-ontology.dev/data/core/workflows> a owl:Ontology ;
    owl:imports <https://harness-ontology.dev/schema> .

#===================== Workflows =======================================
id:wf-react a ho:Workflow ; skos:prefLabel "ReAct loop" ;
    ho:dependsOn id:tool-shell ; ho:tokenEstimate 60 ; ho:maturity "stable" ; ho:tagged id:c-autonomy .
id:wf-planexec a ho:Workflow ; skos:prefLabel "Plan-execute loop" ;
    ho:dependsOn id:tool-retriever ; ho:tokenEstimate 65 ; ho:maturity "reviewed" .
id:wf-singleshot a ho:Workflow ; skos:prefLabel "Single-shot" ;
    ho:tokenEstimate 20 ; ho:maturity "stable" .
id:wf-multiagent a ho:Workflow ; skos:prefLabel "Multi-agent orchestration loop" ;
    skos:definition "Orchestrator plans and dispatches node-scoped briefs to worker agents that author, verify and inspect, then integrates and gates the results; separates authoring, judgment and application. Choose for work that must stay traceable across specialised roles." ;
    ho:hasStep id:wfs-plan-dispatch, id:wfs-author-verify, id:wfs-integrate-gate ;
    ho:providesCapability id:cap-orchestration ;
    ho:derivedFrom id:wf-planexec ;
    ho:tagged id:c-multiagent, id:c-design ; ho:tokenEstimate 74 ; ho:maturity "reviewed" .
id:wf-harness-evolution a ho:Workflow ; skos:prefLabel "Harness evolution loop" ;
    skos:definition "Keep an already-deployed harness correct as its subject drifts: audit the harness's current state against the source it reflects, route each piece of incoming feedback to the layer that actually owns it -- output quality to the skill or instruction, a missing responsibility to a role or agent, wrong sequencing to the orchestration, weak activation to the trigger description -- record the applied change, and capture what the round taught before it closes, so the next round starts from both a known state and the accumulated lessons. Choose when MAINTAINING an existing harness; choose id:wf-compose-harness instead when building a new one." ;
    ho:hasStep id:wfs-audit, id:wfs-feedback-route, id:wfs-change-log, id:wfs-lesson-capture ;
    ho:tagged id:c-agent-methodology ; ho:tokenEstimate 160 ; ho:maturity "draft" .
id:wf-verify-harness a ho:Workflow ; skos:prefLabel "Harness verification loop" ;
    skos:definition "Judge an assembled harness before it is trusted: check its structure against the spec, confirm that the requests which SHOULD activate it do and the near-misses which should NOT do not, compare behaviour with and without the component under test, and close with an end-to-end dry run on a representative request. Choose when accepting a newly composed or newly changed harness -- verification is a separate judgment pass, not something the authoring step declares about its own output." ;
    ho:hasStep id:wfs-structure-check, id:wfs-trigger-validation, id:wfs-baseline-compare, id:wfs-dryrun ;
    ho:tagged id:c-agent-methodology, id:c-verify-proceed ; ho:tokenEstimate 128 ; ho:maturity "draft" .
id:wf-compose-harness a ho:Workflow ; skos:prefLabel "Harness composition" ;
    skos:definition "Assemble a new harness from the knowledge graph's reusable, typed parts (individuals the ontology describes): analyse the user's intent and the project and question the user until the information gaps close, then retrieve a context pack, pick a base template, bind every required capability to a provider, satisfy the harness-shape minimums, write the parts back as connected individuals, validate, and pass the coverage-audit gate before materializing. Choose when building a harness by selecting and wiring existing parts rather than authoring one from scratch." ;
    ho:hasStep id:wfs-intent-analysis, id:wfs-retrieve-pack, id:wfs-select-template,
        id:wfs-bind-capabilities, id:wfs-assemble-minimums, id:wfs-write-individuals,
        id:wfs-validate, id:wfs-coverage-audit ;
    ho:tagged id:c-composition ; ho:tokenEstimate 141 ; ho:maturity "reviewed" .
# Wave-H HOST WORKFLOW, a deliberate discretionary addition beyond the wave's
# part inventory: the four human-gate steps below need a Workflow to reach the
# graph through (reachability of a WorkflowStep is the hasComponent o hasStep
# roll-up -- there is no other non-orphan wiring for a step), and none of the
# existing workflows honestly contains them. Bound to id:h-multiagent, whose
# feedback pipeline factually runs this loop: elicitation until gaps close,
# durable status-marker interrupts whose human status flip IS the resume value,
# a verified-lane review of outputs before application, and application only
# after explicit user approval.
id:wf-approval-gated a ho:Workflow ; skos:prefLabel "Approval-gated delivery loop" ;
    skos:definition "The human-gated shape of a delivery run: close the ambiguities in the request first, checkpoint and wait wherever a consequential action needs a human answer, hold the produced output at a review gate before it is delivered, and end with an explicit transfer of control back to the human. Choose when a harness's autonomy is bounded by human decision points rather than by machine gates alone -- the machine-gated counterpart of its review step is id:wf-multiagent's integrate-and-gate step." ;
    ho:hasStep id:wfs-clarification-round, id:wfs-interrupt-resume,
        id:wfs-output-review, id:wfs-control-transfer ;
    ho:tagged id:c-human-in-loop ; ho:tokenEstimate 122 ; ho:maturity "draft" .

#===================== Workflow steps ==================================
# Ordered decomposition of id:wf-multiagent's control flow into part-to-part
# assembly (Stage a of finer-harness-decomposition-assembly): each step names
# the role that performs it, the tool it uses and/or the guardrail that bounds
# it, reusing EXISTING core parts by IRI. The steps refine the workflow's prose
# definition (they do not replace it) and are rolled up to any binding harness
# via the ho:hasComponent (hasComponent o hasStep) propertyChainAxiom.
id:wfs-plan-dispatch a ho:WorkflowStep ;
    skos:prefLabel "Plan and dispatch" ;
    skos:definition "The orchestrator decomposes the request into node-scoped briefs and dispatches each to the worker best scoped for it, doing no authoring itself. Choose as the entry step of a multi-agent run: it fixes WHAT is delegated to WHOM before any work begins." ;
    ho:stepByRole id:role-orchestrator ;
    ho:stepGuardedBy id:gr-delegated-orchestration ;
    ho:stepProduces id:dlv-dispatch-brief ;
    ho:stepOrder 1 ; ho:tokenEstimate 40 ; ho:maturity "reviewed" .

id:wfs-author-verify a ho:WorkflowStep ;
    skos:prefLabel "Author and verify" ;
    skos:definition "Dispatched workers author their assigned nodes and a verifier judges the result, each within its least-privilege scope; authoring and judgment stay separated. Choose as the productive middle step where the briefed work is actually produced and checked." ;
    ho:stepByRole id:role-implementer ;
    ho:stepUsesTool id:tool-editor ;
    ho:stepConsumes id:dlv-dispatch-brief ;
    ho:stepProduces id:dlv-verified-result ;
    ho:stepDependsOn id:wfs-plan-dispatch ;
    ho:stepOrder 2 ; ho:tokenEstimate 42 ; ho:maturity "reviewed" .

id:wfs-integrate-gate a ho:WorkflowStep ;
    skos:prefLabel "Integrate and gate" ;
    skos:definition "The orchestrator integrates the returned work and runs the validation gate, proceeding only on a verified pass rather than assuming completion. Choose as the closing step that admits work into the shared artifact once, and only once, it checks out." ;
    ho:stepByRole id:role-orchestrator ;
    ho:stepGuardedBy id:gr-verify-proceed ;
    ho:stepConsumes id:dlv-verified-result ;
    ho:stepDependsOn id:wfs-author-verify ;
    ho:stepOrder 3 ; ho:tokenEstimate 40 ; ho:maturity "reviewed" .

# Ordered decomposition of the two meta-workflows above -- the lifecycle loop
# that evolves a harness and the judgment pass that verifies one. Same
# part-to-part convention as the steps of id:wf-multiagent: each step names the
# role that performs it, the tool it uses and/or the guardrail that bounds it,
# reusing EXISTING core parts by IRI, and is rolled up to any binding harness
# via the ho:hasComponent (hasComponent o hasStep) propertyChainAxiom.
id:wfs-audit a ho:WorkflowStep ;
    skos:prefLabel "Audit harness state" ;
    skos:definition "Enumerate the harness's current parts and compare them against the source it reflects and its recorded spec, naming drift and coverage gaps before anything is changed. Choose as the entry step of an evolution round: it establishes what is ACTUALLY there rather than what the last change assumed." ;
    ho:stepByRole id:role-inspection ;
    ho:stepGuardedBy id:gr-structural-coverage ;
    ho:stepOrder 1 ; ho:tokenEstimate 48 ; ho:maturity "draft" .

id:wfs-feedback-route a ho:WorkflowStep ;
    skos:prefLabel "Route feedback to its layer" ;
    skos:definition "Classify each piece of feedback by the layer that owns it -- output quality to the skill or instruction, a missing responsibility to a role or agent, wrong sequencing to the orchestration, weak activation to the trigger description -- and send the fix there. Choose to stop symptom-patching: routing to the owning layer is what makes a correction generalise instead of accumulating one-off exceptions." ;
    ho:stepByRole id:role-orchestrator ;
    ho:stepGuardedBy id:gr-generalize-not-overfit ;
    ho:stepDependsOn id:wfs-audit ;
    ho:stepOrder 2 ; ho:tokenEstimate 66 ; ho:maturity "draft" .

id:wfs-change-log a ho:WorkflowStep ;
    skos:prefLabel "Record the change" ;
    skos:definition "Write the applied change, its rationale and the audit finding it answers into the durable record, marking what it supersedes instead of overwriting it. Choose as the closing step so the next evolution round starts from a known, traceable state rather than re-deriving history." ;
    ho:stepByRole id:role-inspection ;
    ho:stepGuardedBy id:gr-traceability ;
    ho:stepDependsOn id:wfs-feedback-route ;
    ho:stepOrder 3 ; ho:tokenEstimate 50 ; ho:maturity "draft" .

# The closing step of the evolution loop, added after the change record: the
# round's EXPERIENCE, not just its state, is what the next round needs. It
# declares no ho:Deliverable because the other three steps of this workflow
# declare none either -- the task-DAG data-flow vocabulary is exercised on
# id:wf-multiagent and id:wf-compose-harness, and adding a lone Deliverable here
# would make this workflow's DAG half-specified rather than more explicit.
id:wfs-lesson-capture a ho:WorkflowStep ;
    skos:prefLabel "Capture the round's lessons" ;
    skos:definition "Draw out of the round's outcome the lessons worth keeping -- what was attempted, why it failed or had to be corrected, and the rule that replaces it -- write them into the durable store, and flag any lesson already drawn in an earlier round as a candidate for promotion into a standing part. Choose as the closing step: recording WHAT changed leaves the next round the state but not the experience, so without this the loop keeps re-deriving its own corrections." ;
    ho:stepByRole id:role-inspection ;
    ho:stepGuardedBy id:gr-lesson-capture ;
    ho:stepDependsOn id:wfs-change-log ;
    ho:stepOrder 4 ; ho:tokenEstimate 115 ; ho:maturity "draft" .

id:wfs-structure-check a ho:WorkflowStep ;
    skos:prefLabel "Check structure against spec" ;
    skos:definition "Run the structural gate over the assembled harness: every component typed, wired into the harness and present where the spec requires it, preferring connection checks over mere existence checks. Choose as the first verification step -- behavioural checks run on a structurally broken harness spend a run to learn nothing." ;
    ho:stepByRole id:role-vnv ;
    ho:stepUsesTool id:tool-shell ;
    ho:stepGuardedBy id:gr-integration-coherence ;
    ho:stepOrder 1 ; ho:tokenEstimate 55 ; ho:maturity "draft" .

id:wfs-trigger-validation a ho:WorkflowStep ;
    skos:prefLabel "Validate activation triggers" ;
    skos:definition "Exercise the requests that SHOULD activate the harness or skill together with near-miss requests that should NOT, and require both arms to come out right. Choose to separate a description that is too narrow (never fires) from one that is too broad (fires on everything) -- a check that only tests positive requests cannot tell the two apart." ;
    ho:stepByRole id:role-vnv ;
    ho:stepGuardedBy id:gr-well-formed-skill ;
    ho:stepDependsOn id:wfs-structure-check ;
    ho:stepOrder 2 ; ho:tokenEstimate 60 ; ho:maturity "draft" .

id:wfs-baseline-compare a ho:WorkflowStep ;
    skos:prefLabel "Compare against baseline" ;
    skos:definition "Run the same representative requests with and without the component under test and keep only the assertions that separate the two arms. Choose to prove the component actually changes behaviour: an assertion that passes in both arms says nothing about it." ;
    ho:stepByRole id:role-vnv ;
    ho:stepGuardedBy id:gr-discriminating-eval ;
    ho:stepDependsOn id:wfs-trigger-validation ;
    ho:stepOrder 3 ; ho:tokenEstimate 52 ; ho:maturity "draft" .

id:wfs-dryrun a ho:WorkflowStep ;
    skos:prefLabel "Dry-run end to end" ;
    skos:definition "Execute the assembled harness end to end on a representative request and observe the whole run rather than inferring behaviour from its parts. Choose as the closing verification step: it is the only one that exercises the whole, and its observed outcome -- not elapsed effort -- is what admits the harness." ;
    ho:stepByRole id:role-vnv ;
    ho:stepUsesTool id:tool-shell ;
    ho:stepGuardedBy id:gr-verify-proceed ;
    ho:stepDependsOn id:wfs-baseline-compare ;
    ho:stepOrder 4 ; ho:tokenEstimate 56 ; ho:maturity "draft" .

# Ordered decomposition of id:wf-compose-harness's control flow into part-to-part
# assembly: the eight-stage pipeline that composes a harness from reusable parts,
# each step named for the role that performs it, the tool it uses and/or the
# guardrail that bounds it (reusing EXISTING core parts by IRI) and joined by the
# task-DAG Deliverables below. Same convention as id:wf-multiagent's steps; the
# steps refine the workflow's prose summary and roll up to any binding harness via
# the ho:hasComponent (hasComponent o hasStep) propertyChainAxiom.
# The pipeline now OPENS with intent analysis rather than with retrieval: what is
# retrieved, and how each agent lane is activated, are both scoped by what the
# user actually wants, so the request is analysed -- and what the analysis lacks
# is asked back -- before the first retrieval runs. That makes the data flow
# non-linear at one point: id:dlv-intent-profile is consumed BOTH by the retrieval
# step that follows it and, again, by the assembly step, which settles the
# activation mode from it (id:gr-mode-fit). Only ho:stepConsumes is doubled there;
# no second ho:stepDependsOn is added, because the ordering it would assert is
# already implied transitively by the linear dependency chain -- the consume edge
# carries information the chain does not.
id:wfs-intent-analysis a ho:WorkflowStep ;
    skos:prefLabel "Analyse intent and elicit gaps" ;
    skos:definition "Analyse the user's intent and the project the harness will run in before any retrieval or construction, and close the information gaps that analysis exposes by questioning the user rather than assuming the answers. Choose as the entry step: everything downstream -- what is retrieved, which template is taken, how each agent lane is activated -- is scoped by this profile, so an unasked question here becomes an assumption baked into the whole composition." ;
    ho:stepByRole id:role-orchestrator ;
    ho:stepGuardedBy id:gr-user-elicitation ;
    ho:stepProduces id:dlv-intent-profile ;
    ho:stepOrder 1 ; ho:tokenEstimate 114 ; ho:maturity "draft" .

id:wfs-retrieve-pack a ho:WorkflowStep ;
    skos:prefLabel "Retrieve a context pack" ;
    skos:definition "Run the retrieval tool over the analysed request to draw a budget-capped context pack of candidate parts, rather than loading the whole library. Choose as the first retrieval step, once the intent profile has scoped what to look for: it bounds what the rest of the composition may see, which is the context-rot defense." ;
    ho:stepByRole id:role-orchestrator ;
    ho:stepUsesTool id:tool-retriever ;
    ho:stepConsumes id:dlv-intent-profile ;
    ho:stepProduces id:dlv-context-pack ;
    ho:stepDependsOn id:wfs-intent-analysis ;
    ho:stepOrder 2 ; ho:tokenEstimate 80 ; ho:maturity "draft" .

id:wfs-select-template a ho:WorkflowStep ;
    skos:prefLabel "Select a base template" ;
    skos:definition "Take the top base-harness candidate from the pack as the template to derive from, or a DesignPattern when none fits closely enough. Choose to start from an existing, proven skeleton instead of an empty one, so the new harness inherits a known-good shape." ;
    ho:stepByRole id:role-orchestrator ;
    ho:stepConsumes id:dlv-context-pack ;
    ho:stepProduces id:dlv-base-template ;
    ho:stepDependsOn id:wfs-retrieve-pack ;
    ho:stepOrder 3 ; ho:tokenEstimate 42 ; ho:maturity "draft" .

id:wfs-bind-capabilities a ho:WorkflowStep ;
    skos:prefLabel "Bind required capabilities" ;
    skos:definition "For every capability the harness requires in scope, bind a component that provides it, filling each gap by reusing an existing part before authoring a new one. Choose to make the harness buildable: an unbound requirement is a hole the shape gate later rejects." ;
    ho:stepByRole id:role-orchestrator ;
    ho:stepGuardedBy id:gr-reuse-first ;
    ho:stepConsumes id:dlv-base-template ;
    ho:stepProduces id:dlv-capability-bindings ;
    ho:stepDependsOn id:wfs-select-template ;
    ho:stepOrder 4 ; ho:tokenEstimate 42 ; ho:maturity "draft" .

id:wfs-assemble-minimums a ho:WorkflowStep ;
    skos:prefLabel "Assemble the shape minimums" ;
    skos:definition "Wire the bound parts into the harness-shape minimums -- one system prompt, at least one workflow, tools, guardrails and one model config -- as a single coherent assembly, and settle how each agent lane is activated (dispatched per brief or standing in an open session) from the intent profile rather than by default. Choose to turn a loose set of chosen parts into a well-typed harness spec that satisfies the structural contract." ;
    ho:stepByRole id:role-orchestrator ;
    ho:stepGuardedBy id:gr-integration-coherence, id:gr-mode-fit ;
    ho:stepConsumes id:dlv-capability-bindings, id:dlv-intent-profile ;
    ho:stepProduces id:dlv-harness-spec ;
    ho:stepDependsOn id:wfs-bind-capabilities ;
    ho:stepOrder 5 ; ho:tokenEstimate 108 ; ho:maturity "draft" .

id:wfs-write-individuals a ho:WorkflowStep ;
    skos:prefLabel "Write back new individuals" ;
    skos:definition "Author the assembled parts back into the store as new typed individuals, each carrying a prefLabel, draft maturity, a derivedFrom link to the template, a token estimate on any text, and existing Concept tags. Choose to persist the composition using only the shared vocabulary, so nothing is orphaned or drifts into a near-synonym." ;
    ho:stepByRole id:role-implementer ;
    ho:stepUsesTool id:tool-editor ;
    ho:stepGuardedBy id:gr-controlled-vocabulary ;
    ho:stepConsumes id:dlv-harness-spec ;
    ho:stepProduces id:dlv-authored-individuals ;
    ho:stepDependsOn id:wfs-assemble-minimums ;
    ho:stepOrder 6 ; ho:tokenEstimate 51 ; ho:maturity "draft" .

id:wfs-validate a ho:WorkflowStep ;
    skos:prefLabel "Validate the assembly" ;
    skos:definition "Run the validation tool over the written individuals and require a full pass -- connectivity, typing and capability satisfaction -- before proceeding rather than assuming completion. Choose as the machine gate that admits the spec only once it checks out." ;
    ho:stepByRole id:role-vnv ;
    ho:stepUsesTool id:tool-shell ;
    ho:stepGuardedBy id:gr-verify-proceed ;
    ho:stepConsumes id:dlv-authored-individuals ;
    ho:stepProduces id:dlv-validated-spec ;
    ho:stepDependsOn id:wfs-write-individuals ;
    ho:stepOrder 7 ; ho:tokenEstimate 39 ; ho:maturity "draft" .

id:wfs-coverage-audit a ho:WorkflowStep ;
    skos:prefLabel "Audit source coverage" ;
    skos:definition "Enumerate every structural element of the source and confirm each maps to a representation or has an explicit, accepted reason to stay outside the model, treating an unmapped harness-structural element as a gap to fill. Choose as the closing fidelity gate: a green validator proves the graph is coherent, not that it faithfully reflects its source." ;
    ho:stepByRole id:role-vnv ;
    ho:stepGuardedBy id:gr-structural-coverage ;
    ho:stepConsumes id:dlv-validated-spec ;
    ho:stepDependsOn id:wfs-validate ;
    ho:stepOrder 8 ; ho:tokenEstimate 53 ; ho:maturity "draft" .

# Ordered decomposition of id:wf-approval-gated's control flow -- the four
# steps of the human-gated delivery loop, same part-to-part convention as the
# steps above (role that performs, guardrail that bounds, reusing EXISTING
# core parts by IRI; rolled up to the binding harness via the hasComponent o
# hasStep propertyChainAxiom). Like id:wf-harness-evolution's steps they
# declare no ho:Deliverable: adding a lone Deliverable here would leave this
# workflow's DAG half-specified rather than more explicit -- the task-DAG
# vocabulary stays exercised on id:wf-multiagent and id:wf-compose-harness.
id:wfs-clarification-round a ho:WorkflowStep ;
    skos:prefLabel "Close ambiguity markers to zero" ;
    skos:definition "Iterate targeted clarification against the work item until its explicit ambiguity markers reach zero: each round puts the open points to the human, folds the answers in, and re-marks what is still undetermined -- the exit criterion is the marker count, not a feeling of readiness. Choose as the entry step of an approval-gated run. Distinguished from id:wfs-intent-analysis, which profiles intent and project once before a composition begins: this is a bounded loop on a drafted artifact with a machine-checkable exit." ;
    ho:stepByRole id:role-orchestrator ;
    ho:stepGuardedBy id:gr-user-elicitation ;
    ho:stepOrder 1 ; ho:tokenEstimate 129 ; ho:maturity "draft" .

id:wfs-interrupt-resume a ho:WorkflowStep ;
    skos:prefLabel "Interrupt, checkpoint and resume" ;
    skos:definition "Where the run needs a human answer, interrupt rather than poll: checkpoint the run state under a correlation identifier, issue the request carrying that identifier, and stop consuming resources; the human's response arrives as the return value of the interrupted step, which resumes from the checkpoint however much later. Choose for any gate whose approver is not synchronously present -- the side effects before the interruption point must be idempotent (id:gr-resume-idempotency), because resuming re-runs the interrupted unit." ;
    ho:stepByRole id:role-orchestrator ;
    ho:stepGuardedBy id:gr-resume-idempotency ;
    ho:stepDependsOn id:wfs-clarification-round ;
    ho:stepOrder 2 ; ho:tokenEstimate 132 ; ho:maturity "draft" .

id:wfs-output-review a ho:WorkflowStep ;
    skos:prefLabel "Review output before delivery" ;
    skos:definition "Hold the produced output at a human review gate after it exists and before it is delivered or applied: the reviewer sees the actual artifact, approves it onward, or rejects it with reasons that seed the rework. Choose as the delivery gate of an approval-gated run. Distinguished from id:wfs-integrate-gate, whose gate is the machine validation pass: this gate is a human judgment on the finished output, covering what no automated check asserts." ;
    ho:stepByRole id:role-orchestrator ;
    ho:stepGuardedBy id:gr-rejection-feedback ;
    ho:stepDependsOn id:wfs-interrupt-resume ;
    ho:stepOrder 3 ; ho:tokenEstimate 111 ; ho:maturity "draft" .

id:wfs-control-transfer a ho:WorkflowStep ;
    skos:prefLabel "Transfer control explicitly" ;
    skos:definition "End the run by transferring control explicitly rather than letting it lapse: state what was done, what remains open and what the human now holds, and hand authority over at a checkpointed, safe state -- the same explicit step whichever direction control moves, human taking over from agent or agent resuming from human. Choose so that at every moment exactly one party knowingly holds control: an implicit hand-over is how work is dropped between the two." ;
    ho:stepByRole id:role-orchestrator ;
    ho:stepGuardedBy id:gr-safe-halt ;
    ho:stepDependsOn id:wfs-output-review ;
    ho:stepOrder 4 ; ho:tokenEstimate 113 ; ho:maturity "draft" .

#===================== Deliverables (task-DAG data flow) ===============
# The named artifacts that flow between id:wf-multiagent's steps — the OUTPUT
# side of one step joined to the INPUT side of the next (GAP-1 of the harness-100
# augmentation). They exercise the task-DAG vocabulary (ho:stepProduces /
# ho:stepConsumes / ho:stepDependsOn) minimally and neutrally: each Deliverable
# is produced by one step and consumed by the next, so the data-flow DAG is
# recoverable by joining producers to consumers. Each is rolled up to any binding
# harness via the ho:hasComponent (hasComponent o hasStep o stepProduces)
# propertyChainAxiom, so it is a connected, orphan-free component. Neutral: these
# name generic coordination artifacts, no domain content.
id:dlv-dispatch-brief a ho:Deliverable ;
    skos:prefLabel "Dispatch brief" ;
    skos:definition "The node-scoped brief the orchestrator produces when planning a request and hands to the worker it dispatches: WHAT is delegated to WHOM, self-contained enough that a cold-start worker can act on it alone. Produced by the plan-and-dispatch step and consumed by the author-and-verify step." ;
    ho:tagged id:c-multiagent, id:c-dispatch ; ho:tokenEstimate 44 ; ho:maturity "reviewed" .

id:dlv-verified-result a ho:Deliverable ;
    skos:prefLabel "Verified result" ;
    skos:definition "The authored work together with the verifier's pass judgment, emitted once authoring and verification are complete: the artifact that is admitted into the shared output only after it checks out. Produced by the author-and-verify step and consumed by the integrate-and-gate step." ;
    ho:tagged id:c-multiagent, id:c-verify-proceed ; ho:tokenEstimate 40 ; ho:maturity "reviewed" .

# The named artifacts that flow between id:wf-compose-harness's eight steps —
# each produced by one step and consumed by the next, so the composition
# data-flow DAG is recoverable by joining producers to consumers. Domain-neutral
# coordination artifacts; each rolls up to any binding harness via the
# ho:hasComponent (hasComponent o hasStep o stepProduces) propertyChainAxiom.
id:dlv-intent-profile a ho:Deliverable ;
    skos:prefLabel "Intent profile" ;
    skos:definition "The analysed intent-and-project profile: the user's goal, the characteristics of the project the harness will run in, and the answers elicited for whatever that analysis was missing. It scopes what the retrieval looks for downstream and which activation mode each agent lane is given. Produced by the intent-analysis step and consumed twice: by the retrieve step, which draws its pack against it, and again by the assembly step, which settles the activation mode from it." ;
    ho:tagged id:c-composition ; ho:tokenEstimate 118 ; ho:maturity "draft" .

id:dlv-context-pack a ho:Deliverable ;
    skos:prefLabel "Context pack" ;
    skos:definition "The budget-capped set of candidate parts retrieved for a request -- the bounded working set the rest of a composition draws from instead of the whole library. Produced by the retrieve step and consumed by the template-selection step." ;
    ho:tagged id:c-composition ; ho:tokenEstimate 36 ; ho:maturity "draft" .

id:dlv-base-template a ho:Deliverable ;
    skos:prefLabel "Base template" ;
    skos:definition "The base-harness candidate or DesignPattern chosen as the skeleton the new harness derives from. Produced by the template-selection step and consumed by the capability-binding step." ;
    ho:tagged id:c-composition ; ho:tokenEstimate 24 ; ho:maturity "draft" .

id:dlv-capability-bindings a ho:Deliverable ;
    skos:prefLabel "Capability bindings" ;
    skos:definition "The mapping from each required capability in scope to the component chosen to provide it, with gaps resolved by reuse or new authoring. Produced by the capability-binding step and consumed by the assembly step." ;
    ho:tagged id:c-composition ; ho:tokenEstimate 32 ; ho:maturity "draft" .

id:dlv-harness-spec a ho:Deliverable ;
    skos:prefLabel "Harness spec" ;
    skos:definition "The assembled harness with its shape minimums satisfied and parts wired together -- a well-typed specification not yet written back to the store. Produced by the assembly step and consumed by the write-back step." ;
    ho:tagged id:c-composition ; ho:tokenEstimate 32 ; ho:maturity "draft" .

id:dlv-authored-individuals a ho:Deliverable ;
    skos:prefLabel "Authored individuals" ;
    skos:definition "The new typed individuals written back to the store for the harness, each tagged, estimated and connected to the graph. Produced by the write-back step and consumed by the validation step." ;
    ho:tagged id:c-composition ; ho:tokenEstimate 30 ; ho:maturity "draft" .

id:dlv-validated-spec a ho:Deliverable ;
    skos:prefLabel "Validated spec" ;
    skos:definition "The written harness spec after the validation gate has passed over it -- connected, well-typed and capability-satisfying. Produced by the validation step and consumed by the coverage-audit step." ;
    ho:tagged id:c-composition ; ho:tokenEstimate 27 ; ho:maturity "draft" .
