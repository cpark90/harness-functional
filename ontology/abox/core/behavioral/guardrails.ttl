@prefix ho:    <https://harness-ontology.dev/schema#> .
@prefix id:    <https://harness-ontology.dev/id/core/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:   <http://purl.org/dc/terms/> .

# Core data unit -- Guardrail partition of the `core` domain. Imports the
# central TBox only; cross-unit references resolve in the root union
# (docs/federation-design.md D1, ONTOLOGYSTYLE 4).
<https://harness-ontology.dev/data/core/guardrails> a owl:Ontology ;
    owl:imports <https://harness-ontology.dev/schema> .

#===================== Guardrails ======================================
id:gr-nodestruct a ho:Guardrail ; skos:prefLabel "No destructive actions" ;
    ho:promptText "Never run irreversible or destructive commands without explicit confirmation." ;
    ho:tokenEstimate 30 ; ho:maturity "stable" ; ho:tagged id:c-safety .
id:gr-cite a ho:Guardrail ; skos:prefLabel "Cite sources" ; skos:altLabel "no fabrication" ;
    ho:promptText "Every factual claim must carry a citation to a retrieved source." ;
    ho:providesCapability id:cap-citation ; ho:tokenEstimate 25 ; ho:maturity "stable" ; ho:tagged id:c-safety .
id:gr-lang a ho:Guardrail ; skos:prefLabel "Korean/English only" ; skos:altLabel "language policy" ;
    ho:languageCondition "Prose (documentation, comments, harness .md): Korean" ,
        "Technical terms, including in answers: English" ,
        "Code, identifiers, commit messages: English" ;
    ho:promptText "Use only Korean and English, unless another language is essential to the task or the user explicitly requests it: write prose (documentation, comments, harness .md) in Korean but keep technical terms in English; write code, identifiers and commit messages in English." ;
    ho:tokenEstimate 67 ; ho:maturity "draft" ; ho:tagged id:c-communication .
# The TERM-CHOICE half of the language policy above: id:gr-lang fixes WHICH
# languages may be used, this one fixes WHICH WORDS inside them -- the field's
# established term rather than a private coinage -- and carries the same
# "unless the user explicitly asks for it" exception. Deliberately NOT merged
# into id:gr-lang (one Guardrail = one policy: a harness can want standard
# terminology without the Korean/English restriction, and vice versa), and kept
# apart from id:gr-controlled-vocabulary, which is the AUTHORING rule for the
# knowledge store itself (reuse registered classes, properties and concept tags
# instead of minting near-synonym nodes). Different layers: nodes there,
# wording here; the closing clause of promptText carries that disambiguation.
id:gr-standard-terms a ho:Guardrail ; skos:prefLabel "Standard terminology only" ;
    skos:altLabel "no custom coinage" , "no invented terms" ;
    ho:promptText "Use the established standard term for a concept -- the field's accepted Korean or English term -- in prose, outputs, naming and identifiers, and do not coin custom terms, ad-hoc abbreviations or invented project-specific names unless the user explicitly requests them; where a standard term already exists, prefer it over a bespoke synonym. Distinct from id:gr-controlled-vocabulary, which governs authoring INSIDE the knowledge store (reuse the registered classes, properties and concept tags instead of minting near-synonym nodes): this rule governs the WORDING chosen in what the harness writes and names." ;
    ho:tagged id:c-communication ; ho:tokenEstimate 152 ; ho:maturity "draft" .
id:gr-verify-proceed a ho:Guardrail ; skos:prefLabel "Verify then proceed" ; skos:altLabel "no time assumptions" ;
    ho:promptText "Never assume readiness from elapsed time; advance only on confirmed state (received response, ACK, verified flag). Timeouts are give-up bounds, not correctness premises." ;
    ho:tagged id:c-verify-proceed ; ho:tokenEstimate 38 ; ho:maturity "reviewed" .
id:gr-design-for-loss a ho:Guardrail ; skos:prefLabel "Design for loss" ;
    ho:promptText "Treat message and data loss as a normal event, not an exception: judge completion by the final receiver's confirmation, hold custody until the next stage confirms receipt, report cumulative absolute state rather than deltas, and make every loss observable via counters." ;
    ho:tagged id:c-design-for-loss ; ho:tokenEstimate 55 ; ho:maturity "reviewed" .
id:gr-traceability a ho:Guardrail ; skos:prefLabel "Traceable single source of truth" ;
    ho:promptText "Single source of truth with full traceability: never delete a decision or record -- mark it deprecated with a reason and a replacement link, and only ever increment identifiers, never reuse them." ;
    ho:providesCapability id:cap-traceability ;
    ho:tagged id:c-traceability ; ho:tokenEstimate 42 ; ho:maturity "reviewed" .
id:gr-grounding a ho:Guardrail ; skos:prefLabel "Ground every artifact" ; skos:altLabel "link artifact to rationale" ;
    ho:promptText "Link every derived artifact to its grounding decision or rationale; do not restate another document, reference its single source. Describe an interface identically on both sides and let the requirement win on conflict." ;
    ho:tagged id:c-grounding ; ho:tokenEstimate 42 ; ho:maturity "reviewed" .
id:gr-structural-coverage a ho:Guardrail ; skos:prefLabel "Structural coverage completeness" ; skos:altLabel "source-fidelity reflection" ;
    ho:promptText "When reflecting a system into the model, exhaustively enumerate the source's structural elements and map each to a representation; an element with no existing vocabulary is a signal to EXTEND the schema, never to silently skip it; verify coverage against the source before declaring the reflection done." ;
    ho:tagged id:c-structural-coverage ; ho:tokenEstimate 58 ; ho:maturity "reviewed" .
id:gr-no-arbitrary-decision a ho:Guardrail ; skos:prefLabel "No arbitrary decisions" ;
    ho:promptText "Do not resolve an undecided question on your own; register each open judgment as an issue and escalate it to the decision authority." ;
    ho:tagged id:c-escalation ; ho:tokenEstimate 32 ; ho:maturity "reviewed" .
id:gr-least-privilege a ho:Guardrail ; skos:prefLabel "Least-privilege role boundaries" ;
    ho:promptText "Each role edits only the files inside its own responsibility boundary and holds the minimum permissions for its task; authoring, judgment, application and version control stay in separate hands." ;
    ho:tagged id:c-least-privilege ; ho:tokenEstimate 40 ; ho:maturity "reviewed" .
id:gr-report-over-prompt a ho:Guardrail ; skos:prefLabel "Report over prompt" ;
    ho:promptText "Write status, decisions, questions and reports to durable channels rather than volatile chat, and leave only a one-line pointer to where each was written." ;
    ho:tagged id:c-report-over-prompt ; ho:tokenEstimate 36 ; ho:maturity "reviewed" .
id:gr-controlled-vocabulary a ho:Guardrail ; skos:prefLabel "Controlled vocabulary" ; skos:altLabel "anti-drift" ;
    ho:promptText "Reuse the registered vocabulary and established domain terms; do not coin near-synonyms or private abbreviations. New terms are added to the single terminology source, not improvised." ;
    ho:tagged id:c-controlled-vocabulary ; ho:tokenEstimate 40 ; ho:maturity "reviewed" .
id:gr-root-cause a ho:Guardrail ; skos:prefLabel "Fix root cause" ;
    ho:promptText "Resolve problems at their root cause; do not mask a symptom with a guard that leaves the underlying fault in place." ;
    ho:tagged id:c-root-cause ; ho:tokenEstimate 28 ; ho:maturity "reviewed" .
id:gr-simplicity a ho:Guardrail ; skos:prefLabel "Prefer the simplest working form" ; skos:altLabel "YAGNI" ;
    ho:promptText "Prefer the simplest form that works; remove branches rather than add them, and do not build speculative configuration, callbacks or generalization that nothing uses yet." ;
    ho:tagged id:c-simplicity ; ho:tokenEstimate 38 ; ho:maturity "reviewed" .
id:gr-bounded-context a ho:Guardrail ; skos:prefLabel "Bounded context projection" ; skos:altLabel "anti-context-rot" ;
    ho:promptText "Never ingest the whole knowledge store into context; retrieve only a request-scoped, budget-capped projection and keep the working context bounded to defend against context rot." ;
    ho:tagged id:c-bounded-context ; ho:tokenEstimate 40 ; ho:maturity "reviewed" .
id:gr-dispatch-execution a ho:Guardrail ; skos:prefLabel "Dispatch-based execution" ; skos:altLabel "no standalone workers" ;
    ho:promptText "Worker agents perform their assigned work only when dispatched by the orchestrator; they are not run standalone or invoked directly outside a dispatch." ;
    ho:tagged id:c-dispatch ; ho:tokenEstimate 34 ; ho:maturity "reviewed" .
id:gr-online-execution a ho:Guardrail ; skos:prefLabel "Online standing execution" ; skos:altLabel "session-resident role" , "addressed, not spawned" ;
    ho:promptText "An online agent runs its assigned role in a persistently open session and serves the requests that arrive over its declared channels, in arrival order and on its own scanning cycle; it consumes a channel item only once that item carries its completed status marker, and it leaves dispatch-scoped work to the workers a dispatch summons. Counterpart of id:gr-dispatch-execution, which governs those dispatched workers: a standing agent is addressed over its channels, never spawned per brief." ;
    ho:tagged id:c-online-agent ; ho:tokenEstimate 100 ; ho:maturity "draft" .
# The SELECTION rule of the activation axis whose two positions are the pair
# above (dispatched instant worker / online standing agent): which position a
# given agent lane takes is a decision to be made per project, not a default.
# Kept apart from id:gr-scale-modes, which sizes the effort a request gets
# (full team / reduced subset / single pass) -- that is HOW MUCH, this is HOW an
# agent is activated at all; the closing clause of promptText carries the
# disambiguation.
id:gr-mode-fit a ho:Guardrail ; skos:prefLabel "Fit the activation mode to intent and project" ;
    skos:altLabel "choose dispatch or online per project" , "no default activation mode" ;
    ho:promptText "Decide how each agent lane is ACTIVATED from the user's intent and the project's own characteristics -- how requests arrive and at what cadence, how much continuity across requests the work needs, and how much coordination latency is tolerable -- choosing between a worker spawned for one brief and reclaimed when it returns, and a standing agent whose session stays open and serves requests as they arrive. Never settle that choice by default or by habit, and state which characteristic decided it. Distinct from id:gr-scale-modes, which sizes HOW MUCH of the team a request activates: this selects the activation mode itself." ;
    ho:tagged id:c-execution-mode ; ho:tokenEstimate 157 ; ho:maturity "draft" .
id:gr-delegated-orchestration a ho:Guardrail ; skos:prefLabel "Delegated-only orchestration" ; skos:altLabel "orchestrator does not work directly" ;
    ho:promptText "The user-facing orchestrator performs no substantive work directly -- no authoring, judgment or tool execution; it only plans and dispatches, and all such work is carried out through the worker agents." ;
    ho:tagged id:c-delegation ; ho:tokenEstimate 42 ; ho:maturity "reviewed" .
id:gr-execution-separation a ho:Guardrail ; skos:prefLabel "Separated plan and execution" ; skos:altLabel "plan/status role does not execute" ;
    ho:promptText "An agent that plans work or checks/verifies its status does not itself perform the execution; execution is always carried out by a distinct, separately-spawned execution agent -- in every coordination topology, orchestrator-workers and agent-teams alike." ;
    ho:tagged id:c-multiagent ; ho:tokenEstimate 50 ; ho:maturity "draft" .
id:gr-reuse-first a ho:Guardrail ; skos:prefLabel "Reuse-first composition" ; skos:altLabel "anti-orphan authoring" ;
    ho:promptText "Compose by REUSING existing typed parts first; author a new part only when none fits, and in the same change connect it (a broader parent / a tag / a provider) so it is never an orphan -- this is the anti-drift, anti-orphan discipline of composition." ;
    ho:tagged id:c-reuse-first ; ho:tokenEstimate 62 ; ho:maturity "reviewed" .
id:gr-structured-output a ho:Guardrail ; skos:prefLabel "Structured output" ; skos:altLabel "deliverable template" ;
    ho:promptText "Emit every deliverable in the agreed structured template for its type -- consistent sections, headings and fields -- so downstream roles and any convergence gate can consume it mechanically rather than re-parsing free-form prose." ;
    ho:tagged id:c-structured-output ; ho:tokenEstimate 40 ; ho:maturity "reviewed" .
id:gr-scale-modes a ho:Guardrail ; skos:prefLabel "Scale execution modes" ;
    skos:altLabel "full/reduced/single modes" , "full pipeline mode" , "review mode" ;
    ho:promptText "Match effort to the request's scope: run the full agent team for a broad request, a reduced subset of roles for a narrow one, and a single pass for a trivial one -- scale the active roles and workflow to the scope rather than always running everything." ;
    ho:tagged id:c-scale-modes ; ho:tokenEstimate 46 ; ho:maturity "reviewed" .
id:gr-graceful-fallback a ho:Guardrail ; skos:prefLabel "Graceful fallback" ; skos:altLabel "error fallback" ;
    ho:promptText "Anticipate failure per operation and degrade gracefully: for each foreseeable failure mode define a fallback (retry, reduced-scope result, or a clearly flagged partial deliverable) rather than aborting the whole run, and make any degradation explicit in the output." ;
    ho:tagged id:c-graceful-fallback ; ho:tokenEstimate 48 ; ho:maturity "reviewed" .

#===================== Complexity governance (orchestration limits) ====
id:gr-depth-limit a ho:Guardrail ; skos:prefLabel "Delegation depth limit" ; skos:altLabel "at most two levels" , "no nested teams" ;
    ho:promptText "Limit delegation to at most two levels deep: a coordinator may delegate to workers, but those workers are leaf agents that do not spawn or lead further sub-teams, keeping the call graph shallow and debuggable." ;
    ho:tagged id:c-complexity-governance ; ho:tokenEstimate 46 ; ho:maturity "draft" .
id:gr-single-active-team a ho:Guardrail ; skos:prefLabel "Single active team" ;
    ho:promptText "Keep exactly one agent team active at a time rather than running multiple concurrent teams, so coordination state stays observable and contention is avoided." ;
    ho:tagged id:c-complexity-governance ; ho:tokenEstimate 38 ; ho:maturity "draft" .
id:gr-bottleneck-avoidance a ho:Guardrail ; skos:prefLabel "Avoid coordination bottlenecks" ; skos:altLabel "parallel-first scheduling" ;
    ho:promptText "Do not funnel every hand-off through a single coordinator when the work is parallelisable; distribute coordination so that one agent does not become a throughput bottleneck." ;
    ho:tagged id:c-complexity-governance ; ho:tokenEstimate 40 ; ho:maturity "draft" .
id:gr-flatten-hierarchy a ho:Guardrail ; skos:prefLabel "Flatten the hierarchy" ;
    ho:promptText "Prefer the flattest agent hierarchy that solves the task; add a coordination layer only when depth is genuinely required, not by default. This is a soft preference toward flatter structure, NOT the hard numeric cap on delegation depth -- that quantitative bound is id:gr-depth-limit." ;
    ho:tagged id:c-complexity-governance ; ho:tokenEstimate 54 ; ho:maturity "draft" .
id:gr-bounded-iteration a ho:Guardrail ; skos:prefLabel "Bounded iteration" ; skos:altLabel "retry cap" ;
    ho:promptText "Cap corrective iteration: a producer-reviewer or retry loop runs at most two to three rounds, then escalates or returns a clearly flagged partial rather than looping unbounded." ;
    ho:tagged id:c-complexity-governance ; ho:tokenEstimate 40 ; ho:maturity "draft" .

#===================== Verification, authoring and model governance ====
id:gr-integration-coherence a ho:Guardrail ; skos:prefLabel "Integration coherence" ; skos:altLabel "boundary cross-check" ;
    ho:promptText "Read the producer and the consumer of an interface together and cross-check that the two sides agree at their shared boundary; prefer connection checks over mere existence checks. Distinct from grounding (id:gr-grounding), which links an artifact to its rationale -- this verifies that two components actually fit where they meet." ;
    ho:tagged id:c-grounding ; ho:tokenEstimate 72 ; ho:maturity "draft" .
id:gr-discriminating-eval a ho:Guardrail ; skos:prefLabel "Discriminating evaluation" ; skos:altLabel "baseline differential" ;
    ho:promptText "Evaluate against a baseline so the test discriminates: compare behaviour with and without the component under test, and discard any assertion that passes in both arms because it proves nothing about the component." ;
    ho:tagged id:c-agent-methodology ; ho:tokenEstimate 48 ; ho:maturity "draft" .
id:gr-single-responsibility a ho:Guardrail ; skos:prefLabel "Single responsibility per role" ;
    ho:promptText "Give each role exactly one clear responsibility; if a role accretes a second distinct duty, split it into two roles rather than overloading one." ;
    ho:tagged id:c-least-privilege ; ho:tokenEstimate 34 ; ho:maturity "draft" .
id:gr-generalize-not-overfit a ho:Guardrail ; skos:prefLabel "Generalize, do not overfit" ;
    ho:promptText "When acting on feedback, fix the underlying principle rather than the single reported instance: generalize the correction into a reusable rule instead of patching one case and leaving the class of problem open." ;
    ho:tagged id:c-design ; ho:tokenEstimate 50 ; ho:maturity "draft" .
id:gr-absolute-paths a ho:Guardrail ; skos:prefLabel "Absolute workspace paths" ;
    ho:promptText "Reference shared-workspace files by absolute path rooted at the workspace directory rather than by relative path, so every agent and session resolves the same file regardless of its working directory." ;
    ho:tagged id:c-multiagent ; ho:tokenEstimate 46 ; ho:maturity "draft" .
id:gr-well-formed-skill a ho:Guardrail ; skos:prefLabel "Well-formed skill" ;
    ho:promptText "Author every skill in well-formed shape: a present description, the required section headings and no forbidden files, so the skill is discoverable, invocable and passes its structural contract." ;
    ho:tagged id:c-skill-authoring ; ho:tokenEstimate 46 ; ho:maturity "draft" .
# The ENFORCEMENT counterpart of the guardrail above: a skill-authoring skill
# (ho:Instruction, a BehavioralComponent leaf) that PROVIDES id:cap-skill, so the
# structural contracts on that capability roll up (hasComponent o providesCapability
# o capabilityContract) to any harness that ships it. Co-located with its guardrail
# half; the ho:Instruction IRI is location-independent. When a harness binds it via
# ho:hasInstruction, materialize.py emits .claude/skills/well-formed-skill/SKILL.md
# from this node's graph data (prefLabel -> title heading, skos:definition ->
# frontmatter description), which is exactly what the cap-skill contracts assert.
id:ins-well-formed-skill a ho:Instruction ; skos:prefLabel "Well-formed skill authoring" ;
    skos:notation "well-formed-skill" ;
    skos:definition "Author every skill as a well-formed SKILL.md with a present frontmatter description and the required title heading, so the skill is discoverable, invocable and passes its structural contract." ;
    ho:providesCapability id:cap-skill ;
    ho:tagged id:c-skill-authoring ;
    ho:promptText "When authoring a skill, package it as a well-formed SKILL.md: a present description field in the frontmatter and the required title/section headings, and keep forbidden bookkeeping files (README, CHANGELOG) out of the skill directory, so the skill is discoverable, invocable and passes its structural contract." ;
    ho:tokenEstimate 72 ; ho:maturity "draft" .
id:gr-opus-required a ho:Guardrail ; skos:prefLabel "Opus model required" ; skos:altLabel "dispatch model floor" ;
    ho:promptText "Spawn quality-critical dispatch roles (authoring and judgment) on the top-tier model, since their output determines final correctness; make the model requirement explicit rather than leaving it to template default." ;
    ho:tagged id:c-multiagent ; ho:tokenEstimate 50 ; ho:maturity "draft" .

#===================== Team review, routing and acceptance discipline ==
id:gr-cross-validation a ho:Guardrail ; skos:prefLabel "Cross-validate every deliverable" ; skos:altLabel "severity-triaged peer review" ;
    ho:promptText "Have every deliverable cross-validated by a role other than the one that produced it, and grade each finding by severity; force rework only for the top severity band and carry the lower bands as recorded, accepted observations, so review converges instead of reopening the work on every remark." ;
    ho:tagged id:c-cross-validation ; ho:tokenEstimate 62 ; ho:maturity "draft" .
id:gr-declared-routes a ho:Guardrail ; skos:prefLabel "Declared hand-off routes" ; skos:altLabel "explicit communication protocol" ;
    ho:promptText "Each role declares its own outbound hand-off routes -- which role it sends what to, and on what event -- as part of its own definition, so the coordination topology is readable from the parts themselves instead of being inferred from a diagram kept somewhere else." ;
    ho:tagged id:c-communication ; ho:tokenEstimate 60 ; ho:maturity "draft" .
id:gr-sequenced-artifacts a ho:Guardrail ; skos:prefLabel "Sequenced workspace artifacts" ; skos:altLabel "ordinal artifact naming" ;
    ho:promptText "Name every shared-workspace artifact with an ordinal prefix followed by its document type and extension, so production order is visible from a plain directory listing and each consumer resolves the exact file its producer wrote rather than guessing among similar names." ;
    ho:tagged id:c-deliverable-artifact ; ho:tokenEstimate 54 ; ho:maturity "draft" .
id:gr-three-flow-acceptance a ho:Guardrail ; skos:prefLabel "Three-flow acceptance coverage" ; skos:altLabel "normal, resumed and error fixtures" ;
    ho:promptText "Cover all three run flows with behaviour fixtures before calling a harness accepted: the normal path from empty state, the path resumed over existing input, and the error path; a fixture set that exercises only the happy path is a demonstration, not an acceptance." ;
    ho:tagged id:c-acceptance-coverage ; ho:tokenEstimate 58 ; ho:maturity "draft" .

#===================== Same-role concurrency ===========================
# The discipline for a project that staffs SEVERAL concurrent instances of ONE
# role (id:c-role-multiplicity). Only the two rules that keep such instances
# from colliding are new here -- the rest of the situation is already covered
# by existing parts and is deliberately NOT re-authored: the claimable board is
# id:chan-task-board, the split-and-merge shape is id:pat-fanout-fanin, the
# merge-time clash is id:fp-conflict-contradiction and the shared-file
# addressing rule is id:gr-absolute-paths. Split in two because they are two
# policies, not one: WHEN an instance may start work (claim) and WHERE it may
# write (isolation) hold independently -- a claim discipline with a shared
# write scope still corrupts artifacts, and disjoint write scopes without
# claims still duplicate effort.
id:gr-work-claim a ho:Guardrail ; skos:prefLabel "Claim before starting" ; skos:altLabel "first claim wins" ;
    ho:promptText "Where several instances of one role run at the same time, each instance claims its work item on the shared task board before it starts and works only on items it holds a claim on: no unclaimed work, and no second claim on an item another instance already holds -- the earliest claim marker on the board wins." ;
    ho:tagged id:c-role-multiplicity ; ho:tokenEstimate 77 ; ho:maturity "draft" .
id:gr-instance-isolation a ho:Guardrail ; skos:prefLabel "Disjoint write scopes per instance" ; skos:altLabel "one writer per artifact" ;
    ho:promptText "Give concurrent instances of one role disjoint write scopes -- each its own artifact partition or its own working copy -- so that two instances never write the same artifact; their outputs are brought together at the declared fan-in step, never by overwriting one another in place." ;
    ho:tagged id:c-role-multiplicity ; ho:tokenEstimate 70 ; ho:maturity "draft" .

#===================== Human-in-the-loop oversight =====================
# A human-approval GATE anchored at milestones -- the HITL axis observed as an
# explicit "PHASE CHECKPOINT" across ~26 orchestrator commands (wshobson) and as
# "Progressive Disclosure" (present the plan, get confirmation before executing)
# in cc-toolkit's agents rule. Neutralised: no source text copied. Distinct from
# the two nearest existing policies -- id:gr-no-arbitrary-decision (REACTIVE
# escalation of a specific open question) and id:gr-verify-proceed (advance on any
# confirmed machine state, not elapsed time) -- so the "Distinct from" clauses in
# promptText carry that disambiguation. Bound below into id:h-multiagent (its
# orchestrator presents plans for user approval at phase boundaries): that harness
# gains exactly one operating-rules bullet; the other six harnesses are unchanged.
id:gr-human-checkpoint a ho:Guardrail ; skos:prefLabel "Human approval checkpoint" ;
    skos:altLabel "phase checkpoint" , "human-in-the-loop gate" , "plan-approval gate" ;
    ho:promptText "Insert an explicit human-approval checkpoint at defined milestones: present the plan or approach and obtain confirmation before proceeding with consequential or irreversible work, and surface high-impact decisions for human review early rather than executing them unattended. Distinct from id:gr-no-arbitrary-decision (which escalates a specific open question) -- this is a proactive gate placed at milestones even when nothing is contested; and from id:gr-verify-proceed (which forbids treating elapsed time as readiness) -- this requires a human sign-off, not merely any confirmed machine state." ;
    ho:tagged id:c-escalation ; ho:tokenEstimate 88 ; ho:maturity "draft" ;
    dct:source "https://github.com/rohitg00/awesome-claude-code-toolkit" , "https://github.com/wshobson/agents" ;
    dct:license "Apache-2.0" , "MIT" .

# The other half of the human-in-the-loop axis: the checkpoint above interrupts
# work at a milestone to get approval, this one runs BEFORE any construction
# starts and makes the agent interrogate the user to fill what the intent/project
# analysis is missing. Distinguished in promptText from the two nearest policies
# -- id:gr-no-arbitrary-decision (REACTIVE escalation of one open question at the
# moment of decision) and id:gr-human-checkpoint (a milestone approval gate).
# Complementary to, not overlapping, id:fp-insufficient-input, which is the
# RUN-TIME row for a step whose input is already too thin: this guardrail is the
# up-front questioning that keeps that row from firing.
id:gr-user-elicitation a ho:Guardrail ; skos:prefLabel "Elicit intent before building" ;
    skos:altLabel "interrogate the user for gaps" , "no assumed requirements" ;
    ho:promptText "Before construction begins, analyse the user's intent and the project the harness will run in; wherever that analysis lacks information the composition depends on, put targeted questions to the user and keep asking until the gaps close -- never assume the missing answers and never proceed on them silently. Distinct from id:gr-no-arbitrary-decision, which escalates one open question at the moment of decision, and from id:gr-human-checkpoint, which gates a milestone for approval: this is proactive interrogation that runs before anything is built." ;
    ho:tagged id:c-composition ; ho:tokenEstimate 138 ; ho:maturity "draft" .

#===================== Lesson learning (trial and error) ===============
# The discipline that turns a failed or corrected attempt into knowledge the
# harness still holds on its next run (id:c-lesson). Split in three because they
# are three policies that hold independently: WHAT a failure obliges an agent to
# write down (capture), WHAT it must read before starting comparable work
# (reuse), and WHEN a private note stops being private (promotion) -- an agent
# that records lessons but never consults them repeats them anyway, and one that
# consults them but never promotes the recurring ones leaves every other agent
# to rediscover the same rule.
#
# NO TBox EXTENSION, DELIBERATELY: an ho:Lesson class was considered and
# rejected. This store is a library of neutral, domain-independent PARTS; an
# individual lesson ("run 12 failed because the catalog was stale") is instance
# data about one execution, not a reusable part, so a class for it would fill
# the central library with run records. The reusable thing is the DISCIPLINE,
# which the existing vocabulary already carries: the rules below (ho:Guardrail),
# the step that performs them (ho:WorkflowStep), the tier a lesson is retained
# in (id:mem-longterm, ho:Memory) and the row for a lesson that was never
# captured (id:fp-repeated-mistake, ho:FailurePolicy). A lesson that recurs does
# not become an instance here either -- it is promoted into a standing part of
# one of those kinds (id:gr-lesson-promotion).
#
# Deliberately NOT re-stated here: each role's own ho:roleMemoryPolicy (which
# already fixes that a role writes back reusable findings at session end) and
# id:mem-longterm's read/write timings. Those say WHEN memory is written and
# read; these say which EXPERIENCE obliges a write, what the entry must contain,
# and what happens to it once it repeats.
id:gr-lesson-capture a ho:Guardrail ; skos:prefLabel "Capture the lesson from a failure" ;
    skos:altLabel "record what went wrong" , "no lesson dies with the session" ;
    ho:promptText "Whenever an attempt fails, is rejected or has to be corrected, record the lesson in the durable store before the run ends: what was attempted, why it failed, and the rule that replaces it. The trigger is the correction itself, not the topic of the work -- a failure whose lesson is left in the session transcript is the one that gets repeated, because the next run starts without it." ;
    ho:tagged id:c-lesson ; ho:tokenEstimate 95 ; ho:maturity "draft" .
id:gr-lesson-reuse a ho:Guardrail ; skos:prefLabel "Consult lessons before repeating work" ;
    skos:altLabel "check past mistakes first" , "do not re-derive a known lesson" ;
    ho:promptText "Before starting work of a kind that has been attempted before, read the lessons already recorded for that kind of work and act on them, instead of re-deriving the approach or walking into a mistake that is already written down. This is the obligation on the AGENT -- to look the lessons up and apply them at the point of starting; that a durable tier is consulted when its trigger fires (id:mem-longterm) is the storage side of the same discipline, not this rule." ;
    ho:tagged id:c-lesson ; ho:tokenEstimate 115 ; ho:maturity "draft" .
id:gr-lesson-promotion a ho:Guardrail ; skos:prefLabel "Promote a recurring lesson into a standing rule" ;
    skos:altLabel "a lesson twice learned becomes a rule" ;
    ho:promptText "When the same lesson is drawn again in a later run, stop carrying it as a private note and promote it into a standing component -- a guardrail, an instruction or an error-handling row -- so every agent afterwards runs under it rather than each rediscovering it. Distinct from id:gr-generalize-not-overfit, which generalises ONE piece of feedback at the moment it is acted on, and from id:gr-root-cause, which fixes where a fault actually lies: the trigger here is RECURRENCE across runs, and the action is to move a proven lesson out of a private store into the shared parts." ;
    ho:tagged id:c-lesson ; ho:tokenEstimate 143 ; ho:maturity "draft" .

#===================== Lifecycle hooks =================================
# Event-triggered automations (ho:Hook, a sibling leaf of ho:Guardrail under
# ho:BehavioralComponent): standing behavioural policies that run an action WHEN
# a lifecycle event fires, rather than always-in-force rules. Co-located in this
# already-federated behavioural unit (not a new .ttl) so no new root import /
# central catalog / recipe-catalog entry is needed -- the execution-mode
# precedent (modes co-located in patterns.ttl): a new federation unit costs root
# + central catalog + every recipe catalog, and the recipe catalogs live in a
# separate clone outside this boundary.
#
# NEUTRALISATION: the 20 hook scripts of rohitg00/awesome-claude-code-toolkit
# (Apache-2.0) collapse to their lifecycle-EVENT archetype -- the store holds a
# neutral parts library, not a catalogue of 20 concrete scripts. The source event
# axis is SessionStart(2)+SessionEnd(2)+PreCompact(1) [session/context lifecycle],
# PreToolUse(7) [pre-action interception -- dominant], PostToolUse(9) [post-action
# reaction -- dominant] and Stop(1)+UserPromptSubmit(1)+Notification(1) [turn
# boundary]. The four archetypes below are the lifecycle SPINE -- session-open ->
# pre-tool -> post-tool -> turn-stop -- covering the two dominant categories plus
# the session and turn boundaries. The remaining event values (session-end,
# pre-compact, user-prompt-submit, notification) are each addable as ONE more
# ho:Hook individual with a new ho:hookEvent literal and no schema change -- the
# axis's extensibility proof. No source text is copied; each records provenance
# via dct:source / dct:license. Connectivity is by the h-harness-factory hasHook
# binding (they are ho:HarnessComponents), mirroring how FailurePolicy/
# TestScenario rows are reached by their binding rather than by a concept tag.
id:hook-session-start a ho:Hook ;
    skos:prefLabel "Session-start context hook" ; skos:altLabel "session-start hook" ;
    skos:definition "A lifecycle hook that fires on the session-start event: at session initialization it loads the context an agent needs to resume work coherently -- prior session state, project configuration and outstanding todos -- so the agent begins already grounded rather than cold. The session-open position of the lifecycle-trigger axis." ;
    ho:hookEvent "session-start" ;
    ho:hookAction "Load prior session context and project state (recent history, configuration, pending work) at session initialization" ;
    ho:tokenEstimate 74 ; ho:maturity "draft" ;
    dct:source "https://github.com/rohitg00/awesome-claude-code-toolkit" ;
    dct:license "Apache-2.0" .

id:hook-pre-tool-use a ho:Hook ;
    skos:prefLabel "Pre-tool-use guard hook" ; skos:altLabel "pre-tool-use hook" ;
    skos:definition "A lifecycle hook that fires on the pre-tool-use event: before a tool action runs it inspects the pending action and may guard, scan or block it -- e.g. screening a write for leaked secrets, checking a command against allow/deny policy, or requiring confirmation for a consequential operation. The pre-action interception position of the lifecycle-trigger axis (the dominant category in the source corpus). Distinct from a Guardrail, which states the policy an agent must follow; this hook is the event-triggered automation that enforces such policy at the moment a tool is about to act." ;
    ho:hookEvent "pre-tool-use" ;
    ho:hookAction "Inspect the pending tool action before it runs and guard, scan or block it against policy (e.g. secret scan, allow/deny check, confirmation gate)" ;
    ho:tokenEstimate 96 ; ho:maturity "draft" ;
    dct:source "https://github.com/rohitg00/awesome-claude-code-toolkit" ;
    dct:license "Apache-2.0" .

id:hook-post-tool-use a ho:Hook ;
    skos:prefLabel "Post-tool-use check hook" ; skos:altLabel "post-tool-use hook" ;
    skos:definition "A lifecycle hook that fires on the post-tool-use event: after a tool action completes it reacts to the result -- e.g. linting or auto-fixing an edited file, running the affected tests, or type-checking the change -- so quality feedback is automatic rather than deferred. The post-action reaction position of the lifecycle-trigger axis (the dominant category in the source corpus)." ;
    ho:hookEvent "post-tool-use" ;
    ho:hookAction "React to a completed tool action by validating its result (e.g. lint or auto-fix the edited file, run the affected tests, type-check the change)" ;
    ho:tokenEstimate 88 ; ho:maturity "draft" ;
    dct:source "https://github.com/rohitg00/awesome-claude-code-toolkit" ;
    dct:license "Apache-2.0" .

id:hook-stop a ho:Hook ;
    skos:prefLabel "Turn-stop reminder hook" ; skos:altLabel "stop hook" ;
    skos:definition "A lifecycle hook that fires on the stop event: when the agent finishes a turn it runs a completion-time check before yielding -- e.g. reminding to run the project's tests or checks if code was modified, or persisting what should carry to the next turn. The turn-boundary position of the lifecycle-trigger axis." ;
    ho:hookEvent "stop" ;
    ho:hookAction "At turn completion, run a closing check before yielding (e.g. remind to run the project's tests/checks if code changed, persist carry-over state)" ;
    ho:tokenEstimate 74 ; ho:maturity "draft" ;
    dct:source "https://github.com/rohitg00/awesome-claude-code-toolkit" ;
    dct:license "Apache-2.0" .
