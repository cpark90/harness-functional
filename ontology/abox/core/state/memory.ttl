@prefix ho:    <https://harness-ontology.dev/schema#> .
@prefix id:    <https://harness-ontology.dev/id/core/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .

# Core data unit -- Memory partition of the `core` domain (split out of the
# roles unit: the agent memory tiers). Imports the central TBox only;
# cross-unit references (the h-multiagent harness binding these via hasMemory,
# each role's ho:roleMemoryPolicy, the areas that ho:observesMemory them)
# resolve in the root union (docs/federation-design.md D1, ONTOLOGYSTYLE 4).
<https://harness-ontology.dev/data/core/memory> a owl:Ontology ;
    owl:imports <https://harness-ontology.dev/schema> .

########################################################################
# Agent memory tiers — the neutral memory architecture an agent maintains,
# co-located with the roles (agent-state) because ho:roleMemoryPolicy above is
# a single free-text directive that cannot express the THREE distinct tiers an
# agent keeps. Each tier is a first-class ho:Memory component distinguished by
# WHEN it is read (ho:memoryReadTiming), HOW newly produced knowledge is routed
# into it at production time (ho:memoryWriteTiming) and HOW LONG it persists
# (ho:memoryPersistence): firmware (always read in full, durable baseline,
# authored up front), cache (accumulated within one spawned task, ephemeral,
# applied immediately) and long-term (read only on a trigger, durable,
# consulted selectively, stored deliberately). All three are bound to
# the neutral id:h-multiagent template via ho:hasMemory (subPropertyOf
# hasComponent) so each is a connected, orphan-free HarnessComponent.
########################################################################

#===================== MEMORY TIERS ====================================

id:mem-firmware a ho:Memory ;
    skos:prefLabel "Firmware memory" ;
    skos:definition "The fixed baseline memory an agent MUST read in full on every execution/spawn: its always-loaded, mandatory ruleset, read whole each time so it frames behaviour before any task-specific state." ;
    ho:memoryReadTiming "every-execution" ;
    ho:memoryWriteTiming "authored" ;
    ho:memoryPersistence "durable" ;
    ho:memoryReadScope "full" ;
    ho:tagged id:c-memory, id:c-multiagent ;
    ho:tokenEstimate 55 ; ho:maturity "draft" .

id:mem-cache a ho:Memory ;
    skos:prefLabel "Cache memory" ; skos:altLabel "Short-term memory" ;
    skos:definition "The task-scoped working memory that accumulates the agent's behaviour rules within a single spawned task and is discarded when that task ends: volatile, internal to the spawn, never surviving it. On the write side it is the immediate-apply tier: knowledge produced while the task runs is folded into the ongoing reasoning at once instead of being written down for a later run." ;
    ho:memoryReadTiming "task-continuous" ;
    ho:memoryWriteTiming "immediate-apply" ;
    ho:memoryPersistence "ephemeral" ;
    ho:memoryReadScope "full" ;
    ho:tagged id:c-memory, id:c-multiagent ;
    ho:tokenEstimate 105 ; ho:maturity "draft" .

id:mem-longterm a ho:Memory ;
    skos:prefLabel "Long-term memory" ;
    skos:definition "Durable memory NOT read on every execution/spawn; the agent consults and reflects only the relevant portion when a defined condition is met, pulling it in selectively on demand rather than loading it each time. On the write side it is the deliberate-store tier: knowledge produced in a run is deliberately written down at the end WITHOUT being applied to the current logic, taking effect only when a later run's trigger reads it back -- which is why the lessons drawn from trial and error (id:c-lesson) are the representative content of this tier rather than of the other two." ;
    ho:memoryReadTiming "conditional" ;
    ho:memoryWriteTiming "deliberate-store" ;
    ho:memoryPersistence "durable" ;
    ho:memoryReadScope "selective" ;
    ho:memoryActivationCondition "A defined trigger condition is met (e.g. the current task matches the memory's applicability); only then is the relevant portion consulted and reflected." ;
    ho:retrievalPolicy "Scored retrieval: rank the stored entries by a weighted combination of recency (decaying with time since the entry was last accessed), importance (a weight assigned when the entry is written) and relevance to the current task, and consult only the top-ranked portion within the read budget -- consumption is selective, so an entry scoring low on all three is simply not loaded." ;
    ho:hasLink id:link-mem-longterm-topic-memory, id:link-mem-longterm-topic-lesson ;
    ho:tagged id:c-memory, id:c-multiagent, id:c-lesson ;
    ho:tokenEstimate 144 ; ho:maturity "draft" .

#===================== WEIGHTED TOPIC LINKS (ho:Link) ==================
# 구 ho:Anchor 7건의 이전분(사용자 승인 저작 — 의미 보존: 같은 source/target/
# 가중치, kind만 id:kind-topic으로 명시화). 가중 눈금은 anchor 규약의 2단 정성
# 눈금을 그대로 계승한다:
#   0.9 = primary   — 노드의 definition 본문 주제가 곧 그 region이다.
#   0.4 = secondary — region이 definition에 문맥·한정어·내용 예시로만 등장하고,
#                     definition 자신의 문장이 그것을 부차로 자리매김한다.
# 중간값·소수점 정밀화는 쓰지 않는다(정성 구분을 숫자로 위장하지 않기 위해).
# ho:weightOrigin "curated": definition 문면 근거로 사람이 확정한 값이므로
# 재측정이 절대 덮지 않는다(ho:weightOrigin의 보호 계약). topic 링크는
# definition 문면에서 주/부 구분이 실제로 읽히는 노드에만 단다 — 근거 없는
# 태그(예: mem-cache/mem-firmware의 c-multiagent)는 crisp ho:tagged로만 남는다.

# mem-longterm의 definition은 전체가 read-timing/persistence 티어 서술(c-memory
# region 자체)이고, c-lesson은 "the lessons ... are the representative content of
# this tier"로 티어의 내용물로서 부차 자리매김된다. c-multiagent는 definition에
# 문면 근거가 없어 topic 링크를 달지 않는다(태그는 유지).
id:link-mem-longterm-topic-memory a ho:Link ;
    skos:prefLabel "Long-term memory / Agent memory topic link" ;
    ho:linkTarget id:c-memory ; ho:linkKind id:kind-topic ;
    ho:linkWeight 0.9 ; ho:weightOrigin "curated" .

id:link-mem-longterm-topic-lesson a ho:Link ;
    skos:prefLabel "Long-term memory / Lesson learning topic link" ;
    ho:linkTarget id:c-lesson ; ho:linkKind id:kind-topic ;
    ho:linkWeight 0.4 ; ho:weightOrigin "curated" .
