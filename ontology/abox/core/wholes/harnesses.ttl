@prefix ho:    <https://harness-ontology.dev/schema#> .
@prefix id:    <https://harness-ontology.dev/id/core/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .

# Core data unit -- Harness partition of the `core` domain. Imports the
# central TBox only; cross-unit references resolve in the root union
# (docs/federation-design.md D1, ONTOLOGYSTYLE 4).
<https://harness-ontology.dev/data/core/harnesses> a owl:Ontology ;
    owl:imports <https://harness-ontology.dev/schema> .

########################################################################
# Seed ABox — three example harnesses that deliberately SHARE
# components (vector-retriever, cite-sources, opus model) and vocabulary
# (information-retrieval), so the graph is connected and retrieval has
# something interesting to traverse.
########################################################################

#===================== HARNESSES =======================================

# CARRIER of the wave-C agent-computer-interface parts: this is the harness
# whose tool results those parts discipline, so they bind HERE as declared
# discipline rather than on a library carrier (the W1 vnv preference for the
# declaring harness) -- id:tool-lint-gated-edit gates its edits behind
# check-or-revert, and id:gr-aci-observation bounds what its shell/editor
# results hand back. This deliberately CHANGES this harness's materialized
# document (one added tool, one added operating rule) -- intended: the agent
# running under this harness is the one these parts govern.
id:h-coding a ho:Harness ;
    skos:prefLabel "Autonomous coding agent" ; skos:altLabel "coding harness" ;
    skos:definition "An autonomous agent that fixes bugs and reviews code with shell + editor tools." ;
    ho:targetsDomain id:dom-coding ;
    ho:addressesTask id:task-bugfix, id:task-codereview ;
    ho:hasSystemPrompt id:sp-coding ;
    ho:usesTool id:tool-shell, id:tool-editor, id:tool-lint-gated-edit ;
    ho:hasWorkflow id:wf-react ;
    ho:hasGuardrail id:gr-nodestruct, id:gr-lang, id:gr-standard-terms, id:gr-aci-observation ;
    ho:usesModel id:mc-opus ;
    ho:hasEnvelope id:oe-coding ;
    ho:appliesPattern id:pat-react ;
    ho:autonomyTier id:tier-bounded-autonomy ;
    ho:requiresCapability id:cap-codeexec, id:cap-fileedit ;
    ho:tagged id:c-softeng, id:c-debugging, id:c-autonomy ;
    ho:maturity "stable" .

id:h-research a ho:Harness ;
    skos:prefLabel "Research synthesis agent" ; skos:altLabel "research harness" ;
    skos:definition "A plan-execute agent that surveys sources and writes cited syntheses." ;
    ho:targetsDomain id:dom-research ;
    ho:addressesTask id:task-litreview ;
    ho:hasSystemPrompt id:sp-research ;
    ho:usesTool id:tool-websearch, id:tool-retriever ;
    ho:hasWorkflow id:wf-planexec ;
    ho:hasGuardrail id:gr-cite, id:gr-lang, id:gr-standard-terms ;
    ho:usesModel id:mc-opus ;
    ho:appliesPattern id:pat-planexec ;
    ho:requiresCapability id:cap-websearch, id:cap-retrieval, id:cap-citation ;
    ho:tagged id:c-inforetrieval, id:c-summarization ;
    ho:maturity "reviewed" .

id:h-support a ho:Harness ;
    skos:prefLabel "Support triage agent" ; skos:altLabel "support harness" ;
    skos:definition "A low-latency single-shot agent that triages support tickets with retrieval." ;
    ho:targetsDomain id:dom-support ;
    ho:addressesTask id:task-triage ;
    ho:hasSystemPrompt id:sp-support ;
    ho:usesTool id:tool-retriever ;
    ho:hasWorkflow id:wf-singleshot ;
    ho:hasGuardrail id:gr-cite, id:gr-lang, id:gr-standard-terms ;
    ho:usesModel id:mc-sonnet ;
    ho:appliesPattern id:pat-reflection ;
    ho:requiresCapability id:cap-retrieval ;
    ho:constrainedBy id:con-lowlatency ;
    ho:tagged id:c-inforetrieval ;
    ho:specializes id:h-research ;
    ho:maturity "reviewed" .

########################################################################
# Reusable parts decomposed from harness governance docs
#
# Neutral, domain-INDEPENDENT building blocks extracted from the design /
# multi-agent governance methodology (CLAUDE.md, CODESTYLE.md,
# DESIGN_HARNESS_STANDARD.md). These are library PARTS: generalised
# guardrail policies, an orchestration pattern/workflow and a methodical
# persona that any future harness can assemble. The h-multiagent harness
# below only exists to wire the parts (anti-orphan) and stands as a neutral
# template — it names no specific problem domain, tool or technology.
########################################################################

#===================== HARNESSES =======================================

# SCOPE of the TWO ho:hasExecutionMode values on this harness: they describe two
# CONCURRENT PLANES of the same harness, not one topology chosen over another.
#   - id:mode-sub-agents is the DISPATCH plane: the workers spawned over
#     id:chan-dispatch, which run for the span of their brief and are reclaimed
#     by the orchestrator (role-implementer / research / vnv / design /
#     synthesizer).
#   - id:mode-standing-service is the STANDING plane: id:role-orchestrator and
#     id:role-inspection hold their roles in persistently open sessions and serve
#     requests as they arrive over durable channels with status markers
#     (id:chan-agent-user, id:chan-orchestrator-inspection), each side scanning on
#     its own cycle (id:gr-online-execution).
# Recording the split here because on one harness the sub-agent mode's "only for
# the span of its delegated task / lead is the single integration point" and the
# channel's "separate sessions ... each side scans the channel on its own cycle"
# otherwise read as contradicting each other: they hold on different planes.
# id:mode-hybrid does NOT apply -- that is one topology varying by PHASE of a run,
# whereas these two planes run at the same time.
#
# CARRIER of the LESSON-LEARNING discipline (id:gr-lesson-capture / -reuse /
# -promotion): they are bound HERE, not on a library-carrier harness, because
# this is the template whose roles already keep a durable role-scoped store and
# whose memory tiers are bound above (id:mem-longterm) -- it is the harness that
# actually operates the discipline, and a rule of this kind only holds if the
# agents running under it are the ones told to record and consult. That makes
# this one of the few bindings that DOES change this harness's materialized
# document (three added operating-rules bullets), which is intended here: the
# byte-identical-stability argument applies to parts that merely need a host, not
# to a rule this harness's own agents must follow. The error side of the same
# discipline (id:fp-repeated-mistake) is bound to id:h-harness-factory instead,
# where the evolution loop that would have caught the repetition lives.
#
# CARRIER of the HUMAN-GATE MECHANICS (wave-H): this is the harness that
# actually operates a per-plan human approval gate (id:tier-per-plan-approval,
# id:gr-human-checkpoint, the approval-enforcing user channel), so the parts
# that make such a gate WORK bind here as declared discipline rather than on a
# library carrier (the W1 vnv preference for the declaring harness):
#   - the loop that shapes its feedback pipeline (id:wf-approval-gated with the
#     clarification / interrupt-resume / output-review / control-transfer steps),
#   - the gate-content and rejection rules (id:gr-plan-evidence,
#     id:gr-rejection-feedback) and the replay-safety rule its wip->rename
#     resumable file pipeline embodies (id:gr-resume-idempotency),
#   - the two human-gate conduit lanes (id:chan-approval, id:chan-elicitation),
#   - the three gate-outcome error rows (id:fp-unanswered-approval,
#     id:fp-reject-retry-feedback, id:fp-dismissal-vs-decline) and the fixture
#     that probes the gate itself (id:scn-oversight-efficacy).
# This deliberately CHANGES this harness's materialized document (new process,
# channel, error-handling and test-scenario content) -- intended: these rules
# only hold if the agents running under this template are the ones bound.
id:h-multiagent a ho:Harness ;
    skos:prefLabel "Multi-agent orchestration harness" ; skos:altLabel "orchestrator-workers harness" ;
    skos:definition "A neutral, domain-independent harness that assembles the reusable governance parts decomposed from harness governance docs: an orchestrator plans and dispatches node-scoped briefs to specialised workers (author / verify / inspect) under least-privilege, with traceability, verify-then-proceed and escalation guardrails. Its PURPOSE is to make each role's agent perform its role clearly: it composes, per role, the role's scope of tools and guardrails (ho:roleTool / ho:roleGuardrail), its memory discipline and (where present) its user-facing stance, plus the coordination channels the roles exchange work over — so every dispatched agent has an unambiguous mandate. Use as a template for any structured, multi-agent design or authoring workflow." ;
    ho:targetsDomain id:dom-design ;
    ho:addressesTask id:task-architecture, id:task-designdecision ;
    ho:hasSystemPrompt id:sp-methodical ;
    ho:usesTool id:tool-shell, id:tool-editor, id:tool-websearch, id:tool-retriever ;
    ho:hasWorkflow id:wf-multiagent, id:wf-compose-harness, id:wf-approval-gated ;
    ho:hasGuardrail id:gr-lang, id:gr-standard-terms, id:gr-verify-proceed, id:gr-design-for-loss, id:gr-traceability,
        id:gr-grounding, id:gr-no-arbitrary-decision, id:gr-least-privilege, id:gr-report-over-prompt,
        id:gr-controlled-vocabulary, id:gr-root-cause, id:gr-simplicity, id:gr-bounded-context,
        id:gr-dispatch-execution, id:gr-online-execution, id:gr-mode-fit,
        id:gr-delegated-orchestration, id:gr-execution-separation, id:gr-structural-coverage,
        id:gr-reuse-first, id:gr-human-checkpoint, id:gr-user-elicitation,
        id:gr-lesson-capture, id:gr-lesson-reuse, id:gr-lesson-promotion,
        id:gr-plan-evidence, id:gr-rejection-feedback, id:gr-resume-idempotency ;
    ho:usesModel id:mc-opus ;
    ho:hasRole id:role-orchestrator, id:role-inspection, id:role-implementer, id:role-research,
        id:role-vnv, id:role-design, id:role-synthesizer ;
    ho:hasChannel id:chan-agent-user, id:chan-orchestrator-inspection, id:chan-dispatch,
        id:chan-approval, id:chan-elicitation ;
    ho:hasMemory id:mem-firmware, id:mem-cache, id:mem-longterm ;
    ho:hasAgent id:agent-orchestrator, id:agent-developer, id:agent-vnv, id:agent-inspection,
        id:agent-synthesizer ;
    ho:hasGlobalState id:global-state ;
    ho:hasAssemblySection id:as-overview, id:as-persona, id:as-operating-rules, id:as-process,
        id:as-model, id:as-roles, id:as-channels, id:as-skills, id:as-execution-mode,
        id:as-data-flow, id:as-error-handling, id:as-test-scenarios, id:as-hooks ;
    ho:hasTestScenario id:scn-oversight-efficacy ;
    ho:hasFailurePolicy id:fp-unanswered-approval, id:fp-reject-retry-feedback,
        id:fp-dismissal-vs-decline ;
    ho:hasEnvelope id:oe-multiagent ;
    ho:appliesPattern id:pat-orchestrator-workers, id:pat-ontology-composition ;
    ho:hasExecutionMode id:mode-sub-agents, id:mode-standing-service ;
    ho:autonomyTier id:tier-per-plan-approval ;
    ho:requiresCapability id:cap-orchestration, id:cap-traceability, id:cap-codeexec, id:cap-fileedit ;
    ho:tagged id:c-design, id:c-multiagent, id:c-traceability ;
    ho:maturity "draft" .

# The peer-mesh counterpart of id:h-multiagent: a neutral, domain-independent
# template that exists to WIRE the peer-mesh coordination parts (anti-orphan) and
# to make coordination topology an explicit, selectable dimension. Where
# id:h-multiagent stays the orchestrator-workers DEFAULT doctrine (central
# dispatch), this one demonstrates the alternative — peers coordinate directly
# over id:chan-peer with no central-only dispatcher — by declaring
# ho:appliesPattern id:pat-peer-mesh plus the matching channel. A recipe that
# needs peer-mesh derives from this; new topologies are added the same way (new
# DesignPattern + Channel + a host harness) without disturbing either existing
# one. It reuses central parts by IRI and names no specific domain/tool/tech.
id:h-peer-mesh a ho:Harness ;
    skos:prefLabel "Peer-mesh coordination harness" ; skos:altLabel "peer-mesh harness" ;
    skos:definition "A neutral, domain-independent template harness demonstrating the peer-mesh coordination methodology as the selectable alternative to orchestrator-workers: peer worker roles coordinate DIRECTLY over a message mesh (id:chan-peer) rather than through a central-only dispatcher. It exists to wire the peer-mesh parts (anti-orphan) and to make coordination topology a pluggable dimension — a harness picks its methodology via ho:appliesPattern plus the matching ho:Channel, and new topologies are added as new DesignPattern + Channel without disturbing the orchestrator-workers default (id:h-multiagent). Names no specific problem domain, tool or technology." ;
    ho:targetsDomain id:dom-design ;
    ho:addressesTask id:task-designdecision ;
    ho:hasSystemPrompt id:sp-methodical ;
    ho:usesTool id:tool-editor ;
    ho:hasWorkflow id:wf-multiagent ;
    ho:hasGuardrail id:gr-lang, id:gr-standard-terms, id:gr-report-over-prompt, id:gr-least-privilege,
        id:gr-execution-separation ;
    ho:usesModel id:mc-opus ;
    ho:hasRole id:role-implementer, id:role-vnv, id:role-research, id:role-design, id:role-coordinator ;
    ho:hasChannel id:chan-peer ;
    ho:appliesPattern id:pat-peer-mesh ;
    ho:hasExecutionMode id:mode-agent-teams ;
    ho:tagged id:c-multiagent, id:c-design ;
    ho:derivedFrom id:h-multiagent ;
    ho:maturity "draft" .

# The central-library host of the recurring neutral parts promoted for reuse
# across the corpus of multi-agent harnesses: the terminal convergence gate
# (id:role-synthesizer, providing id:cap-synthesis), the shared file workspace
# roles hand off deliverables over (id:chan-workspace), and the recurring
# guardrails (structured output, scale modes, graceful fallback). Like
# id:h-peer-mesh, this neutral template exists purely to WIRE those parts
# (anti-orphan) -- it is a library carrier, not a domain pilot, and names no
# specific problem domain, tool or technology. The new parts live here rather
# than on id:h-multiagent so binding them does NOT change id:h-multiagent's
# materialized CLAUDE.md (byte-identical stability). It requires id:cap-synthesis
# and its bound id:role-synthesizer provides it, so capability satisfaction holds
# internally. Reuses central parts by IRI (sp-methodical / wf-multiagent /
# tool-editor / mc-opus / dom-design / task-designdecision).
# It now also carries the NEUTRAL WORKER ARCHETYPES a staffed team is picked
# from (analyst / author / implementer / planner / strategist / tester), the
# team-discipline guardrails those roles run under (cross-validation with
# severity triage, declared hand-off routes, sequenced workspace artifacts,
# three-flow acceptance) and the domain-independent error rows such a team
# declares (worker failure, thin input, critical review finding, unreachable
# source, contradicting deliverables, a request beyond the team's competence or
# authority referred to an expert). They are hosted here for the same reason
# as the parts above -- this is the library carrier, so wiring them leaves every
# other harness's materialized document byte-identical.
# It further carries the SAME-ROLE CONCURRENCY discipline (id:c-role-multiplicity)
# -- claim-before-starting and disjoint write scopes, plus the duplicate-claim
# error row -- because this is the carrier that staffs a team from repeatable
# worker archetypes, which is exactly where one role gets several concurrent
# instances. Those rules presuppose a claimable substrate, so the harness DECLARES
# it: id:chan-task-board is bound below alongside id:chan-workspace (files carry
# the deliverables, the board carries the claims). The central board is reused as
# the neutral DEFAULT rather than redeclared with a local participant set (the
# redefinition ho:Channel allows): its default participants are worker roles this
# carrier staffs, and the leader endpoint it notifies is harness-dependent -- each
# binding harness fills it with its own lead/coordinating role -- so no local clone
# is warranted, and a second near-identical board node in the central library would
# be the near-synonym drift the store exists to prevent. The same reuse-as-default
# holds for id:h-harness-factory, which binds this board while declaring no roles
# at all.
# It also carries the OPERATING-ENVELOPE discipline (id:gr-envelope-check /
# id:gr-envelope-unknown / id:gr-transient-tolerance) and its exit rows
# (id:fp-envelope-exit / id:fp-envelope-exit-severe, which the two declared
# envelopes point at via ho:onEnvelopeExit and which PROVIDE id:cap-safe-halt).
# Hosted here, not on the envelope-declaring harnesses (id:h-coding /
# id:h-multiagent), for the standard library-carrier reason: binding them here
# leaves those harnesses' materialized documents byte-identical this wave
# (envelope rendering is a later wave), while onEnvelopeExit stays a refinement
# edge whose reachability this carrier's hasFailurePolicy binding supplies.
# Wave-H adds two guardrails here: id:gr-safe-halt beside that same halt
# machinery (the fp exit rows PROVIDE id:cap-safe-halt; the rule generalises
# their path to every stop trigger), and id:gr-dual-approval beside the
# team-review discipline (id:gr-cross-validation) it is the human-authorisation
# analogue of -- a library placement, because no current harness staffs two
# independent human approvers.
# Wave-S adds the SIMULATION STAND-IN lane beside the worker roster it staffs
# from: id:role-user-simulator (plays the human side of an evaluated run from
# a hidden scenario), the mediated surface it is constrained to
# (id:tool-env-interface, via ho:usesTool so the role's ho:roleTool scopes a
# part this harness binds) and its confidentiality rule (id:gr-oracle-leak).
# Library placement again: no current harness runs an evaluation simulation,
# so the parts are hosted where the role archetypes live and a concrete
# evaluation recipe binds them as its counterpart lane.
id:h-workspace-synthesis a ho:Harness ;
    skos:prefLabel "Workspace-synthesis harness" ; skos:altLabel "convergence-gate library host" ;
    skos:definition "A neutral, domain-independent template that wires the recurring central-library parts a multi-agent worker team reuses: the worker archetypes a team is staffed from (analyst, author, implementer, planner, strategist, tester), which hand off deliverables over a shared file workspace (id:chan-workspace) under the recurring team disciplines -- structured output, ordinal artifact naming, declared hand-off routes, severity-triaged cross-validation, scaling to the request and graceful degradation -- with a terminal synthesizer gate (id:role-synthesizer) that cross-checks every contribution and compiles the integrated final result (providing id:cap-synthesis, which this harness requires), plus the domain-independent error rows such a team declares. It exists to make those parts connected, reusable components (anti-orphan) and stands as a neutral template -- it names no specific problem domain, tool or technology. Derives from id:h-multiagent and reuses central parts by IRI." ;
    ho:targetsDomain id:dom-design ;
    ho:addressesTask id:task-designdecision ;
    ho:hasSystemPrompt id:sp-methodical ;
    ho:usesTool id:tool-editor, id:tool-env-interface ;
    ho:hasWorkflow id:wf-multiagent ;
    ho:hasGuardrail id:gr-lang, id:gr-standard-terms, id:gr-structured-output, id:gr-scale-modes,
        id:gr-graceful-fallback,
        id:gr-cross-validation, id:gr-declared-routes, id:gr-sequenced-artifacts,
        id:gr-three-flow-acceptance, id:gr-execution-separation,
        id:gr-work-claim, id:gr-instance-isolation,
        id:gr-envelope-check, id:gr-envelope-unknown, id:gr-transient-tolerance,
        id:gr-dual-approval, id:gr-safe-halt, id:gr-oracle-leak ;
    ho:usesModel id:mc-opus ;
    ho:hasRole id:role-research,
        id:role-vnv, id:role-design, id:role-synthesizer,
        id:role-analyst, id:role-author, id:role-implementer,
        id:role-planner, id:role-strategist, id:role-tester, id:role-curator,
        id:role-benchmarker, id:role-auditor, id:role-user-simulator ;
    ho:hasChannel id:chan-workspace, id:chan-task-board ;
    ho:hasFailurePolicy id:fp-agent-failure-retry, id:fp-insufficient-input,
        id:fp-review-critical-rework, id:fp-source-unavailable,
        id:fp-conflict-contradiction, id:fp-refer-to-expert, id:fp-duplicate-claim,
        id:fp-envelope-exit, id:fp-envelope-exit-severe ;
    ho:hasExecutionMode id:mode-sub-agents ;
    ho:requiresCapability id:cap-synthesis ;
    ho:tagged id:c-multiagent, id:c-design, id:c-synthesis ;
    ho:derivedFrom id:h-multiagent ;
    ho:maturity "draft" .

# The central-library host of the harness-authoring METHODOLOGY parts decomposed
# from the revfactory/harness methodology (a meta-harness for building harnesses):
# the coordination-complexity guardrails (delegation depth, no nested teams,
# single active team, bottleneck avoidance, flatten hierarchy, bounded iteration),
# the authoring/verification/model-governance guardrails (integration coherence,
# discriminating evaluation, single responsibility, generalize-not-overfit,
# absolute workspace paths, well-formed skill, opus required) and the task-board
# coordination channel (id:chan-task-board). Like id:h-workspace-synthesis and
# id:h-peer-mesh, this neutral template exists purely to WIRE those parts
# (anti-orphan): they live here rather than on id:h-multiagent so binding them
# does NOT change id:h-multiagent's materialized CLAUDE.md (byte-identical
# stability). It is a library carrier, not a domain pilot, and names no specific
# problem domain, tool or technology. Reuses central parts by IRI (sp-methodical /
# wf-multiagent / tool-editor / tool-shell / mc-opus / dom-design /
# task-designdecision). It now also carries the meta-workflows whose SUBJECT is a
# harness -- the lifecycle loop (id:wf-harness-evolution) and the verification
# pass (id:wf-verify-harness) -- together with the neutral behaviour-acceptance
# fixtures and error-handling rows they judge with; those belong to the
# methodology, not to the general multi-agent template, and hosting them here
# again leaves id:h-multiagent's materialized document byte-identical. Those
# fixtures and rows now reach the emitted document through the run-behaviour
# assembly sections (error-handling / test-scenarios, plus execution-mode and
# data-flow) carried by the central default order. Its execution mode is
# id:mode-hybrid because the topology differs BY PHASE: authoring runs as
# spawn-and-reclaim dispatch (id:wf-multiagent, inherited from id:h-multiagent),
# while the verification and evolution phases (id:wf-verify-harness /
# id:wf-harness-evolution) run as a standing team claiming and reporting work on
# the shared board (id:chan-task-board). It also carries the skill-authoring axis:
# it requires id:cap-skill and ships id:ins-well-formed-skill (which provides it),
# so the capability is satisfied internally and the cap-skill structural contracts
# (id:ct-well-formed-skill-*) roll up here. Those contracts judge the emitted
# .claude/skills/well-formed-skill/SKILL.md -- which materialize DOES emit for the
# bound instruction -- so verify_contract.py PASSES against this harness's tree.
# It also hosts the LIFECYCLE-HOOK axis (id:hook-session-start / pre-tool-use /
# post-tool-use / stop): a harness-authoring factory naturally runs lifecycle
# automations -- load prior context at session start, guard/scan before a tool
# call, validate (e.g. run the project checks) after an edit, and remind before
# yielding -- so these neutral event-trigger archetypes are wired here. Like the
# test-scenario / failure-policy axes above they live on this library carrier, not
# on id:h-multiagent, so binding them leaves the base template's materialized
# CLAUDE.md byte-identical; this harness gains one appended `## Hooks` section
# (rendered by the conditional "hooks" assembly section in the central default
# order). Every harness with no ho:hasHook still emits nothing for that section.
# Its evolution loop now closes with a lesson-capture step (id:wfs-lesson-capture,
# reached by the hasStep roll-up), so this carrier also holds the error row for the
# case that step exists to prevent: id:fp-repeated-mistake -- a failure met again in
# a later run because its lesson was never captured or never consulted. The
# capture / reuse / promotion RULES themselves stay on id:h-multiagent, whose agents
# keep the durable store they act on; this carrier holds only the row that fires
# when they were not honoured. Its scenario catalog also carries the two
# range-judgment fixtures of the operating-envelope axis (id:scn-envelope-in-range /
# id:scn-envelope-exit): they judge envelope-declaring harnesses in general, so
# they live beside the other neutral scn-* fixtures on this methodology host
# rather than on the declaring harnesses (whose materialized documents stay
# byte-identical this wave).
# Wave-H adds the two RUN-BOUNDING guardrails beside id:gr-bounded-iteration,
# completing that family: id:gr-stopping-condition (a run's own declared end)
# and id:gr-auto-reply-budget (a turn budget that re-inserts the human) --
# library placement on the methodology host, because no current harness
# declares a turn budget or run-level stop conditions of its own.
id:h-harness-factory a ho:Harness ;
    skos:prefLabel "Harness-factory harness" ; skos:altLabel "harness-authoring methodology host" ;
    skos:definition "A neutral, domain-independent template that wires the harness-authoring methodology parts: the guardrails that bound multi-agent orchestration complexity and govern faithful authoring, verification and model selection, plus the shared task-board channel (id:chan-task-board) over which workers claim and report tasks. It is a meta-harness -- its subject is the methodology of composing, verifying and evolving harnesses themselves. Like id:h-workspace-synthesis it exists to make those parts connected, reusable components (anti-orphan) and stands as a neutral template -- the parts live here rather than on id:h-multiagent so binding them leaves that harness's materialized document byte-identical. It names no specific problem domain, tool or technology, derives from id:h-multiagent and reuses central parts by IRI." ;
    ho:targetsDomain id:dom-design ;
    ho:addressesTask id:task-designdecision ;
    ho:hasSystemPrompt id:sp-methodical ;
    ho:usesTool id:tool-editor, id:tool-shell ;
    ho:hasWorkflow id:wf-multiagent, id:wf-harness-evolution, id:wf-verify-harness ;
    ho:hasGuardrail id:gr-lang, id:gr-standard-terms, id:gr-depth-limit, id:gr-single-active-team,
        id:gr-bottleneck-avoidance, id:gr-flatten-hierarchy, id:gr-bounded-iteration,
        id:gr-integration-coherence, id:gr-discriminating-eval, id:gr-single-responsibility,
        id:gr-generalize-not-overfit, id:gr-absolute-paths, id:gr-well-formed-skill, id:gr-opus-required,
        id:gr-execution-separation,
        id:gr-stopping-condition, id:gr-auto-reply-budget ;
    ho:usesModel id:mc-opus ;
    ho:hasInstruction id:ins-well-formed-skill ;
    ho:hasChannel id:chan-task-board ;
    ho:hasHook id:hook-session-start, id:hook-pre-tool-use, id:hook-post-tool-use, id:hook-stop ;
    ho:hasTestScenario id:scn-compose-smoke, id:scn-trigger-near-miss,
        id:scn-envelope-in-range, id:scn-envelope-exit ;
    ho:hasFailurePolicy id:fp-dispatch-timeout, id:fp-validation-fail, id:fp-repeated-mistake ;
    ho:appliesPattern id:pat-orchestrator-workers ;
    ho:hasExecutionMode id:mode-hybrid ;
    ho:requiresCapability id:cap-orchestration, id:cap-fileedit, id:cap-codeexec, id:cap-skill ;
    ho:tagged id:c-multiagent, id:c-composition, id:c-agent-methodology ;
    ho:derivedFrom id:h-multiagent ;
    ho:maturity "draft" .

########################################################################
# Operating-envelope declarations — the machine-readable range the two
# representative harnesses undertake to handle (ho:hasEnvelope above). Layer
# split, deliberate: the ATTRIBUTE SCHEME is central vocabulary
# (vocab/concepts.ttl, the five axes under id:c-operating-envelope); the
# DECLARATIONS over those attributes are per-harness and live here with the
# declaring harnesses — other harnesses declare theirs on the recipe side.
# Both envelopes are RESTRICTIVE: only include-rows are written, everything
# unstated is out of range, which is what keeps a declaration this small
# honest. Every row states only what is true of the harness as authored (its
# bound tools, guardrails, tasks and channels — nothing aspirational), and
# every row carries the observable that decides it at request time
# (ho:EnvelopeStatementShape). Exit handling points at the central rows
# (id:fp-envelope-exit / -severe, carried by id:h-workspace-synthesis).
########################################################################

#===================== ENVELOPES: h-coding =============================
id:oe-coding a ho:OperatingEnvelope ;
    skos:prefLabel "Coding agent operating envelope" ;
    skos:definition "The declared range of id:h-coding: software-engineering work — bug fixing and code review — on the workspace repository, in Korean or English, through its bound shell and editor tools, with irreversible actions gated on explicit confirmation. Restrictive: anything these rows do not include (other subject areas, paths outside the repository, unattended external effects) is out of range." ;
    ho:envelopeDefault "restrictive" ;
    ho:hasEnvelopeStatement id:es-coding-subject, id:es-coding-task-kind, id:es-coding-write-scope,
        id:es-coding-language, id:es-coding-reversibility, id:es-coding-environment ;
    ho:onEnvelopeExit id:fp-envelope-exit, id:fp-envelope-exit-severe ;
    ho:tagged id:c-operating-envelope ;
    ho:tokenEstimate 110 ; ho:maturity "draft" .

id:es-coding-subject a ho:EnvelopeStatement ;
    skos:prefLabel "Coding envelope: subject matter" ;
    ho:envelopeAttribute id:c-envelope-subject-matter ;
    ho:envelopeVerdict "include" ;
    ho:envelopeValueType "categorical" ;
    ho:envelopeThreshold "software engineering on the workspace repository (authoring, repair, review of code)" ;
    ho:envelopeObservable "whether the request's subject matter is the authoring, repair or review of code in the workspace repository" ;
    ho:tokenEstimate 61 ; ho:salience 0.2 ; ho:maturity "draft" .
id:es-coding-task-kind a ho:EnvelopeStatement ;
    skos:prefLabel "Coding envelope: task kind" ;
    ho:envelopeAttribute id:c-envelope-task-kind ;
    ho:envelopeVerdict "include" ;
    ho:envelopeValueType "categorical" ;
    ho:envelopeThreshold "bug fixing; code review" ;
    ho:envelopeObservable "whether the requested work maps to one of the harness's declared tasks (id:task-bugfix, id:task-codereview)" ;
    ho:tokenEstimate 44 ; ho:salience 0.2 ; ho:maturity "draft" .
id:es-coding-write-scope a ho:EnvelopeStatement ;
    skos:prefLabel "Coding envelope: write scope" ;
    ho:envelopeAttribute id:c-envelope-write-scope ;
    ho:envelopeVerdict "include" ;
    ho:envelopeValueType "categorical" ;
    ho:envelopeThreshold "files inside the workspace repository" ;
    ho:envelopeObservable "whether every path the request names resolves inside the workspace repository root" ;
    ho:tokenEstimate 42 ; ho:salience 0.2 ; ho:maturity "draft" .
id:es-coding-language a ho:EnvelopeStatement ;
    skos:prefLabel "Coding envelope: language scope" ;
    ho:envelopeAttribute id:c-envelope-language-scope ;
    ho:envelopeVerdict "include" ;
    ho:envelopeValueType "categorical" ;
    ho:envelopeThreshold "Korean or English prose; any programming language in code" ;
    ho:envelopeObservable "the natural language of the request and of the prose it asks for (the id:gr-lang boundary)" ;
    ho:tokenEstimate 50 ; ho:salience 0.2 ; ho:maturity "draft" .
id:es-coding-reversibility a ho:EnvelopeStatement ;
    skos:prefLabel "Coding envelope: action reversibility" ;
    ho:envelopeAttribute id:c-envelope-reversibility ;
    ho:envelopeVerdict "include" ;
    ho:envelopeClosure "restrictive" ;
    ho:envelopeValueType "boolean" ;
    ho:envelopeObservable "whether the requested actions are reversible, or gated on the explicit confirmation id:gr-nodestruct requires where they are not" ;
    ho:tokenEstimate 48 ; ho:salience 0.2 ; ho:maturity "draft" .
id:es-coding-environment a ho:EnvelopeStatement ;
    skos:prefLabel "Coding envelope: environment assumption" ;
    ho:envelopeAttribute id:c-envelope-environment-assumption ;
    ho:envelopeVerdict "include" ;
    ho:envelopeValueType "boolean" ;
    ho:envelopeObservable "whether the workspace provides the shell and file-editing tools the harness binds (id:tool-shell, id:tool-editor)" ;
    ho:tokenEstimate 42 ; ho:salience 0.2 ; ho:maturity "draft" .

#===================== ENVELOPES: h-multiagent =========================
id:oe-multiagent a ho:OperatingEnvelope ;
    skos:prefLabel "Multi-agent template operating envelope" ;
    skos:definition "The declared range of id:h-multiagent: design and structured multi-role authoring work arriving from the session user over the declared user channel, decomposable into node-scoped dispatch briefs, written inside the roles' least-privilege boundaries, in Korean or English, with a responsive user reachable for escalation. Restrictive: work that cannot be decomposed for dispatch, arrives outside the declared channels, or writes outside the role boundaries is out of range." ;
    ho:envelopeDefault "restrictive" ;
    ho:hasEnvelopeStatement id:es-multiagent-subject, id:es-multiagent-task-scale,
        id:es-multiagent-requester, id:es-multiagent-user-availability,
        id:es-multiagent-write-scope, id:es-multiagent-language ;
    ho:onEnvelopeExit id:fp-envelope-exit, id:fp-envelope-exit-severe ;
    ho:tagged id:c-operating-envelope ;
    ho:tokenEstimate 130 ; ho:maturity "draft" .

id:es-multiagent-subject a ho:EnvelopeStatement ;
    skos:prefLabel "Multi-agent envelope: subject matter" ;
    ho:envelopeAttribute id:c-envelope-subject-matter ;
    ho:envelopeVerdict "include" ;
    ho:envelopeValueType "categorical" ;
    ho:envelopeThreshold "design, architecture and structured multi-role authoring work" ;
    ho:envelopeObservable "whether the request is a design, architecture or structured authoring task of the kind the harness's declared tasks name (id:task-architecture, id:task-designdecision)" ;
    ho:tokenEstimate 75 ; ho:salience 0.2 ; ho:maturity "draft" .
id:es-multiagent-task-scale a ho:EnvelopeStatement ;
    skos:prefLabel "Multi-agent envelope: task scale" ;
    ho:envelopeAttribute id:c-envelope-task-scale ;
    ho:envelopeVerdict "include" ;
    ho:envelopeValueType "categorical" ;
    ho:envelopeThreshold "work decomposable into node-scoped dispatch briefs" ;
    ho:envelopeObservable "whether the request can be split into briefs each completable by one dispatched worker and integrable by the orchestrator" ;
    ho:tokenEstimate 56 ; ho:salience 0.2 ; ho:maturity "draft" .
id:es-multiagent-requester a ho:EnvelopeStatement ;
    skos:prefLabel "Multi-agent envelope: requester" ;
    ho:envelopeAttribute id:c-envelope-requester ;
    ho:envelopeVerdict "include" ;
    ho:envelopeValueType "categorical" ;
    ho:envelopeThreshold "the session user, over the declared user channel" ;
    ho:envelopeObservable "whether the request arrives from the user over the declared user channel (id:chan-agent-user)" ;
    ho:tokenEstimate 48 ; ho:salience 0.2 ; ho:maturity "draft" .
id:es-multiagent-user-availability a ho:EnvelopeStatement ;
    skos:prefLabel "Multi-agent envelope: user availability" ;
    ho:envelopeAttribute id:c-envelope-user-availability ;
    ho:envelopeVerdict "include" ;
    ho:envelopeClosure "restrictive" ;
    ho:envelopeValueType "boolean" ;
    ho:envelopeObservable "whether the user endpoint of id:chan-agent-user is responsive within the run, so escalated open decisions can actually be answered (the id:tier-per-plan-approval fallback precondition)" ;
    ho:tokenEstimate 63 ; ho:salience 0.2 ; ho:maturity "draft" .
id:es-multiagent-write-scope a ho:EnvelopeStatement ;
    skos:prefLabel "Multi-agent envelope: write scope" ;
    ho:envelopeAttribute id:c-envelope-write-scope ;
    ho:envelopeVerdict "include" ;
    ho:envelopeValueType "categorical" ;
    ho:envelopeThreshold "each role's own least-privilege file boundary" ;
    ho:envelopeObservable "whether the artifacts the request touches fall inside the responsibility boundary of some bound role (the id:gr-least-privilege boundary)" ;
    ho:tokenEstimate 59 ; ho:salience 0.2 ; ho:maturity "draft" .
id:es-multiagent-language a ho:EnvelopeStatement ;
    skos:prefLabel "Multi-agent envelope: language scope" ;
    ho:envelopeAttribute id:c-envelope-language-scope ;
    ho:envelopeVerdict "include" ;
    ho:envelopeValueType "categorical" ;
    ho:envelopeThreshold "Korean or English prose; technical terms in English" ;
    ho:envelopeObservable "the natural language of the request and of the deliverables it asks for (the id:gr-lang boundary)" ;
    ho:tokenEstimate 51 ; ho:salience 0.2 ; ho:maturity "draft" .
