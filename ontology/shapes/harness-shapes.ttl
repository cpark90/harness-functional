@prefix ho:    <https://harness-ontology.dev/schema#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .

########################################################################
# SHACL shapes — structural invariants.
# Run against the *reasoned* graph (owlrl materialises subclass +
# inverse + sub-property closure first), so incoming/inverse paths and
# subclass typing are visible.
#
# These shapes encode the anti-orphan / anti-drift guarantees:
#   * every component is wired into at least one harness (no orphans)
#   * every edge points at the correct type (no vocabulary drift)
#   * every harness is complete enough to be composable
########################################################################

# SPARQL-constraint prefix declarations. A sh:select body resolves prefixes
# from sh:prefixes (the SHACL mechanism), NOT from this file's Turtle @prefix
# block, so the `ho:` used inside the query below is declared here. This is a
# validation-only document: the loader never folds shapes into the data graph,
# so declaring an owl:Ontology header here adds nothing to the union.
<https://harness-ontology.dev/shapes> a owl:Ontology ;
    sh:declare [
        sh:prefix "ho" ;
        sh:namespace "https://harness-ontology.dev/schema#"^^xsd:anyURI ] ;
    sh:declare [
        sh:prefix "id" ;
        sh:namespace "https://harness-ontology.dev/id/core/"^^xsd:anyURI ] .

#--- A harness must be intentful and complete -------------------------
ho:HarnessShape a sh:NodeShape ;
    sh:targetClass ho:Harness ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:message "Harness must have a skos:prefLabel (identity, prevents drift/dedup)." ] ;
    sh:property [
        sh:path ho:targetsDomain ;
        sh:minCount 1 ;
        sh:class ho:Domain ;
        sh:message "Harness must target >=1 Domain." ] ;
    sh:property [
        sh:path ho:addressesTask ;
        sh:minCount 1 ;
        sh:class ho:Task ;
        sh:message "Harness must address >=1 Task." ] ;
    sh:property [
        sh:path ho:hasSystemPrompt ;
        sh:minCount 1 ;
        sh:class ho:SystemPrompt ;
        sh:message "Harness must have >=1 SystemPrompt component." ] ;
    sh:property [
        sh:path ho:hasWorkflow ;
        sh:minCount 1 ;
        sh:class ho:Workflow ;
        sh:message "Harness must have >=1 Workflow component." ] ;
    sh:property [
        sh:path ho:environmentFidelity ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "mock" "cassette" "replica" "digital-twin" "production" ) ;
        sh:message "ho:environmentFidelity, when declared, is at most one value from the closed set (mock/cassette/replica/digital-twin/production) — a harness sits on one staged-rollout rung at a time." ] .

#--- No orphaned components: each must belong to a harness ------------
# componentOf is the (inferred) inverse of hasComponent and its sub-props.
ho:ComponentConnectivityShape a sh:NodeShape ;
    sh:targetClass ho:HarnessComponent ;
    sh:property [
        sh:path [ sh:inversePath ho:hasComponent ] ;
        sh:minCount 1 ;
        sh:message "Orphaned component: not wired into any Harness via hasComponent (or a sub-property)." ] ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:message "Component must have a skos:prefLabel." ] .

#--- No orphaned tasks: must be addressed or sit in a taxonomy --------
ho:TaskConnectivityShape a sh:NodeShape ;
    sh:targetClass ho:Task ;
    sh:or (
        [ sh:path [ sh:inversePath ho:addressesTask ] ; sh:minCount 1 ]
        [ sh:path skos:broader ; sh:minCount 1 ]
        [ sh:path [ sh:inversePath skos:broader ] ; sh:minCount 1 ]
    ) ;
    sh:message "Orphaned task: neither addressed by a harness nor placed in the task taxonomy." .

#--- No orphaned capabilities: must be required or provided -----------
ho:CapabilityConnectivityShape a sh:NodeShape ;
    sh:targetClass ho:Capability ;
    sh:or (
        [ sh:path [ sh:inversePath ho:requiresCapability ] ; sh:minCount 1 ]
        [ sh:path [ sh:inversePath ho:providesCapability ] ; sh:minCount 1 ]
    ) ;
    sh:message "Orphaned capability: never required nor provided by anything." .

#--- No orphaned vocabulary: every Concept must connect ---------------
ho:ConceptConnectivityShape a sh:NodeShape ;
    sh:targetClass ho:Concept ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:message "Concept must have skos:prefLabel." ] ;
    sh:or (
        [ sh:path [ sh:inversePath ho:tagged ] ; sh:minCount 1 ]
        [ sh:path skos:broader ; sh:minCount 1 ]
        [ sh:path [ sh:inversePath skos:broader ] ; sh:minCount 1 ]
        [ sh:path skos:related ; sh:minCount 1 ]
    ) ;
    sh:message "Orphaned concept: tags nothing and is disconnected from the concept taxonomy." .

#--- Concept facet: one value, from the closed content-axis set --------
# VALUE-CLOSED BUT PRESENCE-OPTIONAL, deliberately. These shapes are the
# FEDERATION gate: a data repo's CI validates its own union (central core + its
# data) with this very file, and the recipes repo alone carries ~239 recipe-local
# ho:Concept terms authored before this axis existed. A sh:minCount 1 here would
# therefore fail every federated repo the moment central lands the predicate,
# turning a central-only vocabulary change into a downstream breakage — the
# opposite of what a shared shapes document is for. Central coverage (every
# core Concept declares a facet) is enforced instead by tools/lint_uniformity.py,
# which is scoped to the id/core/ namespace and does not run over federated data.
# What MUST hold everywhere is that a declared value is one of the five and only
# one: a term on two content axes is not a term, it is two.
ho:ConceptFacetShape a sh:NodeShape ;
    sh:targetClass ho:Concept ;
    sh:property [
        sh:path ho:conceptFacet ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "anatomy" "quality" "method" "domain" "scope" ) ;
        sh:message "ho:conceptFacet, when declared, is exactly one value from the closed set (anatomy/quality/method/domain/scope) — one term sits on one content axis." ] .

#--- Typed-edge enforcement (anti-drift) ------------------------------
# OWL rdfs:range does not *constrain*; SHACL does. These stop an edge
# from silently pointing at an untyped or wrong-typed node.
ho:EdgeTypingShape a sh:NodeShape ;
    sh:targetClass ho:Harness ;
    sh:property [ sh:path ho:usesTool ;    sh:class ho:Tool ] ;
    sh:property [ sh:path ho:hasGuardrail ; sh:class ho:Guardrail ] ;
    sh:property [ sh:path ho:hasHook ; sh:class ho:Hook ] ;
    sh:property [ sh:path ho:appliesPattern ; sh:class ho:DesignPattern ] ;
    sh:property [ sh:path ho:hasExecutionMode ; sh:class ho:ExecutionMode ] ;
    sh:property [ sh:path ho:requiresCapability ; sh:class ho:Capability ] ;
    sh:property [ sh:path ho:constrainedBy ; sh:class ho:Constraint ] .

#--- specializes: same-kind narrowing (anti-drift) -------------------
# ho:specializes carries no rdfs:domain/range because it spans ho:Harness
# and ho:HarnessComponent, which have no common superclass. This shape
# reinstates typed-edge safety AND the same-kind rule the definition states:
# a specialization narrows WITHIN one family — a harness specialises a
# harness, a component (e.g. an ho:Role) specialises a component — so it
# cannot point at an untyped node or cross the harness/component partition.
# [권장] leaf-class sameness (Role→Role, not Role→Tool) is a convention the
# definition states; this shape enforces the coarser, cleanly-checkable
# harness-vs-component partition.
ho:SpecializesTypingShape a sh:NodeShape ;
    sh:targetSubjectsOf ho:specializes ;
    sh:or (
        [ sh:class ho:Harness ;
          sh:property [ sh:path ho:specializes ; sh:class ho:Harness ] ]
        [ sh:class ho:HarnessComponent ;
          sh:property [ sh:path ho:specializes ; sh:class ho:HarnessComponent ] ]
    ) ;
    sh:message "ho:specializes must narrow within one family: a Harness specialises a Harness, or a HarnessComponent specialises a HarnessComponent (not untyped, not across the harness/component partition)." .

#--- SystemPrompt must carry text so it is actually usable -----------
ho:SystemPromptShape a sh:NodeShape ;
    sh:targetClass ho:SystemPrompt ;
    sh:property [
        sh:path ho:promptText ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "SystemPrompt must have ho:promptText." ] .

#--- AssemblySection: well-defined position + recognised kind --------
# Per-node half of the total-order guarantee (Stage c): each AssemblySection
# must carry exactly one integer ho:assemblyOrder and exactly one ho:sectionKind
# drawn from the closed set the build emitter recognises. The SET-level
# constraint (no two sections in one harness's assembly sharing an order — i.e.
# the order is TOTAL) is enforced by tools/validate.check_assembly_order, which
# also cross-checks the kinds against the emitter. Together they make an
# ill-defined assembly order a build failure, not a silent code fallback.
ho:AssemblySectionShape a sh:NodeShape ;
    sh:targetClass ho:AssemblySection ;
    sh:property [
        sh:path ho:assemblyOrder ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:message "AssemblySection must have exactly one integer ho:assemblyOrder (a well-defined position)." ] ;
    sh:property [
        sh:path ho:sectionKind ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "overview" "persona" "operating-rules" "process" "model" "roles" "channels" "skills" "execution-mode" "data-flow" "error-handling" "test-scenarios" "hooks" ) ;
        sh:message "AssemblySection must have exactly one ho:sectionKind from the emitter's closed set (overview/persona/operating-rules/process/model/roles/channels/skills/execution-mode/data-flow/error-handling/test-scenarios/hooks)." ] .

#--- Memory: the 3-tier discrimination is enforced, not decorative ---
# Every ho:Memory must be labelled and defined and must declare all three
# discriminators from their closed value sets — its read-timing (when it is
# read relative to execution), its write-timing (how newly produced knowledge
# is routed into it at production time) and its persistence (whether it
# survives a spawn) — plus a maturity. readScope and activationCondition stay
# optional (only long-term needs a trigger). This makes the
# firmware/cache/long-term distinction a required, well-typed property of any
# memory tier rather than free-text prose, on the write side as on the read
# side.
ho:MemoryShape a sh:NodeShape ;
    sh:targetClass ho:Memory ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:message "Memory must have a skos:prefLabel." ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 1 ;
        sh:message "Memory must have a skos:definition." ] ;
    sh:property [
        sh:path ho:memoryReadTiming ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "every-execution" "task-continuous" "conditional" ) ;
        sh:message "Memory must have exactly one ho:memoryReadTiming from the closed set (every-execution/task-continuous/conditional)." ] ;
    sh:property [
        sh:path ho:memoryWriteTiming ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "immediate-apply" "deliberate-store" "authored" ) ;
        sh:message "Memory must have exactly one ho:memoryWriteTiming from the closed set (immediate-apply/deliberate-store/authored)." ] ;
    sh:property [
        sh:path ho:memoryPersistence ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "durable" "ephemeral" ) ;
        sh:message "Memory must have exactly one ho:memoryPersistence from the closed set (durable/ephemeral)." ] ;
    sh:property [
        sh:path ho:maturity ;
        sh:minCount 1 ;
        sh:message "Memory must have ho:maturity." ] .

#--- TestScenario: a usable behaviour-acceptance fixture ------------
# A TestScenario must be labelled and mature, declare its kind from the
# closed value set, and carry at least one prompt (the request it runs).
# scenarioExpected and scenarioReferences stay optional (a trigger-negative
# fixture may assert only that nothing activates). This keeps the
# normal/error/trigger distinction a required, well-typed property.
ho:TestScenarioShape a sh:NodeShape ;
    sh:targetClass ho:TestScenario ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:message "TestScenario must have a skos:prefLabel." ] ;
    sh:property [
        sh:path ho:scenarioKind ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "normal" "existing-input" "error" "trigger-positive" "trigger-negative" ) ;
        sh:message "TestScenario must have exactly one ho:scenarioKind from the closed set (normal/existing-input/error/trigger-positive/trigger-negative)." ] ;
    sh:property [
        sh:path ho:scenarioPrompt ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "TestScenario must have >=1 ho:scenarioPrompt (the request it runs)." ] ;
    sh:property [
        sh:path ho:maturity ;
        sh:minCount 1 ;
        sh:message "TestScenario must have ho:maturity." ] .

#--- FailurePolicy: a complete condition->strategy row --------------
# A FailurePolicy row must be labelled and mature and carry BOTH its
# failure condition and its recovery strategy, so an error-handling
# table row is never half-specified.
ho:FailurePolicyShape a sh:NodeShape ;
    sh:targetClass ho:FailurePolicy ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:message "FailurePolicy must have a skos:prefLabel." ] ;
    sh:property [
        sh:path ho:failureCondition ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "FailurePolicy must have >=1 ho:failureCondition." ] ;
    sh:property [
        sh:path ho:recoveryStrategy ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "FailurePolicy must have >=1 ho:recoveryStrategy." ] ;
    sh:property [
        sh:path ho:maturity ;
        sh:minCount 1 ;
        sh:message "FailurePolicy must have ho:maturity." ] .

#--- Hook: a complete lifecycle trigger -> action pairing -----------
# A Hook must be labelled and mature and carry BOTH its trigger event
# (exactly one — a hook fires on a single lifecycle event) and the action
# it runs, so a lifecycle automation is never half-specified. ho:hookEvent
# is intentionally NOT constrained by sh:in: the lifecycle-event value space
# is open (defined/versioned by the agent runtime; the emitter renders any
# value generically), so a new event is a new literal, not a shapes edit.
ho:HookShape a sh:NodeShape ;
    sh:targetClass ho:Hook ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:message "Hook must have a skos:prefLabel." ] ;
    sh:property [
        sh:path ho:hookEvent ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Hook must have exactly one ho:hookEvent (the single lifecycle event that triggers it)." ] ;
    sh:property [
        sh:path ho:hookAction ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Hook must have >=1 ho:hookAction (what it runs when triggered)." ] ;
    sh:property [
        sh:path ho:maturity ;
        sh:minCount 1 ;
        sh:message "Hook must have ho:maturity." ] .

#--- Agent: a well-formed partially-observed distributed node --------
# Every ho:Agent must be labelled and mature, name the Role it compiles
# (>=1 agentRole), hold its ObservationSpace (>=1 agentObservation — its
# cognitive envelope Omega_i is never empty), and declare its cognitive
# capacity (>=1 cognitiveCapacity — the loss-free context bound within
# which its observation must fit). agentFunction stays optional here (an
# agent's action space may be recorded via roleTool). The capacity FIT
# (summed area observedTokenVolume <= cognitiveCapacity) is not SHACL-enforceable
# (no aggregation) and is checked by tool/review; this shape enforces the
# structural minimums.
ho:AgentShape a sh:NodeShape ;
    sh:targetClass ho:Agent ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:message "Agent must have a skos:prefLabel." ] ;
    sh:property [
        sh:path ho:agentRole ;
        sh:minCount 1 ;
        sh:class ho:Role ;
        sh:message "Agent must name >=1 Role via ho:agentRole (its mandate/policy)." ] ;
    sh:property [
        sh:path ho:agentObservation ;
        sh:minCount 1 ;
        sh:class ho:ObservationSpace ;
        sh:message "Agent must hold >=1 ObservationSpace via ho:agentObservation (its cognitive envelope is never empty)." ] ;
    sh:property [
        sh:path ho:cognitiveCapacity ;
        sh:minCount 1 ;
        sh:datatype xsd:integer ;
        sh:message "Agent must declare >=1 ho:cognitiveCapacity (the loss-free context bound)." ] ;
    sh:property [
        sh:path ho:maturity ;
        sh:minCount 1 ;
        sh:message "Agent must have ho:maturity." ] .

#--- ObservationSpace: a well-formed observable envelope (Omega_i) --
# Every ho:ObservationSpace must be labelled and mature, project from a
# GlobalState (>=1 projectsFrom — it is a partial projection of the system
# state) and hold at least one AreaOfObservation (>=1 hasAreaOfObservation
# — something is actually observed). hasAreaOfInterest is enforced by
# ho:AreaOfInterestShape's min-count-free presence via the space (the
# AreaOfInterestShape below requires each interest be well-formed; at least
# one interest is expected but the realized-observation minimum is the hard
# structural floor here). The capacity FIT (summed AreaOfObservation
# observedTokenVolume <= the agent's cognitiveCapacity) is not SHACL-enforceable.
ho:ObservationSpaceShape a sh:NodeShape ;
    sh:targetClass ho:ObservationSpace ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:message "ObservationSpace must have a skos:prefLabel." ] ;
    sh:property [
        sh:path ho:projectsFrom ;
        sh:minCount 1 ;
        sh:class ho:GlobalState ;
        sh:message "ObservationSpace must project from >=1 GlobalState via ho:projectsFrom (it is a partial projection of the system state)." ] ;
    sh:property [
        sh:path ho:hasAreaOfObservation ;
        sh:minCount 1 ;
        sh:class ho:AreaOfObservation ;
        sh:message "ObservationSpace must hold >=1 AreaOfObservation via ho:hasAreaOfObservation (something is actually observed)." ] ;
    sh:property [
        sh:path ho:maturity ;
        sh:minCount 1 ;
        sh:message "ObservationSpace must have ho:maturity." ] .

#--- AreaOfInterest: a well-formed information requirement (intent) --
# Every ho:AreaOfInterest must be labelled and mature and declare its kind
# (internal vs external, from the closed set). No ho:observedTokenVolume is
# required — an interest is intent, not consumed input (contrast
# AreaOfObservation, whose realized volume is budgeted against capacity).
ho:AreaOfInterestShape a sh:NodeShape ;
    sh:targetClass ho:AreaOfInterest ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:message "AreaOfInterest must have a skos:prefLabel." ] ;
    sh:property [
        sh:path ho:observationKind ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "internal" "external" ) ;
        sh:message "AreaOfInterest must have exactly one ho:observationKind from the closed set (internal/external)." ] ;
    sh:property [
        sh:path ho:maturity ;
        sh:minCount 1 ;
        sh:message "AreaOfInterest must have ho:maturity." ] .

#--- AreaOfObservation: a well-formed realized observation ----------
# Every ho:AreaOfObservation must be labelled and mature, declare its kind
# (internal vs external) and carry a ho:observedTokenVolume (the realized size
# it contributes to one inference, summed against the agent's capacity). That
# is deliberately NOT ho:tokenEstimate — an area's runtime volume is not the
# cost of projecting the node's text into a context pack, and requiring it here
# on tokenEstimate is what let a 12000-token observation truncate packs. The
# observes* edges stay SOFT (an area may declare only a file scope or an
# unobserved boundary), so they are not required here.
ho:AreaOfObservationShape a sh:NodeShape ;
    sh:targetClass ho:AreaOfObservation ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:message "AreaOfObservation must have a skos:prefLabel." ] ;
    sh:property [
        sh:path ho:observationKind ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "internal" "external" ) ;
        sh:message "AreaOfObservation must have exactly one ho:observationKind from the closed set (internal/external)." ] ;
    sh:property [
        sh:path ho:observedTokenVolume ;
        sh:minCount 1 ;
        sh:datatype xsd:integer ;
        sh:message "AreaOfObservation must have >=1 ho:observedTokenVolume (realized size contributed to one inference, for capacity fit)." ] ;
    sh:property [
        sh:path ho:maturity ;
        sh:minCount 1 ;
        sh:message "AreaOfObservation must have ho:maturity." ] .

#--- GlobalState: the system-description of a Domain ----------------
# The global state space (the S of a decentralized POMDP) must name the
# Domain it describes (ho:describesDomain, the projection chain's middle
# link) and be labelled and mature. EnvironmentSpace stays shape-free (a
# bare anchor at the top of the chain, like a Domain), so no shape targets
# it.
ho:GlobalStateShape a sh:NodeShape ;
    sh:targetClass ho:GlobalState ;
    sh:property [
        sh:path ho:describesDomain ;
        sh:minCount 1 ;
        sh:class ho:Domain ;
        sh:message "GlobalState must name >=1 Domain via ho:describesDomain (the system it describes is scoped to a Domain)." ] ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:message "GlobalState must have a skos:prefLabel." ] ;
    sh:property [
        sh:path ho:maturity ;
        sh:minCount 1 ;
        sh:message "GlobalState must have ho:maturity." ] .

#--- Link: a well-formed weighted, typed knowledge link (n-ary) ------
# An ho:Link reifies "this node stands in THAT kind of relation to THAT node,
# to THIS degree", so every axis is mandatory and single-valued: an attachment
# (the link must hang off a source via ho:hasLink — a Link is NOT a
# HarnessComponent, so this inverse-path minimum is its whole anti-orphan
# defense), exactly one ho:linkTarget typed as a component or Concept, exactly
# one ho:linkKind, exactly one ho:linkWeight inside 0..1 and exactly one
# ho:weightOrigin from the provenance set. TEETH NOTE: ho:linkTarget and
# ho:linkKind deliberately declare NO rdfs:range in the TBox, so OWL RL cannot
# type-launder a mistyped value (the retired AnchorShape's measured caveat) —
# the sh:or / sh:class constraints below are the enforced range and genuinely
# FAIL under the reasoned validate.py pipeline. The SPARQL constraint binds
# the provenance contract: a "measured" weight without its ho:weightMethod is
# untraceable, so it fails rather than passing as a plausible number.
ho:LinkShape a sh:NodeShape ;
    sh:targetClass ho:Link ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:message "Link must have a skos:prefLabel." ] ;
    sh:property [
        sh:path [ sh:inversePath ho:hasLink ] ;
        sh:minCount 1 ;
        sh:message "Orphaned link: not attached to any source node via ho:hasLink." ] ;
    sh:property [
        sh:path ho:linkTarget ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or ( [ sh:class ho:HarnessComponent ]
                [ sh:class ho:SpecConcept ]
                [ sh:class ho:Concept ] ) ;
        sh:message "Link must point at exactly one target that is a ho:HarnessComponent, a ho:SpecConcept or a ho:Concept via ho:linkTarget (not a Harness, not untyped)." ] ;
    sh:property [
        sh:path ho:linkKind ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class ho:LinkKind ;
        sh:message "Link must declare exactly one ho:linkKind, a typed ho:LinkKind individual (an untyped or double-kinded edge is not interpretable)." ] ;
    sh:property [
        sh:path ho:linkWeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 1.0 ;
        sh:message "Link must have exactly one ho:linkWeight, a decimal within 0..1 (a fuzzy membership degree; an unweighted link is a crisp edge with extra steps)." ] ;
    sh:property [
        sh:path ho:weightOrigin ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "measured" "asserted" "curated" ) ;
        sh:message "Link must have exactly one ho:weightOrigin from the closed set (measured/asserted/curated) — without provenance a human correction cannot be protected from re-measurement." ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "This link's ho:linkWeight is \"measured\" but names no ho:weightMethod: an untraceable measured value is indistinguishable from a guess — record the procedure identifier that produced it." ;
        sh:prefixes <https://harness-ontology.dev/shapes> ;
        sh:select """
            SELECT $this
            WHERE {
                $this ho:weightOrigin "measured" .
                FILTER NOT EXISTS { $this ho:weightMethod ?method . }
            }
            """ ] .

#--- LinkKind: a well-formed relation-kind individual ----------------
# A relation kind must be labelled, must define its semantics (direction
# convention and symmetry live in the definition — consumers and authors read
# them there) and must carry exactly one 0..1 ho:traversalWeight so the read
# projection can weight its links without a code table.
ho:LinkKindShape a sh:NodeShape ;
    sh:targetClass ho:LinkKind ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:message "LinkKind must have a skos:prefLabel." ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 1 ;
        sh:message "LinkKind must have a skos:definition (its direction convention and symmetry are read from there)." ] ;
    sh:property [
        sh:path ho:traversalWeight ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 1.0 ;
        sh:message "LinkKind must have exactly one ho:traversalWeight, a decimal within 0..1 (the projector's base edge weight for links of this kind)." ] .

#--- alternative-kind links must connect tellings of the SAME region --
# The ported teeth of the retired ho:AlternativeOfSharedAnchorShape: a link of
# the alternative kind is what makes two overlapping descriptions legitimate
# instead of drift, but ONLY when its two ends re-tell the SAME knowledge
# region — so the source and target must share at least one ho:tagged Concept
# whose ho:conceptFacet is a DISCRIMINANT facet ("anatomy" or "method"): only
# those facets say what a node is ABOUT (sharing "multiagent" or "safety" is
# not sharing a region). A SPARQL constraint because the check joins the
# link's two ends' value sets. Phase-2 note: when ho:tagged itself migrates to
# topic links, this constraint's ?region join must follow it. Federation note:
# fires only on links declaring the central alternative kind; facet-less
# recipe-local Concepts are never violations by themselves.
ho:AlternativeLinkSharedRegionShape a sh:NodeShape ;
    sh:targetClass ho:Link ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Alternative-kind link between {?source} and {?target}: the two ends share no ho:tagged Concept with a discriminant ho:conceptFacet (\"anatomy\"/\"method\") — tag both with the shared content region, or the pair is drift, not an alternative telling." ;
        sh:prefixes <https://harness-ontology.dev/shapes> ;
        sh:select """
            SELECT $this ?source ?target
            WHERE {
                $this ho:linkKind id:kind-alternative ;
                      ho:linkTarget ?target .
                ?source ho:hasLink $this .
                FILTER NOT EXISTS {
                    ?source ho:tagged ?region .
                    ?target ho:tagged ?region .
                    ?region ho:conceptFacet ?facet .
                    FILTER(?facet IN (\"anatomy\", \"method\"))
                }
            }
            """ ] .

#--- OperatingEnvelope: a complete, judgeable range declaration ------
# An envelope must be labelled and mature, declare its closure posture
# (envelopeDefault, closed set — restrictive is the intended norm), carry at
# least one EnvelopeStatement row (a range with no rows declares nothing) and
# name the FailurePolicy that handles a range exit (onEnvelopeExit) — the exit
# is a first-class failure condition, so an envelope without an exit policy is
# half a declaration. EnvelopeRules stay optional (rules are the exception).
ho:OperatingEnvelopeShape a sh:NodeShape ;
    sh:targetClass ho:OperatingEnvelope ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:message "OperatingEnvelope must have a skos:prefLabel." ] ;
    sh:property [
        sh:path ho:envelopeDefault ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "restrictive" "permissive" ) ;
        sh:message "OperatingEnvelope must have exactly one ho:envelopeDefault from the closed set (restrictive/permissive)." ] ;
    sh:property [
        sh:path ho:hasEnvelopeStatement ;
        sh:minCount 1 ;
        sh:class ho:EnvelopeStatement ;
        sh:message "OperatingEnvelope must carry >=1 EnvelopeStatement via ho:hasEnvelopeStatement (a range with no rows declares nothing)." ] ;
    sh:property [
        sh:path ho:onEnvelopeExit ;
        sh:minCount 1 ;
        sh:class ho:FailurePolicy ;
        sh:message "OperatingEnvelope must name >=1 FailurePolicy via ho:onEnvelopeExit (a range exit is a first-class failure condition, never an improvised refusal)." ] ;
    sh:property [
        sh:path ho:maturity ;
        sh:minCount 1 ;
        sh:message "OperatingEnvelope must have ho:maturity." ] .

#--- EnvelopeStatement: one observable row about one attribute -------
# The measurability tooth of the envelope transfer: every statement MUST say
# what observation decides its attribute at request time (envelopeObservable).
# A range declared over an unobservable attribute cannot be judged in
# principle, so this shape is what separates a testable declaration from
# plausible-sounding prose. One attribute per row (a weight of statements over
# two attributes at once is not interpretable — write two rows), verdict and
# value type from closed sets, per-attribute closure optional.
ho:EnvelopeStatementShape a sh:NodeShape ;
    sh:targetClass ho:EnvelopeStatement ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:message "EnvelopeStatement must have a skos:prefLabel." ] ;
    sh:property [
        sh:path ho:envelopeAttribute ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class ho:Concept ;
        sh:message "EnvelopeStatement must name exactly one envelope-attribute ho:Concept via ho:envelopeAttribute (one row declares over one attribute)." ] ;
    sh:property [
        sh:path ho:envelopeVerdict ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "include" "exclude" ) ;
        sh:message "EnvelopeStatement must have exactly one ho:envelopeVerdict from the closed set (include/exclude)." ] ;
    sh:property [
        sh:path ho:envelopeClosure ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "restrictive" "permissive" ) ;
        sh:message "ho:envelopeClosure, when present, must be one value from the closed set (restrictive/permissive)." ] ;
    sh:property [
        sh:path ho:envelopeValueType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "boolean" "categorical" "numeric" ) ;
        sh:message "EnvelopeStatement must have exactly one ho:envelopeValueType from the closed set (boolean/categorical/numeric)." ] ;
    sh:property [
        sh:path ho:envelopeObservable ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "EnvelopeStatement must have >=1 ho:envelopeObservable (what decides the attribute at request time — an unobservable attribute cannot be judged, so the declaration would have no teeth)." ] ;
    sh:property [
        sh:path ho:maturity ;
        sh:minCount 1 ;
        sh:message "EnvelopeStatement must have ho:maturity." ] .

#--- EnvelopeRule: a complete conditional row ------------------------
ho:EnvelopeRuleShape a sh:NodeShape ;
    sh:targetClass ho:EnvelopeRule ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:message "EnvelopeRule must have a skos:prefLabel." ] ;
    sh:property [
        sh:path ho:ruleCondition ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "EnvelopeRule must have >=1 ho:ruleCondition (the IF clause over envelope attributes)." ] ;
    sh:property [
        sh:path ho:ruleEffect ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "include" "exclude" ) ;
        sh:message "EnvelopeRule must have exactly one ho:ruleEffect from the closed set (include/exclude)." ] ;
    sh:property [
        sh:path ho:maturity ;
        sh:minCount 1 ;
        sh:message "EnvelopeRule must have ho:maturity." ] .

#--- AutonomyTier: five well-typed responsibility slots --------------
# Every tier must fill all five allocation slots from their closed value sets —
# a tier with an open slot is not a usable allocation. The slots are data (not
# prose) precisely so the usage implications below are SHACL-checkable.
ho:AutonomyTierShape a sh:NodeShape ;
    sh:targetClass ho:AutonomyTier ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:message "AutonomyTier must have a skos:prefLabel." ] ;
    sh:property [
        sh:path ho:executionOwner ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "user" "user-and-harness" "harness" ) ;
        sh:message "AutonomyTier must have exactly one ho:executionOwner from the closed set (user/user-and-harness/harness)." ] ;
    sh:property [
        sh:path ho:oversightOwner ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "user" "harness" ) ;
        sh:message "AutonomyTier must have exactly one ho:oversightOwner from the closed set (user/harness)." ] ;
    sh:property [
        sh:path ho:fallbackOwner ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "user" "receptive-user" "harness" ) ;
        sh:message "AutonomyTier must have exactly one ho:fallbackOwner from the closed set (user/receptive-user/harness)." ] ;
    sh:property [
        sh:path ho:envelopeBinding ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "none" "bounded" "unbounded" ) ;
        sh:message "AutonomyTier must have exactly one ho:envelopeBinding from the closed set (none/bounded/unbounded)." ] ;
    sh:property [
        sh:path ho:approvalUnit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "none" "per-action" "per-plan" "per-exception" "post-hoc" ) ;
        sh:message "AutonomyTier must have exactly one ho:approvalUnit from the closed set (none/per-action/per-plan/per-exception/post-hoc)." ] ;
    sh:property [
        sh:path ho:maturity ;
        sh:minCount 1 ;
        sh:message "AutonomyTier must have ho:maturity." ] .

#--- Harness autonomy usage rules (tier => envelope / capability / channel) ---
# The usage-specification teeth of the autonomy axis, on any harness that
# declares ho:autonomyTier. (1) At most one tier. (2) A tier bound to an
# envelope (envelopeBinding not none/unbounded) demands ho:hasEnvelope — a
# bounded allocation without a declared range is unusable. (3) fallbackOwner
# implications: "harness" demands a bound component PROVIDING the safe-halt
# capability (id:cap-safe-halt — reaching and holding the halt state is a real
# ability the harness must ship, not a hope), and "receptive-user" demands a
# bound channel that involves the user (there must be a conduit to reach the
# human who is expected to respond). SPARQL constraints because the condition
# spans the tier's slot values and the harness's own bindings (the
# ho:AlternativeOfSharedAnchorShape mechanism); they run against the reasoned
# graph, so hasComponent includes every sub-property and chain rollup.
ho:HarnessAutonomyShape a sh:NodeShape ;
    sh:targetSubjectsOf ho:autonomyTier ;
    sh:property [
        sh:path ho:autonomyTier ;
        sh:maxCount 1 ;
        sh:class ho:AutonomyTier ;
        sh:message "A harness declares at most one ho:autonomyTier (one responsibility allocation at a time), and it must be a typed ho:AutonomyTier." ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Autonomy tier {?tier} is envelope-bound, but this harness declares no ho:hasEnvelope: a bounded allocation without a declared operating range is unusable (declare the envelope, or use a boundary tier)." ;
        sh:prefixes <https://harness-ontology.dev/shapes> ;
        sh:select """
            SELECT $this ?tier
            WHERE {
                $this ho:autonomyTier ?tier .
                ?tier ho:envelopeBinding ?binding .
                FILTER (?binding NOT IN ("none", "unbounded"))
                FILTER NOT EXISTS { $this ho:hasEnvelope ?envelope . }
            }
            """ ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Autonomy tier {?tier} makes the HARNESS the fallback owner, but no bound component provides the safe-halt capability (id:cap-safe-halt): a harness that must halt itself safely has to ship that ability." ;
        sh:prefixes <https://harness-ontology.dev/shapes> ;
        sh:select """
            SELECT $this ?tier
            WHERE {
                $this ho:autonomyTier ?tier .
                ?tier ho:fallbackOwner "harness" .
                FILTER NOT EXISTS {
                    $this ho:hasComponent ?component .
                    ?component ho:providesCapability id:cap-safe-halt .
                }
            }
            """ ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Autonomy tier {?tier} expects a RECEPTIVE USER as fallback owner, but this harness binds no channel that involves the user: there is no conduit to reach the human expected to respond (bind a user channel, or change the fallback owner)." ;
        sh:prefixes <https://harness-ontology.dev/shapes> ;
        sh:select """
            SELECT $this ?tier
            WHERE {
                $this ho:autonomyTier ?tier .
                ?tier ho:fallbackOwner "receptive-user" .
                FILTER NOT EXISTS {
                    $this ho:hasChannel ?channel .
                    ?channel ho:involvesUser true .
                }
            }
            """ ] .

#--- Guardrail approval-gate granularity: closed value set -----------
# Targets only the guardrails that DECLARE an approval scope (the predicate is
# optional and most guardrails are not approval gates), so no blanket
# GuardrailShape is minted for one optional field. Repeatable by design: one
# gate may cover several object kinds (e.g. tool-call and task-output). The
# value set is deliberately DISJOINT from ho:approvalUnit's tier-level set —
# sharing values would blur the gate-granularity vs tier-cadence boundary.
ho:ApprovalScopeShape a sh:NodeShape ;
    sh:targetSubjectsOf ho:approvalScope ;
    sh:property [
        sh:path ho:approvalScope ;
        sh:datatype xsd:string ;
        sh:in ( "tool-call" "tool-call-arg-pattern" "task-output" "plan" "turn" "run-termination" "session-mode" ) ;
        sh:message "ho:approvalScope must come from the closed set (tool-call/tool-call-arg-pattern/task-output/plan/turn/run-termination/session-mode)." ] .
