<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- Protégé-style OASIS XML catalog for the FUNCTIONAL repo.

     This repo holds the harness FUNCTIONAL level (the vocabulary: TBox schema
     + SHACL shapes — what a harness IS, described in labels/definitions) and
     the harness ODD (HARNESS-ODD.md). The union root, the ABox core parts
     library and the assembly specs live in the CONCRETE repo
     (harness-concrete, formerly harness-recipes): logical level = candidates/
     selection policies/constraints, concrete level = neutral parts + recipes.
     IRIs are location-independent (D3) — moving files between repos never
     changes an IRI; only catalogs change. Shapes are validation-only and are
     deliberately NOT in the catalog (loaded directly by tools/validate.py). -->
<catalog prefer="public" xmlns="urn:oasis:names:tc:entity:xmlns:xml:catalog">
    <uri id="schema" name="https://harness-ontology.dev/schema" uri="ontology/tbox/harness.ttl"/>
</catalog>
